# Configurazione NON sensibile del servizio di trading (B3, core caldo). I segreti stanno nel
# Secret trading-secrets, mai qui: questo file e' committato.
#
# Consumato da configMapGenerator (vedi kustomization.yaml): il ConfigMap generato ha un HASH nel
# nome, cosi' un cambio qui sostituisce il pod e le env vengono rilette davvero (stesso schema di
# ui-config.env, stessa ragione).
#
# NB precedenza: le env vincono sull'appsettings.json condiviso via PVC — e' voluto: queste chiavi
# fissano l'ASSETTO del core (feed acceso, carry acceso) e non devono dipendere da cio' che il
# guscio scrive nel file condiviso. Nessuna di queste chiavi e' fra quelle scritte da
# AppConfigWriter, quindi nessun pannello UI provera' a cambiarle senza effetto.

# --- [B3] Feed di prezzo real-time R1: ACCESO ma IN OSSERVAZIONE. DriveProtectiveExits=false =
# i tick alimentano metriche e confronto tick-vs-candela, le uscite protettive restano guidate dal
# percorso a candele. Si passa a true SOLO dopo il confronto (gate B3, secondo tempo).
MarketData__Realtime__Enabled=true
MarketData__Realtime__DriveProtectiveExits=false

# --- [B3] Carry delta-neutro Paper: l'operativita' che il core deve tenere viva attraverso i
# riavvii del guscio (PRD §3). Mai Live per costruzione (il worker rifiuta tutto tranne
# Paper/Testnet e Testnet degrada a Paper finche' l'executor demo non esiste).
Carry__Enabled=true
Carry__Mode=Paper
