@* Validazione preventiva dei dati: mostra quali candele esistono per symbol+timeframe
   PRIMA di lanciare l'operazione, con warning se il periodo scelto è fuori range e
   scorciatoia "Usa tutto il range". Il parent viene avvisato via OnHasDataChanged
   (per disabilitare il Run) e OnApplyRange (quando l'utente aggancia le date ai dati).
   Se il periodo selezionato non tocca nemmeno il range disponibile, le date vengono
   agganciate automaticamente ai dati veri (fallirebbero comunque). *@

@using Microsoft.EntityFrameworkCore
@using ProcioneMGR.Data
@inject IDbContextFactory<ApplicationDbContext> DbFactory

@if (_checked)
{
    @if (_range is null)
    {
        <div class="alert alert-warning py-2 mt-2 mb-0">
            <i class="bi bi-exclamation-triangle me-1"></i>
            Nessun dato per <strong>@Symbol @Timeframe</strong>:
            scaricali prima da <a href="market/watchlist" class="alert-link">Watchlist</a>
            o <a href="dashboard" class="alert-link">Dashboard</a>.
        </div>
    }
    else
    {
        <div class="form-text mt-2 mb-0 d-flex align-items-center gap-2 flex-wrap">
            <span>
                <i class="bi bi-database-check me-1"></i>
                Dati disponibili: <strong>@_range.Value.From.ToString("yyyy-MM-dd")</strong> →
                <strong>@_range.Value.To.ToString("yyyy-MM-dd")</strong>
                (@_range.Value.Count.ToString("N0") candele)
            </span>
            @if (ShowUseFullRange)
            {
                <button type="button" class="btn btn-link btn-sm p-0" @onclick="ApplyFullRangeAsync" disabled="@Disabled">Usa tutto il range</button>
            }
            @if (RangeOutsideData)
            {
                <span class="text-warning"><i class="bi bi-exclamation-triangle me-1"></i>Il periodo selezionato è fuori dal range disponibile.</span>
            }
        </div>
        @* [C-06, Fase 3] La copertura del sentiment dichiarata dove il fattore Sentiment è
           selezionabile: le notizie scorate partono da quando il worker ha iniziato a raccoglierle,
           NON dall'inizio delle candele. Senza questa riga, un training sul 2024 col fattore
           Sentiment produce serie vuote per la maggior parte del range — in silenzio. *@
        @if (ShowSentimentCoverage)
        {
            <div class="form-text mt-1 mb-0">
                @if (_sentimentRange is { } s)
                {
                    <span>
                        <i class="bi bi-chat-left-text me-1"></i>
                        Sentiment (notizie scorate): <strong>@s.From.ToString("yyyy-MM-dd")</strong> →
                        <strong>@s.To.ToString("yyyy-MM-dd")</strong> (@s.Count.ToString("N0") notizie)
                    </span>
                    @* [I9] La copertura GLOBALE è vera e fuorviante: il fattore filtra per ticker,
                       quindi su un simbolo fuori dal vocabolario è nullo su OGNI barra mentre la riga
                       qui sopra dichiara migliaia di notizie. Il numero che conta è quante ne
                       riguardano QUESTO simbolo. *@
                    @if (_sentimentForSymbol is { } perSimbolo && !string.IsNullOrEmpty(_sentimentBaseTicker))
                    {
                        @if (perSimbolo == 0)
                        {
                            <span class="text-danger ms-2">
                                <i class="bi bi-x-octagon me-1"></i>
                                <strong>Nessuna di queste notizie riguarda @_sentimentBaseTicker</strong>: il fattore
                                Sentiment sarà <strong>nullo su ogni barra</strong> di questo simbolo. Il vocabolario dei
                                ticker copre BTC, ETH, SOL, BNB, XRP, DOGE, ADA — fuori da quelli nessun accumulo di
                                notizie cambierà il risultato.
                            </span>
                        }
                        else
                        {
                            <span class="ms-2">
                                di cui <strong>@perSimbolo.ToString("N0")</strong> su @_sentimentBaseTicker
                                (@((100.0 * perSimbolo / Math.Max(1, s.Count)).ToString("0.#"))% del totale)
                            </span>
                        }
                    }
                    @if (From != default && From.Date < s.From.Date)
                    {
                        <span class="text-warning ms-2">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Il periodo parte prima della copertura sentiment: su quel tratto il
                            fattore Sentiment non ha dati (serie vuota, non zero).
                        </span>
                    }
                }
                else
                {
                    <span class="text-body-secondary">
                        <i class="bi bi-chat-left-text me-1"></i>
                        Sentiment: <strong>nessuna notizia scorata a database</strong> — il fattore
                        Sentiment produrrebbe una serie vuota su qualunque periodo.
                    </span>
                }
            </div>
        }
    }
}

@code {
    /// <summary>Simbolo di mercato (es. "BTC/USDT"). Cambiarlo ricarica il range.</summary>
    [Parameter, EditorRequired] public string Symbol { get; set; } = "";

    /// <summary>Timeframe (es. "1h"). Cambiarlo ricarica il range.</summary>
    [Parameter, EditorRequired] public string Timeframe { get; set; } = "";

    /// <summary>Inizio del periodo selezionato dall'utente (per il warning fuori-range).</summary>
    [Parameter] public DateTime From { get; set; }

    /// <summary>Fine del periodo selezionato dall'utente (per il warning fuori-range).</summary>
    [Parameter] public DateTime To { get; set; }

    /// <summary>true mentre il parent è occupato: disabilita "Usa tutto il range".</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>false per nascondere la scorciatoia (pagine senza campi data).</summary>
    [Parameter] public bool ShowUseFullRange { get; set; } = true;

    /// <summary>
    /// [C-06] true nelle pagine dove il fattore Sentiment è selezionabile (feature selection, ML):
    /// mostra la copertura temporale delle notizie scorate, che è molto più corta delle candele.
    /// </summary>
    [Parameter] public bool ShowSentimentCoverage { get; set; }

    /// <summary>Notifica al parent il nuovo periodo quando l'utente clicca "Usa tutto il range" o scatta l'auto-aggancio.</summary>
    [Parameter] public EventCallback<(DateTime From, DateTime To)> OnApplyRange { get; set; }

    /// <summary>true appena si sa che esistono dati per symbol+timeframe correnti, false altrimenti (per gating del Run).</summary>
    [Parameter] public EventCallback<bool> OnHasDataChanged { get; set; }

    private (DateTime From, DateTime To, int Count)? _range;
    private (DateTime From, DateTime To, int Count)? _sentimentRange;

    /// <summary>[I9] Quante notizie scorate riguardano DAVVERO il simbolo in esame. null = non calcolato.</summary>
    private int? _sentimentForSymbol;

    /// <summary>[I9] Il ticker base usato per il conteggio, dichiarato in pagina.</summary>
    private string _sentimentBaseTicker = string.Empty;

    /// <summary>
    /// [I9] Il JSON dei simboli di una notizia menziona il ticker? Confronto per ELEMENTO e non per
    /// sottostringa: una LIKE darebbe falsi positivi fra ticker che si contengono (BTC dentro WBTC),
    /// cioe' una copertura gonfiata proprio dove serve sapere la verita'.
    /// </summary>
    private static bool MentionsTicker(string? symbolsJson, string baseTicker)
    {
        if (string.IsNullOrWhiteSpace(symbolsJson)) return false;
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(symbolsJson);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Array) return false;
            foreach (var el in doc.RootElement.EnumerateArray())
            {
                if (el.ValueKind == System.Text.Json.JsonValueKind.String
                    && string.Equals(el.GetString(), baseTicker, StringComparison.OrdinalIgnoreCase))
                {
                    return true;
                }
            }
        }
        catch (System.Text.Json.JsonException)
        {
            // Un JSON illeggibile non e' una menzione: contarlo gonfierebbe la copertura.
        }
        return false;
    }
    private bool _checked;
    private string? _loadedKey;

    private bool RangeOutsideData =>
        ShowUseFullRange && _range is { } r && (From.Date > r.To.Date || To.Date < r.From.Date);

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{Symbol.Trim()}|{Timeframe}";
        if (key == _loadedKey)
        {
            return; // Cambiate solo le date: nessuna nuova query.
        }
        _loadedKey = key;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        var symbol = Symbol.Trim();
        if (symbol.Length == 0)
        {
            _range = null;
        }
        else
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var agg = await db.OhlcvData
                .Where(c => c.Symbol == symbol && c.Timeframe == Timeframe)
                .GroupBy(_ => 1)
                .Select(g => new { Min = g.Min(c => c.TimestampUtc), Max = g.Max(c => c.TimestampUtc), Count = g.Count() })
                .FirstOrDefaultAsync();
            _range = agg is null ? null : (agg.Min, agg.Max, agg.Count);

            // [I9] La copertura del sentiment era GLOBALE, e il commento diceva che bastava perché
            // «il filtro per ticker avviene al calcolo». È vero, ed è esattamente il motivo per cui
            // NON bastava: il fattore filtra per ticker, quindi su un simbolo fuori dal vocabolario
            // di NewsImpactClassifier (BTC, ETH, SOL, BNB, XRP, DOGE, ADA) è nullo su OGNI barra —
            // mentre questa riga dichiarava una copertura piena. Una pagina che promette dati che il
            // fattore non vedrà mai è la classe «controllo che rassicura».
            if (ShowSentimentCoverage)
            {
                var news = await db.AltDataPoints
                    .Where(a => a.SentimentScore != null)
                    .GroupBy(_ => 1)
                    .Select(g => new { Min = g.Min(a => a.TimestampUtc), Max = g.Max(a => a.TimestampUtc), Count = g.Count() })
                    .FirstOrDefaultAsync();
                _sentimentRange = news is null ? null : (news.Min, news.Max, news.Count);

                // Quante di quelle notizie riguardano DAVVERO il simbolo in esame. Il confronto usa
                // lo stesso ticker base che usa il fattore: due regole darebbero due coperture.
                var baseTicker = (Symbol ?? string.Empty).Split('/')[0].Trim().ToUpperInvariant();
                _sentimentBaseTicker = baseTicker;
                if (!string.IsNullOrEmpty(baseTicker))
                {
                    // Il filtro sul JSON dei simboli si fa in memoria sul solo conteggio: la
                    // colonna è testo e una LIKE darebbe falsi positivi fra ticker che si
                    // contengono (BTC in WBTC), che è peggio di una query un filo più lenta.
                    var simboli = await db.AltDataPoints
                        .Where(a => a.SentimentScore != null)
                        .Select(a => a.SymbolsJson)
                        .ToListAsync();
                    _sentimentForSymbol = simboli.Count(j => MentionsTicker(j, baseTicker));
                }
            }
        }
        _checked = true;

        await OnHasDataChanged.InvokeAsync(_range is not null);

        // Default derivato dai dati: periodo del tutto fuori range → si aggancia ai dati.
        if (RangeOutsideData)
        {
            await ApplyFullRangeAsync();
        }
    }

    private async Task ApplyFullRangeAsync()
    {
        if (_range is { } r)
        {
            await OnApplyRange.InvokeAsync((r.From.Date, r.To.Date));
        }
    }
}
