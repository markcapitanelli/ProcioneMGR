    /// <summary>Colora il prezzo di liquidazione in base a quanto è vicino al prezzo corrente (rischio crescente).</summary>
    private static string LiqPriceClass(OpenPosition p)
    {
        if (p.LiquidationPrice is not decimal liq || liq <= 0m || p.CurrentPrice <= 0m) return "text-muted";
        var distance = Math.Abs(p.CurrentPrice - liq) / p.CurrentPrice;
        return distance switch
        {
            < 0.05m => "text-danger fw-bold",
            < 0.15m => "text-warning fw-semibold",
            _ => "",
        };
    }

    private static string ModeBadge(TradingMode m) => m switch
    {
        TradingMode.Paper => "bg-info text-dark",
        TradingMode.Testnet => "bg-warning text-dark",
        TradingMode.Live => "bg-danger",
        _ => "bg-secondary",
    };

    private static string StatusBadge(OrderStatus s) => s switch
    {
        OrderStatus.Filled => "bg-success",
        OrderStatus.Rejected => "bg-danger",
        OrderStatus.Pending => "bg-secondary",
        _ => "bg-warning text-dark",
    };

    // Delega al componente condiviso <Stat> (stile unico in app.css), come le altre pagine.
    /// <summary>
    /// [2026-08-05] Il profit factor «999» è il SENTINELLA che il motore scrive quando in holdout
    /// non c'è stata nemmeno un'operazione perdente (il rapporto sarebbe infinito). Mostrarlo come
    /// numero fa credere a un rapporto 999:1 — e su poche operazioni è invece il segnale che il
    /// campione è troppo piccolo perché quel rapporto significhi qualcosa.
    /// </summary>
    private static string FormatProfitFactor(decimal? pf) => pf switch
    {
        null => "—",
        >= 999m => "nessuna perdita in holdout",
        _ => pf.Value.ToString("F2"),
    };

    /// <summary>
    /// [2026-08-05] Una protezione a 0,00% non è una protezione «a zero»: è una protezione
    /// ASSENTE. «TP 0,00%» si legge come «prendi profitto a zero», che è tutt'altra cosa.
    /// </summary>
    private static string FormatProtection(decimal? percent) =>
        percent is > 0m ? $"{percent.Value:F2}%" : "non impostato";

    /// <summary><paramref name="hint"/> [2026-08-05]: la riga sotto il valore. Serve quando il numero
    /// da solo si presta a essere letto male — «Cassa» maggiore del capitale iniziale su uno short.</summary>
    private RenderFragment Metric(string label, string value, bool? positive = null, string? hint = null) => builder =>
    {
        builder.OpenComponent<Stat>(0);
        builder.AddComponentParameter(1, nameof(Stat.Label), label);
        builder.AddComponentParameter(2, nameof(Stat.Value), value);
        builder.AddComponentParameter(3, nameof(Stat.Positive), positive);
        builder.AddComponentParameter(4, nameof(Stat.Hint), hint);
        builder.CloseComponent();
    };

    public void Dispose() => _timer?.Dispose();
