    /// <summary>
    /// [E6] Battito di valutazione della corsia visualizzata, già giudicato. Null se lo stato non
    /// c'è. Tre esiti: mai valutato da questo avvio (giallo — dopo un riavvio è la verità, non un
    /// guasto, ma non va spacciata per attività), stantio (rosso: se il numero non scende ai
    /// refresh successivi, nessuno sta valutando stop e trailing), fresco (verde tenue).
    /// </summary>
    private (string Css, string Text)? Heartbeat()
    {
        if (Service.Status is not { IsRunning: true } s) return null;

        if (s.LastProcessedCandleUtc is not DateTime last)
        {
            return ("bg-warning text-dark", "nessuna candela valutata da questo avvio");
        }

        var behind = ProcioneMGR.Services.Ingestion.SeriesFreshness.BarsBehind(s.Timeframe, last, DateTime.UtcNow);
        if (behind is not int b)
        {
            return ("bg-warning text-dark", $"battito non giudicabile (timeframe \"{s.Timeframe}\")");
        }

        var stale = ProcioneMGR.Services.Ingestion.SeriesFreshness.IsStale(s.Timeframe, last, DateTime.UtcNow);

        // [2026-08-06] Dire se la candela valutata è CHIUSA. Prima il battito mostrava «ultima
        // candela 16:00 · 0 barre indietro» in verde mentre quella barra 4h chiudeva alle 20:00: il
        // motore stava valutando stop e target su un High/Low ancora parziale, e l'indicatore che
        // avrebbe dovuto accorgersene rassicurava. Il conteggio delle barre non poteva vederlo —
        // misura contro l'ultima chiusa e la barra aperta gli risulta "0" esattamente come la
        // chiusa. Serviva questa parola in più, non un numero diverso.
        var ultimaChiusa = ProcioneMGR.Services.Ingestion.SeriesFreshness.LastClosedBarOpenUtc(s.Timeframe, DateTime.UtcNow);
        var inFormazione = ultimaChiusa is DateTime chiusa && last > chiusa;

        var text = $"ultima candela {last:dd/MM HH:mm} UTC · {b} barre indietro";
        if (inFormazione)
        {
            return ("bg-warning text-dark",
                $"{text} · ⚠️ ANCORA APERTA: stop e target valutati su prezzi parziali");
        }
        return stale ? ("bg-danger", text) : ("bg-success-subtle text-dark border", $"{text} · barra chiusa");
    }

