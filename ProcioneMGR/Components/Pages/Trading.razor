@page "/trading"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using ProcioneMGR.Services.Backtesting
@using ProcioneMGR.Services.Indicators
@using ProcioneMGR.Services.Trading
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.Manager)]
@implements IDisposable

@inject TradingPageService Service
@inject ProcioneMGR.Services.Security.IMasterKeyProbe KeyProbe
@inject AuthenticationStateProvider AuthProvider
@inject ILogger<Trading> Logger
@inject ILaneDirectory LaneDirectory
@inject ProtectiveExitDiagnosticsService Diagnostics

<PageTitle>Trading</PageTitle>
<h1>Trading
    @if (Service.Status is not null)
    {
        <span class="badge @ModeBadge(Service.Status.Mode)">@Service.Status.Mode</span>
        @if (Service.Status.MarketType == MarketType.Futures)
        {
            <span class="badge bg-dark">FUTURES @(Service.Status.Leverage)x</span>
        }
        else
        {
            <span class="badge bg-light text-dark border">SPOT</span>
        }
        @if (Service.Status.IsRunning)
        {
            <span class="badge bg-success">RUNNING</span>
            @* [E6] Il battito accanto al flag: RUNNING dichiara l'intenzione, questo dice l'attività.
               Stessa regola unica di SeriesFreshness — misurata contro adesso, non contro la serie. *@
            @if (Heartbeat() is { } hb)
            {
                <span class="badge @hb.Css" title="Apertura dell'ultima candela valutata dal motore in questo avvio, giudicata contro adesso (tolleranza @ProcioneMGR.Services.Ingestion.SeriesFreshness.DefaultToleranceBars barre chiuse).">@hb.Text</span>
            }
        }
        else { <span class="badge bg-secondary">STOPPED</span> }
    }
</h1>

@* MaxVisible=12: TUTTE le corsie sempre visibili, in ordine di id. Il collasso "+N" (pensato per
   i portatili) nascondeva le corsie ferme e faceva sembrare RIMOSSA una corsia che era solo
   dietro il menu — domanda vera del proprietario del 2026-08-03 sulla corsia 3. Le corsie non si
   rimuovono MAI (l'id è identità: posizioni e storico vi sono agganciati — lezione delle
   posizioni orfane di luglio); si SVUOTANO, col pulsante nel pannello Controllo. *@
<LaneSelector Lanes="_lanes" Selected="_laneId" SelectedChanged="OnLaneSelectedAsync" MaxVisible="12"
              Hint="Motore di trading indipendente per corsia — stessa isolazione della configurazione in Ensemble. Le corsie non si rimuovono (l'id è identità): si svuotano dal pannello Controllo." />

<GuidaPanel Title="Trading — dal simulato ai soldi veri, con freni di sicurezza">
    <p>
        Questa pagina fa girare <strong>davvero</strong> le strategie (non è una simulazione come
        il Backtest): valuta ogni nuova candela e apre/chiude posizioni in base ai segnali. Ha tre
        modalità pensate per aumentare gradualmente il rischio, così puoi fidarti di una strategia
        prima di rischiare soldi veri.
    </p>
    <dl class="row mb-0">
        <dt class="col-sm-3">Modalità: Paper</dt>
        <dd class="col-sm-9">Denaro <strong>finto</strong>, nessun ordine reale — perfetta per osservare come si comporterebbe una strategia "dal vivo" senza alcun rischio.</dd>
        <dt class="col-sm-3">Modalità: Testnet</dt>
        <dd class="col-sm-9">Ordini <strong>reali</strong> ma su un ambiente di prova dell'exchange (Binance Testnet) con soldi finti forniti dall'exchange stesso — serve una credenziale testnet salvata in <a href="settings/exchanges">Credenziali Exchange</a>. Un passo intermedio realistico prima del Live.</dd>
        <dt class="col-sm-3">Modalità: Live</dt>
        <dd class="col-sm-9">Soldi <strong>veri</strong>. Richiede una conferma esplicita per partire, e ogni singolo ordine automatico resta "in attesa" finché non lo confermi tu manualmente (vedi sotto) — un'ulteriore rete di sicurezza oltre alla configurazione.</dd>
        <dt class="col-sm-3">Avvia / Ferma trading</dt>
        <dd class="col-sm-9">Avvia o ferma il motore. In Paper riparte da zero ogni volta; in Testnet/Live riprende lo stato (posizioni aperte incluse) da dove era rimasto, anche dopo un riavvio dell'applicazione.</dd>
        <dt class="col-sm-3">EMERGENCY STOP</dt>
        <dd class="col-sm-9">Chiude <strong>immediatamente tutte</strong> le posizioni aperte e blocca nuovi ordini — da usare se qualcosa non va e vuoi uscire subito da ogni esposizione, senza aspettare i segnali della strategia.</dd>
        <dt class="col-sm-3">Conferme in attesa (Live)</dt>
        <dd class="col-sm-9">In modalità Live, ogni nuovo ordine proposto automaticamente resta qui finché non lo confermi o rifiuti tu — nessun ordine parte da solo senza la tua approvazione esplicita.</dd>
        <dt class="col-sm-3">Spot vs Futures / Leva</dt>
        <dd class="col-sm-9">
            La modalità (Spot o Futures a leva) e la leva usata si impostano in
            <a href="ensemble">Ensemble</a>, non qui — questa pagina mostra e opera con la
            configurazione già salvata lì. In Futures il badge in alto mostra "FUTURES Nx" e le
            metriche "Margine usato"/"Leva" sostituiscono quelle Spot.
        </dd>
        <dt class="col-sm-3">Posizioni aperte</dt>
        <dd class="col-sm-9">
            Le posizioni attualmente in corso, col guadagno/perdita non ancora realizzato. In
            Futures compaiono anche Leva e <strong>Liq. Price</strong> (prezzo di liquidazione:
            se il mercato lo raggiunge la posizione viene chiusa forzatamente in perdita — evidenziato
            in rosso/giallo quando il prezzo corrente si avvicina). Se la gamba ha uno stop
            validato nel backtest (configurato in <a href="ensemble">Ensemble</a>), Stop Loss/Take
            Profit/Trailing % sono già compilati automaticamente all'apertura — puoi comunque
            modificarli qui a mano in qualsiasi momento con "Set SL/TP" (l'ultima modifica manuale
            ha sempre la precedenza). Il <strong>Trailing %</strong> segue il prezzo quando va a
            favore e si blocca a quella distanza, invece di restare fisso come lo Stop Loss.
            Oppure chiudi manualmente con "Close".
        </dd>
        <dt class="col-sm-3">Ordini recenti</dt>
        <dd class="col-sm-9">Lo storico di ogni ordine tentato, incluso lo stato (eseguito, rifiutato dai controlli di sicurezza, in errore) — se un ordine è stato rifiutato, il motivo compare nella colonna "Error".</dd>
        <dt class="col-sm-3">Configurazione di sicurezza (solo Admin)</dt>
        <dd class="col-sm-9">
            Soglie di protezione applicate a OGNI ordine prima che parta: dimensione massima per
            posizione, esposizione totale massima, perdita giornaliera massima, drawdown massimo
            (oltre il quale scatta un emergency stop automatico), numero massimo di posizioni
            aperte contemporaneamente, e per i Futures la <strong>leva massima consentita</strong>
            (l'avvio viene rifiutato se la leva richiesta in Ensemble la supera). Servono a
            limitare i danni di una strategia che si comporta peggio del previsto.
        </dd>
    </dl>
</GuidaPanel>

@if (Service.StaleSince is DateTime staleSince)
{
    <div class="alert alert-warning fw-bold">
        ⚠️ DATI TRADING NON AGGIORNATI da @((int)(DateTime.UtcNow - staleSince).TotalSeconds)s: il servizio di
        trading non risponde (@Service.LastStaleReason). Quanto vedi qui sotto è l'ultimo stato noto, <u>non</u>
        quello attuale — posizioni e PnL potrebbero essere cambiati. I comandi falliranno finché il
        servizio non torna.
    </div>
}
@if (Service.Status?.IsEmergencyStopped == true)
{
    <div class="alert alert-danger fw-bold">
        🛑 EMERGENCY STOP ATTIVATO: @Service.Status.EmergencyStopReason. Riavvia manualmente dopo aver verificato.
    </div>
}
@if (KeyProbe.Result is { HasUnreadable: true } keyProbe)
{
    <div class="alert alert-danger">
        <div class="fw-bold">🔑 MASTER KEY INCOERENTE: @keyProbe.Unreadable credenziali exchange su @keyProbe.Total non decifrabili.</div>
        <div class="small mt-1">
            Gli avvii Testnet/Live falliranno finché non reinserisci le credenziali in
            <a href="settings/exchanges">/settings/exchanges</a> (o non ripristini la master key giusta).
        </div>
    </div>
}
@if (Service.Quarantine is not null)
{
    <div class="alert alert-danger">
        <div class="fw-bold">⛔ CORSIA IN QUARANTENA dal @Service.Quarantine.CreatedAtUtc.ToString("dd/MM HH:mm") UTC: @Service.Quarantine.Reason</div>
        <div class="small mt-1">
            Il watchdog degli invarianti contabili ha fermato il trading <u>senza chiudere le posizioni</u>.
            Verifica posizioni, ordini e audit: finché la quarantena è attiva la corsia non può essere riavviata
            (un riavvio azzererebbe capitale e PnL, cancellando l'evidenza).
        </div>
        <AuthorizeView Roles="@AppRoles.Admin">
            <button class="btn btn-outline-danger btn-sm mt-2" @onclick="ClearQuarantineAsync">Ho verificato: rimuovi la quarantena</button>
        </AuthorizeView>
    </div>
}
@if (!string.IsNullOrEmpty(Service.Message))
{
    <div class="alert @(Service.IsError ? "alert-danger" : "alert-success")">@Service.Message</div>
}

<div class="card mb-3">
    <div class="card-header">Controllo</div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-4 align-items-center">
            <div>
                <label class="form-label d-block">Modalità</label>
                @foreach (var m in new[] { "Paper", "Testnet", "Live" })
                {
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="mode" id="m_@m" value="@m"
                               checked="@(_mode == m)" @onchange="@(() => _mode = m)" disabled="@_running" />
                        <label class="form-check-label" for="m_@m">@m</label>
                    </div>
                }
            </div>

            <div class="d-flex gap-2">
                @if (!_running)
                {
                    <button class="btn btn-success" @onclick="StartAsync" disabled="@(_mode == "Live" && !_liveConfirmed)">▶ Avvia trading</button>
                }
                else
                {
                    <button class="btn btn-warning" @onclick="StopAsync">⏸ Ferma trading</button>
                }
                @if (!_confirmEmergency)
                {
                    @* Niente animazione: un pulsante d'emergenza dev'essere trovabile, non ansiogeno.
                       Il lampeggio perenne (rimosso 2026-08-03 su richiesta del proprietario) diceva
                       "emergenza" quando non ce n'era nessuna. *@
                    <button class="btn btn-danger" @onclick="() => _confirmEmergency = true">🛑 EMERGENCY STOP</button>
                }
                else
                {
                    <span class="text-danger fw-bold">Chiuderà TUTTE le posizioni. Sei sicuro?</span>
                    <button class="btn btn-danger" @onclick="EmergencyAsync">SÌ, FERMA TUTTO</button>
                    <button class="btn btn-outline-secondary" @onclick="() => _confirmEmergency = false">Annulla</button>
                }
            </div>
        </div>

        @if (_mode == "Live")
        {
            <div class="alert alert-danger mt-3 mb-0">
                ⚠️ <strong>Stai per tradare con soldi veri.</strong>
                <div class="form-check mt-1">
                    <input class="form-check-input" type="checkbox" id="liveok" @bind="_liveConfirmed" />
                    <label class="form-check-label" for="liveok">Confermo</label>
                </div>
            </div>
        }
        @if (_mode == "Testnet")
        {
            <div class="text-muted small mt-2">ℹ️ Testnet piazza ordini reali su <strong>Binance Testnet</strong> con firma HMAC: serve una credenziale <em>testnet</em> in <a href="settings/exchanges">/settings/exchanges</a>.</div>
        }
        @if (_mode == "Live")
        {
            <div class="text-muted small mt-2">ℹ️ In Live ogni apertura richiede <strong>conferma manuale</strong> (safety): gli ordini del worker restano in coda nella sezione "⏳ Conferme in attesa (Live)" qui sotto finché non li approvi o rifiuti uno per uno. Disattivabile solo da RequireManualConfirmationForLive nel pannello sicurezza.</div>
        }

        @* [2026-08-03] Le corsie non si RIMUOVONO (l'id è identità: posizioni e storico vi sono
           agganciati — le posizioni orfane di luglio nacquero proprio da un id sparito). Si
           SVUOTANO: la configurazione si azzera, la corsia torna "non configurata" e libera per
           la flotta; lo storico resta a database. Solo da ferma, con conferma. *@
        @if (!_running && _lanes.FirstOrDefault(l => l.Id == _laneId)?.IsConfigured == true)
        {
            <div class="mt-3 pt-2 border-top">
                @if (!_confirmClear)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmClear = true">🧹 Svuota corsia @_laneId</button>
                    <span class="text-muted small ms-2">azzera la configurazione (lo storico resta): la corsia torna libera per la flotta.</span>
                }
                else
                {
                    <span class="fw-bold me-2">Svuotare la configurazione della corsia @_laneId?</span>
                    <button class="btn btn-sm btn-secondary" @onclick="ClearLaneAsync">Sì, svuota</button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmClear = false">Annulla</button>
                }
            </div>
        }
    </div>
</div>

@if (Service.Status is not null)
{
    @* [2026-08-03] La "carta d'identità" della corsia: cosa gira, con che aspettative, da dove
       viene — lo stesso racconto delle proposte Telegram, qui accanto ai numeri che lo misurano. *@
    @if (Service.Story is { } story)
    {
        <div class="card mb-3">
            <div class="card-header">Cosa sta facendo questa corsia — @story.Symbol @story.Timeframe</div>
            <div class="card-body py-2">
                @foreach (var s in story.Strategies)
                {
                    @* [2026-08-05] Tre correzioni sulle attese, tutte dello stesso tipo — un numero
                       che non significa quello che sembra:
                       · PF 999 è il SENTINELLA di «nessuna operazione perdente in holdout», non un
                         profit factor di 999: si scrive a parole;
                       · TP/TSL a 0,00% NON sono una protezione allo 0%: sono protezioni ASSENTI;
                       · le attese tutte a «—» sulle corsie schierate prima della flotta non sono
                         un guasto: quelle corsie furono configurate a mano e non hanno un holdout
                         registrato. Dirlo è meglio che tre trattini muti. *@
                    <div class="mb-1">
                        <strong>@s.DisplayName</strong>
                        @if (s.ExpectedSharpe is null && s.ExpectedProfitFactor is null && s.ExpectedMaxDrawdown is null)
                        {
                            <span class="text-muted small ms-2"
                                  title="Questa corsia è stata configurata a mano, prima dell'orchestratore di flotta: non ha un holdout registrato con cui confrontare il forward test. I numeri qui sotto restano validi, manca solo il termine di paragone.">
                                attese (holdout): non registrate (corsia configurata a mano)
                            </span>
                        }
                        else
                        {
                            <span class="text-muted small ms-2">
                                attese (holdout): Sharpe @(s.ExpectedSharpe?.ToString("F2") ?? "—")
                                · PF @(FormatProfitFactor(s.ExpectedProfitFactor))
                                · DD @(s.ExpectedMaxDrawdown?.ToString("F1") ?? "—")%
                            </span>
                        }
                        <span class="text-muted small ms-2">
                            &nbsp;·&nbsp; protezioni: SL @FormatProtection(s.StopLossPercent) / TP @FormatProtection(s.TakeProfitPercent)@(s.TrailingStopPercent is > 0m ? $" / TSL {s.TrailingStopPercent:F2}%" : "")
                        </span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(story.Provenance))
                {
                    <div class="text-muted small mt-2 border-top pt-2">
                        <span class="badge @(story.ProvenanceSource == "human" ? "bg-info text-dark" : "bg-secondary") me-1">@(story.ProvenanceSource == "human" ? "tuo click" : story.ProvenanceSource)</span>
                        @story.Provenance
                        @if (story.ProvenanceAtUtc is DateTime at)
                        {
                            <span class="ms-1">(@at.ToLocalTime().ToString("dd/MM HH:mm"))</span>
                        }
                    </div>
                }
                <div class="text-muted small mt-1">
                    In test dal @(Service.Status.StartedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—"): il forward test misura la promessa dell'holdout contro il mercato vero. I numeri qui sotto partono da lì.
                </div>
            </div>
        </div>
    }

    @* [2026-08-03] KPI del TEST CORRENTE (da StartedAtUtc, stessa base della tabella promozioni):
       prima Total PnL/Trades/Win venivano dai totali del motore, che sommano tutte le vite
       precedenti della corsia — 159 trade di luglio accanto a un'equity vuota. Capitale e
       margini restano dallo Status: sono lo stato presente, non una finestra. *@
    @* [2026-08-05] Le tre voci di capitale dicevano cose diverse con nomi che sembravano la stessa
       cosa: «Total Capital» è il capitale INIZIALE (non cambia mai), «Available» è la CASSA — che
       su una posizione SHORT include il ricavato della vendita e può quindi SUPERARE il capitale
       iniziale. Il proprietario ha visto Available 10.799,20 su Total 10.000,00 e ha giustamente
       pensato a un errore: era aritmetica corretta con etichette che non la spiegavano. E mancava
       proprio il numero che conta, l'EQUITY (iniziale + PnL, posizioni aperte comprese). *@
    <div class="row g-2 mb-3">
        @{
            var equity = Service.Status.TotalCapital + Service.Status.TotalPnl;
            var cassaOltreCapitale = Service.Status.AvailableCapital > Service.Status.TotalCapital;
        }
        <div class="col-auto">@Metric("Equity ora", equity.ToString("N2"), Service.Status.TotalPnl >= 0,
            "Quanto vale la corsia adesso: capitale iniziale più il risultato, posizioni aperte comprese (valorizzate al prezzo corrente).")</div>
        <div class="col-auto">@Metric("Capitale iniziale", Service.Status.TotalCapital.ToString("N2"), null,
            "Il capitale con cui la corsia è partita. Non cambia mai: è il riferimento del PnL.")</div>
        <div class="col-auto">@Metric("Cassa", Service.Status.AvailableCapital.ToString("N2"), null,
            cassaOltreCapitale
                ? "Liquidità disponibile. È SUPERIORE al capitale iniziale perché una vendita allo scoperto accredita subito il ricavato: non è un guadagno, la posizione aperta lo compensa in negativo. Guarda l'equity."
                : "Liquidità disponibile per aprire nuove posizioni.")</div>
        <div class="col-auto">@Metric(Service.Status.MarketType == MarketType.Futures ? "Margine usato" : "Impegnato",
            Service.Status.UsedCapital.ToString("N2"), null,
            Service.Status.MarketType == MarketType.Futures
                ? "Margine isolato bloccato dalle posizioni aperte."
                : "Valore nozionale delle posizioni aperte, al prezzo di ingresso.")</div>
        @if (Service.Status.MarketType == MarketType.Futures)
        {
            <div class="col-auto">@Metric("Leva", Service.Status.Leverage + "x")</div>
        }
        @if (Service.Perf is { } perf)
        {
            @* [2026-08-05] «PnL (test) 0,00» accanto a «Max DD 0,74%» con ZERO trade sembrava una
               contraddizione: il PnL del test conta solo le operazioni CHIUSE, il drawdown segue
               anche l'equity delle posizioni APERTE. Adesso ognuno dice di cosa parla, e col
               drawdown che viene da una posizione ancora aperta lo si dichiara. *@
            var soloAperte = perf.TotalTrades == 0 && perf.MaxDrawdown > 0m;
            <div class="col-auto">@Metric("PnL realizzato (test)", perf.TotalReturn.ToString("N2"), perf.TotalReturn >= 0,
                "Somma delle operazioni CHIUSE dall'avvio di questo test. Le posizioni ancora aperte non entrano qui: le vedi nell'equity.")</div>
            <div class="col-auto">@Metric("Max DD % (test)", perf.MaxDrawdown.ToString("F2"), false,
                soloAperte
                    ? "Viene da una posizione ANCORA APERTA: nessuna operazione è stata chiusa, quindi non c'è nulla di realizzato da perdere — ancora."
                    : "Massima discesa dell'equity dall'avvio, posizioni aperte comprese.")</div>
            <div class="col-auto">@Metric("Operazioni chiuse (test)", perf.TotalTrades.ToString(), null,
                Service.Status.OpenPositionCount > 0
                    ? $"{Service.Status.OpenPositionCount} ancora aperta/e, non conteggiata/e qui."
                    : null)</div>
            <div class="col-auto">@Metric("Win (test)", perf.TotalTrades > 0 ? perf.WinRate.ToString("F0") + "%" : "—", null,
                perf.TotalTrades == 0 ? "Serve almeno un'operazione chiusa." : null)</div>
        }
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Promozioni — da Paper a Testnet (mai a Live in automatico)</span>
            <span class="small text-muted">si aggiorna da sola ogni ~30s · <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshPromotionsAsync" disabled="@Service.PromoBusy">Rivaluta ora</button></span>
        </div>
        <div class="card-body">
            <GuidaPanel Title="Come funziona la promozione automatica">
                <p class="mb-1">
                    Una corsia in <strong>Paper</strong> che performa bene abbastanza a lungo (Sharpe, numero di
                    trade, drawdown, win rate e settimane di osservazione tutti sopra soglia) può passare
                    automaticamente a <strong>Testnet</strong> — stesso protocollo del Live ma senza soldi veri.
                    La promozione è <strong>reversibile</strong>: se in Testnet l'edge svanisce, la corsia torna a Paper.
                    I pulsanti «→ Testnet» / «→ Paper» fanno lo stesso passaggio a mano, quando vuoi anticipare tu.
                </p>
                <p class="mb-0">
                    <strong>Confine non negoziabile:</strong> il passaggio a <strong>Live</strong> non è mai
                    automatico e non ha un pulsante qui: si fa dai controlli di modalità, con conferma esplicita.
                </p>
            </GuidaPanel>
            @if (Service.Promotions.Count == 0)
            {
                <p class="text-muted mb-0">Nessuna valutazione disponibile (avvia una corsia in Paper per iniziare a raccogliere metriche).</p>
            }
            else
            {
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            @{
                                const string sinceStartHint = "Metriche misurate DALL'AVVIO della corsia (stessa base della decisione di promozione): possono differire dai KPI del pannello di controllo qui sopra, che usano una finestra di 90 giorni.";
                                const string noTradesHint = "Nessun trade CHIUSO dall'avvio: le metriche non sono ancora significative (lo Sharpe si calcola sull'equity e su poche ore è solo rumore).";
                            }
                            <th>Corsia</th><th>Simbolo</th><th>Modalità</th>
                            <th class="text-end" title="@sinceStartHint">Sharpe</th>
                            <th class="text-end" title="@sinceStartHint">Trade</th>
                            <th class="text-end">Max DD</th><th class="text-end">Win</th>
                            <th class="text-end" title="@sinceStartHint">Osserv.</th><th>Stato</th><th class="text-end">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Service.Promotions)
                        {
                            @* [2026-08-05] Il simbolo si legge dalla CONFIGURAZIONE, la stessa fonte
                               delle schede corsia qui sopra — non dallo stato del motore, che
                               conserva l'ultimo simbolo girato anche dopo lo svuotamento. Prima
                               della correzione la stessa schermata si contraddiceva: la scheda
                               diceva «2 non configurata» e questa riga «2 XLM/USDT · 9gg».
                               Trovato dal proprietario. *@
                            var configured = _lanes.FirstOrDefault(l => l.Id == p.LaneId)?.IsConfigured ?? true;
                            <tr>
                                <td>@p.LaneId</td>
                                <td>
                                    @if (!configured)
                                    {
                                        <span class="text-muted" title="Corsia svuotata: la configurazione è azzerata e la corsia è libera. Lo storico resta a database.">non configurata</span>
                                    }
                                    else
                                    {
                                        @(string.IsNullOrEmpty(p.Symbol) ? "—" : p.Symbol)
                                    }
                                </td>
                                <td><span class="badge @ModeBadge(p.CurrentMode)">@p.CurrentMode</span></td>
                                @* Con ZERO trade chiusi lo Sharpe (calcolato sull'equity) e il win rate sono
                                   rumore travestito da giudizio: si mostra "—", non un numero. E su una
                                   corsia svuotata non si mostra NIENTE: quei numeri appartengono a un test
                                   che non esiste più, e affiancarli a «non configurata» è la stessa
                                   contraddizione di prima con un'altra faccia. *@
                                @if (!configured)
                                {
                                    <td class="text-end text-muted">—</td>
                                    <td class="text-end text-muted">—</td>
                                    <td class="text-end text-muted">—</td>
                                    <td class="text-end text-muted">—</td>
                                }
                                else if (p.Metrics.TradeCount == 0)
                                {
                                    <td class="text-end text-muted" title="@noTradesHint">—</td>
                                    <td class="text-end">0</td>
                                    <td class="text-end">@p.Metrics.MaxDrawdown.ToString("F1")%</td>
                                    <td class="text-end text-muted" title="@noTradesHint">—</td>
                                }
                                else
                                {
                                    <td class="text-end">@p.Metrics.RealizedSharpe.ToString("F2")</td>
                                    <td class="text-end">@p.Metrics.TradeCount</td>
                                    <td class="text-end">@p.Metrics.MaxDrawdown.ToString("F1")%</td>
                                    <td class="text-end">@p.Metrics.WinRate.ToString("P0")</td>
                                }
                                @* Su una corsia svuotata l'osservazione non misura più niente: i
                                   giorni sono quelli del test precedente, e mostrarli accanto a
                                   «non configurata» rimette in scena la contraddizione appena tolta. *@
                                <td class="text-end">
                                    @if (configured) { @($"{p.Metrics.ObservationPeriod.TotalDays:F0}gg") }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td>
                                    @if (p.CurrentMode == TradingMode.Testnet)
                                    {
                                        <span class="badge bg-success">Testnet</span>
                                        @if (p.ShouldDemote) { <span class="badge bg-warning text-dark ms-1">retrocessione consigliata</span> }
                                    }
                                    else if (p.CurrentMode == TradingMode.Live)
                                    {
                                        <span class="badge bg-danger">Live (manuale)</span>
                                    }
                                    else if (p.ReadyForTestnet)
                                    {
                                        <span class="badge bg-warning text-dark" title="@p.Reason">Pronta per Testnet</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary" title="@p.Reason">Paper</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (p.CurrentMode == TradingMode.Paper && p.IsRunning)
                                    {
                                        <button class="btn btn-sm @(p.ReadyForTestnet ? "btn-success" : "btn-outline-secondary")"
                                                @onclick="() => PromoteAsync(p.LaneId, TradingMode.Testnet)" disabled="@Service.PromoBusy"
                                                title="@(p.ReadyForTestnet ? "Tutti i criteri soddisfatti: promozione a Testnet." : "Promozione MANUALE (criteri non ancora tutti soddisfatti): flatten + riavvio in Testnet. Servono credenziali testnet in /settings/exchanges.")">
                                            → Testnet
                                        </button>
                                    }
                                    else if (p.CurrentMode == TradingMode.Testnet && p.IsRunning)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => PromoteAsync(p.LaneId, TradingMode.Paper)" disabled="@Service.PromoBusy"
                                                title="Retrocessione manuale a Paper: flatten + riavvio.">
                                            → Paper
                                        </button>
                                    }
                                    else if (p.CurrentMode == TradingMode.Live)
                                    {
                                        <span class="text-muted small">solo manuale (Controllo)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small" title="Corsia ferma: le transizioni valgono per corsie in esecuzione.">ferma</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            @if (!string.IsNullOrEmpty(Service.PromoMessage))
            {
                <div class="alert @(Service.PromoIsError ? "alert-danger" : "alert-success") mt-2 mb-0 py-2">@Service.PromoMessage</div>
            }
        </div>
    </div>

    @if (Service.Pending.Count > 0)
    {
        <div class="card mb-3 border-warning">
            <div class="card-header bg-warning text-dark fw-bold">⏳ Conferme in attesa (Live) — @Service.Pending.Count</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead><tr><th>Creato</th><th>Side</th><th>Qty</th><th>Prezzo rif.</th><th class="text-end">Azioni</th></tr></thead>
                    <tbody>
                        @foreach (var o in Service.Pending)
                        {
                            <tr>
                                <td class="small">@o.CreatedAtUtc.ToString("MM-dd HH:mm")</td>
                                <td><span class="badge @(o.Side == OrderSide.Buy ? "bg-success" : "bg-danger")">@(o.Side == OrderSide.Buy ? "Long" : "Short")</span></td>
                                <td>@o.Quantity.ToString("N5")</td>
                                <td>@(o.Price?.ToString("N2") ?? "—")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-success" @onclick="() => ConfirmAsync(o.OrderId)">✔ Conferma</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => RejectAsync(o.OrderId)">✕ Rifiuta</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @* [2026-08-06] Protezioni toccate ma non eseguite. Nasce da uno short ETC/USDT sulla corsia 3
       che aveva raggiunto il take profit senza chiudersi: il minimo vero della barra 4h delle 08:00
       era 6,31 contro un target di 6,3786, scritto a database da ore, e NESSUN pannello lo diceva —
       il battito era verde e il PnL non realizzato positivo. La causa è corretta, ma una causa
       corretta non è un controllo: il prossimo motivo per cui un'uscita non scatta sarà un altro. *@
    @if (Service.ExitAnomalies.Count > 0)
    {
        <div class="alert alert-danger mb-3">
            <strong>⚠️ Protezione raggiunta ma posizione ancora aperta.</strong>
            <div class="small mt-1">
                Non è una previsione: è il confronto fra il livello impostato e i prezzi delle barre
                <strong>già chiuse</strong>. Se compare, l'uscita protettiva non è scattata quando doveva.
            </div>
            <ul class="mb-0 mt-2 small">
                @foreach (var a in Service.ExitAnomalies)
                {
                    <li>
                        <code>@a.Symbol</code> — il <strong>@a.Kind</strong> a
                        <strong>@a.Level.ToString("N6").TrimEnd('0').TrimEnd(',')</strong>
                        risulta superato da @a.BarsTouched @(a.BarsTouched == 1 ? "barra chiusa" : "barre chiuse")
                        (fin dove il prezzo è arrivato: <strong>@a.ReachedPrice.ToString("N6").TrimEnd('0').TrimEnd(',')</strong>),
                        la prima il @a.FirstTouchUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm").
                        Posizione <code>…@a.PositionId[^Math.Min(6, a.PositionId.Length)..]</code> ancora aperta.
                    </li>
                }
            </ul>
        </div>
    }

    <div class="card mb-3">
        <div class="card-header">Posizioni aperte (@Service.Positions.Count)</div>
        @if (Service.Positions.Count == 0)
        {
            <div class="card-body text-muted">Nessuna posizione aperta.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm mb-0 align-middle">
                    <thead><tr><th>Strategy</th><th>Side</th><th class="text-end">Entry</th><th class="text-end">Current</th><th class="text-end">Qty</th><th class="text-end">Unreal. PnL</th><th class="text-end">PnL %</th>
                        @if (Service.Status?.MarketType == MarketType.Futures) { <th>Leva</th><th class="text-end">Liq. Price</th> }
                        <th>Stop Loss</th><th>Take Profit</th><th>Trailing %</th><th class="text-end">Azioni</th></tr></thead>
                    <tbody>
                        @foreach (var p in Service.Positions)
                        {
                            <tr>
                                <td><code class="small">@p.StrategyId[..6]</code></td>
                                <td><span class="badge @(p.Side == OrderSide.Buy ? "bg-success" : "bg-danger")">@(p.Side == OrderSide.Buy ? "Long" : "Short")</span></td>
                                <td class="text-end">@p.EntryPrice.ToString("N2")</td>
                                <td class="text-end">@p.CurrentPrice.ToString("N2")</td>
                                <td class="text-end">@p.Quantity.ToString("N5")</td>
                                <td class="text-end @(p.UnrealizedPnl >= 0 ? "text-success" : "text-danger")">@p.UnrealizedPnl.ToString("N2")</td>
                                <td class="text-end @(p.UnrealizedPnlPercent >= 0 ? "text-success" : "text-danger")">@p.UnrealizedPnlPercent.ToString("F2")%</td>
                                @if (Service.Status?.MarketType == MarketType.Futures)
                                {
                                    <td>@(p.Leverage)x</td>
                                    <td class="text-end @LiqPriceClass(p)">@(p.LiquidationPrice?.ToString("N2") ?? "—")</td>
                                }
                                <td><input type="number" step="any" class="form-control form-control-sm" style="width:7rem"
                                           placeholder="—" value="@Service.SlValue(p)" @onchange="e => OnSlChanged(p.PositionId, e.Value?.ToString())" /></td>
                                <td><input type="number" step="any" class="form-control form-control-sm" style="width:7rem"
                                           placeholder="—" value="@Service.TpValue(p)" @onchange="e => OnTpChanged(p.PositionId, e.Value?.ToString())" /></td>
                                <td><input type="number" step="any" min="0" class="form-control form-control-sm" style="width:6rem"
                                           placeholder="—" value="@Service.TslValue(p)" @onchange="e => OnTslChanged(p.PositionId, e.Value?.ToString())" /></td>
                                <td class="text-end text-nowrap">
                                    <button class="btn btn-sm btn-outline-primary me-1" title="Salva SL/TP/Trailing" @onclick="() => SaveSlTpAsync(p.PositionId)">Set SL/TP</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => CloseAsync(p.PositionId)">Close</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* [2026-08-03, richiesta proprietario] Il grafico delle OPERAZIONI: prezzi del simbolo con i
       marker di ogni entrata/uscita del test corrente e le linee entry/SL/TP delle posizioni
       aperte — dove sta il prezzo rispetto a dove la strategia si aspetta di uscire. *@
    @if (Service.ChartCandles.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">Prezzo e operazioni — @Service.Story?.Symbol @Service.Story?.Timeframe (▲▼ entrate · ● uscite col PnL · linee: entry/SL/TP delle posizioni aperte)</div>
            <div class="card-body"><OhlcvChart Candles="Service.ChartCandles" Indicators="@(Array.Empty<ProcioneMGR.Services.Indicators.IndicatorSeries>())" Markers="TradeMarkers()" PriceLines="PositionLines()" Height="360" /></div>
        </div>
    }

    @if (Service.Equity.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">Equity curve (dal test corrente)</div>
            <div class="card-body"><OhlcvChart ShowCandles="false" Indicators="Service.Equity" Height="280" /></div>
        </div>
    }

    @* [2026-08-05] Questa tabella confondeva, e il proprietario ha chiesto perché: mostrava TUTTA
       la vita della corsia — ordini di mesi prima, su SIMBOLI DIVERSI — senza una colonna che
       dicesse su cosa fossero, e col prezzo di RIFERIMENTO al posto di quello davvero eseguito.
       Quattro correzioni: la stessa finestra dei KPI (con lo storico intero a un click), il
       simbolo, il prezzo pagato per gli ordini eseguiti, e un riferimento all'operazione che lega
       fra loro apertura e chiusura. *@
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>
                Ordini @(Service.ShowAllOrders ? "— tutta la storia della corsia" : "di questo test") (@Service.Orders.Count)
            </span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleOrdersAsync">
                @(Service.ShowAllOrders ? "Mostra solo questo test" : "Mostra tutto lo storico")
            </button>
        </div>
        @if (Service.ShowAllOrders)
        {
            <div class="alert alert-warning py-2 mb-0 rounded-0 small">
                Stai vedendo anche le <strong>vite precedenti</strong> di questa corsia.
                @if (Service.Episodes.Count > 0)
                {
                    <text>
                        Gli ordini sono raggruppati per <strong>episodio</strong>: un episodio è un
                        tratto di vita fra due avvii del motore, con il suo simbolo e la sua strategia.
                    </text>
                }
                else
                {
                    <text>
                        Possono esserci ordini su simboli diversi da quello attuale, e con
                        configurazioni che non esistono più: guarda la colonna «Simbolo».
                    </text>
                }
            </div>
        }
        <div class="table-responsive" style="max-height: 320px; overflow:auto;">
            <table class="table table-sm table-striped mb-0">
                <thead class="table-light" style="position:sticky;top:0;">
                    <tr>
                        <th>Quando</th><th>Simbolo</th><th>Operazione</th><th>Lato</th><th>Tipo</th>
                        <th class="text-end">Quantità</th>
                        <th class="text-end" title="Per gli ordini eseguiti è il prezzo DAVVERO pagato; per gli altri il prezzo di riferimento stimato al momento della decisione.">Prezzo</th>
                        <th>Stato</th><th>Errore</th>
                    </tr>
                </thead>
                <tbody>
                    @* [2026-08-06] Raggruppamento per EPISODIO. La domanda del proprietario — «a
                       quali operazioni si riferiscono?» — non si risolve con una colonna in più:
                       un elenco piatto di 610 ordini di 7 strategie su 3 simboli non ha una
                       risposta, perché l'unità mancante era il tratto di vita. Solo nello storico
                       completo: sul test corrente l'episodio è uno solo e raggrupparlo è cerimonia. *@
                    @if (Service.ShowAllOrders && Service.Episodes.Count > 0)
                    {
                        @foreach (var ep in Service.Episodes)
                        {
                            <tr class="table-light">
                                <td colspan="9" class="py-2">
                                    <strong>Episodio @ep.Index — @ep.Title</strong>
                                    <span class="text-muted small ms-2">
                                        dal @ep.StartedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                        @(ep.EndedAtUtc is { } fine ? $"al {fine.ToLocalTime():dd/MM/yyyy HH:mm}" : "a oggi")
                                        · @ep.Mode · @ep.OrderCount @(ep.OrderCount == 1 ? "ordine" : "ordini")
                                    </span>
                                    @if (ep.IsCurrent)
                                    {
                                        <span class="badge bg-primary ms-1">in corso</span>
                                    }
                                    @if (ep.Source == LaneEpisodeSource.Declared)
                                    {
                                        @foreach (var id in ep.SavedStrategyIds)
                                        {
                                            <a class="badge bg-info text-dark ms-1" href="strategies">strategia #@id</a>
                                        }
                                    }
                                    else
                                    {
                                        @* Ciò che è dedotto non viene mai spacciato per dichiarato. *@
                                        <span class="badge bg-secondary ms-1"
                                              title="Questo episodio è precedente al 2026-08-06: l'avvio del motore non registrava simbolo e strategie. Il simbolo qui sopra è DEDOTTO dagli ordini; la strategia di allora non è recuperabile.">
                                            ricostruito
                                        </span>
                                    }
                                </td>
                            </tr>
                            @foreach (var o in Service.OrdersOf(ep))
                            {
                                @RigaOrdine(o)
                            }
                        }
                        var orfani = LaneEpisodeBuilder.OrphanOrders(Service.Episodes, Service.Orders);
                        @* Gli orfani sono ordini più vecchi del più antico `StartEngine` in
                           registro: sulla corsia 0 sono 474, di giugno, quando l'avvio non veniva
                           ancora annotato. Un unico blocco da 474 righe sarebbe lo stesso mucchio
                           di prima; il simbolo è l'unica cosa che si sa di loro, e basta a
                           separarli in gruppi che vogliono dire qualcosa. *@
                        @if (orfani.Count > 0)
                        {
                            <tr class="table-light">
                                <td colspan="9" class="py-2">
                                    <strong>Prima del primo avvio registrato</strong>
                                    <span class="text-muted small ms-2">
                                        @orfani.Count @(orfani.Count == 1 ? "ordine" : "ordini") anteriori
                                        al più vecchio avvio annotato (@Service.Episodes[^1].StartedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")):
                                        di quale episodio facessero parte non resta traccia, si sa solo su cosa operavano.
                                    </span>
                                </td>
                            </tr>
                            @foreach (var gruppo in orfani.GroupBy(o => o.Symbol)
                                                          .OrderByDescending(g => g.Max(o => o.CreatedAtUtc)))
                            {
                                <tr class="table-secondary">
                                    <td colspan="9" class="py-1 small">
                                        <code>@(string.IsNullOrEmpty(gruppo.Key) ? "simbolo assente" : gruppo.Key)</code>
                                        <span class="text-muted ms-2">
                                            @gruppo.Count() @(gruppo.Count() == 1 ? "ordine" : "ordini")
                                            dal @gruppo.Min(o => o.CreatedAtUtc).ToLocalTime().ToString("dd/MM/yyyy")
                                            al @gruppo.Max(o => o.CreatedAtUtc).ToLocalTime().ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                </tr>
                                @foreach (var o in gruppo.OrderByDescending(o => o.CreatedAtUtc))
                                {
                                    @RigaOrdine(o)
                                }
                            }
                        }
                    }
                    else
                    {
                        @foreach (var o in Service.Orders)
                        {
                            @RigaOrdine(o)
                        }
                    }
                    @if (Service.Orders.Count == 0)
                    {
                        @* Il messaggio del vuoto deve dire di QUALE vuoto si tratta: «nessun ordine
                           in questo test» e «nessun ordine mai» sono due fatti diversi, e leggerli
                           come lo stesso è il tipo di confusione che questa correzione toglie. *@
                        <tr>
                            <td colspan="9" class="text-muted small">
                                @if (Service.ShowAllOrders)
                                {
                                    <text>Questa corsia non ha <strong>mai</strong> piazzato un ordine, in nessuna configurazione.</text>
                                }
                                else
                                {
                                    <text>
                                        Nessun ordine da quando è iniziato questo test
                                        (@(Service.Status?.StartedAtUtc is DateTime avvio ? avvio.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "—")).
                                        Se la corsia ha operato in precedenza, lo vedi con «Mostra tutto lo storico».
                                    </text>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <AuthorizeView Roles="@AppRoles.Admin">
        <div class="card mb-3 border-warning">
            <div class="card-header bg-warning-subtle d-flex justify-content-between align-items-center">
                <span>⚙️ Configurazione di sicurezza <span class="badge bg-danger ms-1">solo Admin</span></span>
                <small class="text-muted">
                    @(Service.SafetyIsRemote ? "letta e scritta sul MOTORE via gRPC" : "salvata in appsettings.json")
                    @(Service.SafetySource is { Length: > 0 } src ? $" · sorgente: {src}" : "") · applicata a caldo
                </small>
            </div>
            <div class="card-body">
                @if (!Service.SafetyReachable)
                {
                    <div class="alert alert-warning py-2 small mb-3">
                        ⚠️ <strong>Il motore non ha risposto</strong>: i valori qui sotto sono i default del codice,
                        <u>non</u> le soglie che il motore sta applicando. @Service.SafetyError
                        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="ReloadSafetyAsync">Riprova</button>
                    </div>
                }
                @if (_running)
                {
                    <div class="alert alert-info py-2 small mb-3">
                        Il trading è in esecuzione: le modifiche alle soglie si applicano ai prossimi ordini valutati.
                    </div>
                }
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small">Max size per posizione (% capitale)</label>
                        <input id="safety_maxpos" type="number" step="any" min="0" class="form-control form-control-sm" @bind="Service.Safety.MaxPositionSizePercent" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Size per apertura (% capitale; margine sui Futures)</label>
                        <input type="number" step="any" min="0" class="form-control form-control-sm" @bind="Service.Safety.PositionSizePercent" />
                        <div class="form-text">Sui Futures il nozionale è size × leva: deve stare sotto la max size per posizione.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Max esposizione totale (%)</label>
                        <input type="number" step="any" min="0" class="form-control form-control-sm" @bind="Service.Safety.MaxTotalExposurePercent" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Max perdita giornaliera (%)</label>
                        <input type="number" step="any" min="0" class="form-control form-control-sm" @bind="Service.Safety.MaxDailyLossPercent" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Max drawdown (%) <span class="text-danger">→ emergency stop</span></label>
                        <input id="safety_maxdd" type="number" step="any" min="0" class="form-control form-control-sm" @bind="Service.Safety.MaxDrawdownPercent" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Max posizioni aperte</label>
                        <input type="number" step="1" min="1" class="form-control form-control-sm" @bind="Service.Safety.MaxOpenPositions" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Intervallo minimo tra ordini (s)</label>
                        <input type="number" step="1" min="0" class="form-control form-control-sm" @bind="Service.Safety.MinOrderIntervalSeconds" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Leva massima consentita (Futures)</label>
                        <input type="number" step="1" min="1" class="form-control form-control-sm" @bind="Service.Safety.MaxLeverageAllowed" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Margine di mantenimento stimato (%)</label>
                        <input type="number" step="any" min="0" class="form-control form-control-sm" @bind="Service.Safety.MaintenanceMarginPercent" />
                        <div class="form-text">Usato per stimare il prezzo di liquidazione quando l'exchange non lo riporta ancora.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small">Fee exchange (%)</label>
                        <input type="number" step="any" min="0" class="form-control form-control-sm" @bind="Service.Safety.FeePercent" />
                        <div class="form-text">Applicata in apertura e in chiusura. Tienila allineata al fee tier reale dell'exchange.</div>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="reqConfirm" @bind="Service.Safety.RequireManualConfirmationForLive" />
                            <label class="form-check-label" for="reqConfirm">
                                Richiedi conferma manuale per ogni ordine in <strong>Live</strong>
                                <span class="text-muted">(consigliato: attivo)</span>
                            </label>
                        </div>
                    </div>

                    <div class="col-12"><hr class="my-2" /></div>
                    <div class="col-12">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="volTarget" @bind="Service.Safety.VolatilityTargetingEnabled" />
                            <label class="form-check-label" for="volTarget">
                                <strong>Dosa la posizione sulla volatilità</strong>
                                <span class="text-muted">(spento di default)</span>
                            </label>
                        </div>
                        <div class="form-text">
                            La size per apertura viene moltiplicata per un fattore che punta a una volatilità costante:
                            meno capitale esposto quando il mercato si agita, di più quando si calma.
                            Col tetto a 1,0 il fattore può <strong>solo ridurre</strong> la size, mai aumentarla —
                            quindi accenderlo non può far superare i limiti qui sopra.
                        </div>
                        <div class="alert alert-secondary py-2 mt-2 mb-0 small">
                            <strong>Cosa aspettarsi, misurato — e cosa no.</strong>
                            Questa funzione nasce da un risultato di ricerca che poi <strong>non ha replicato</strong>:
                            su un paniere di 24 monete migliorava lo Sharpe da 0,12 a 0,43, ma su un insieme diverso di
                            12 simboli lo peggiora (0,57 contro 0,79), e su singolo simbolo batte l'esposizione costante
                            equivalente solo in 2 casi su 12. Un campione favorevole e uno sfavorevole non fanno un edge.
                            <br />
                            Quello che fa in modo affidabile, misurato ovunque, è
                            <strong>ridurre l'esposizione media e quindi l'ampiezza delle oscillazioni</strong>
                            (36–62% di esposizione, drawdown compressi; sulle strategie del catalogo dimezza le perdite
                            senza recuperarne nessuna).
                            Accendilo se vuoi <em>oscillare meno accettando di guadagnare meno</em>.
                            Non aspettarti che migliori il rendimento corretto per il rischio, né che sistemi una strategia
                            che perde. Tabelle complete in <code>docs/REPORT-DOSAGGIO-VOLATILITA.md</code>.
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Volatilità annua obiettivo (%)</label>
                        <input type="number" step="any" min="0" class="form-control form-control-sm" @bind="Service.Safety.TargetAnnualVolatilityPercent" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Barre per la stima</label>
                        <input type="number" step="1" min="2" class="form-control form-control-sm" @bind="Service.Safety.VolatilityLookbackBars" />
                        <div class="form-text">30 è il valore validato.</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Fattore minimo</label>
                        <input type="number" step="any" min="0" class="form-control form-control-sm" @bind="Service.Safety.MinExposureMultiplier" />
                        <div class="form-text">Pavimento: sotto non si scende.</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Fattore massimo</label>
                        <input type="number" step="any" min="0" class="form-control form-control-sm" @bind="Service.Safety.MaxExposureMultiplier" />
                        <div class="form-text @(Service.Safety.MaxExposureMultiplier > 1m ? "text-warning" : "")">
                            @(Service.Safety.MaxExposureMultiplier > 1m
                                ? "Sopra 1,0 il dosaggio può INGRANDIRE la posizione: la garanzia di non superare i limiti qui sopra non vale più."
                                : "A 1,0 il dosaggio può solo ridurre.")
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-warning btn-sm" @onclick="SaveSafetyAsync">Salva configurazione</button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ReloadSafetyAsync">Annulla modifiche</button>
                </div>
            </div>
        </div>
    </AuthorizeView>
}

@* ---------------------------------------------------------------------------------------------
   [B3] Diagnostica delle uscite protettive. FUORI dal blocco condizionato allo stato del motore:
   le posizioni orfane e i confronti registrati sono letture su Postgres, e vanno viste soprattutto
   quando il core NON risponde — cioè quando il resto di questa pagina è vuoto.
   --------------------------------------------------------------------------------------------- *@
@* L'esito sta FUORI dal blocco delle orfane, e non e' un dettaglio di impaginazione: quando la
   chiusura riesce la lista si svuota, il blocco sparisce, e con lui sparirebbe la conferma —
   l'operatore vedrebbe la riga svanire senza sapere a che prezzo e' stata chiusa. Trovato
   cliccando il pulsante sul serio, non leggendo il codice. *@
@if (_orphanMessage is not null)
