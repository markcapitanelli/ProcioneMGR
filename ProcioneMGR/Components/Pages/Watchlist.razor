@page "/market/watchlist"
@rendermode InteractiveServer
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using ProcioneMGR.Components.Shared
@using ProcioneMGR.Data
@using ProcioneMGR.Services.Exchanges
@using ProcioneMGR.Services.Ingestion
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.Manager)]

@inject WatchlistPageService Service
@inject ILogger<Watchlist> Logger

<PageTitle>Watchlist</PageTitle>

<h1>Watchlist di mercato</h1>

<GuidaPanel Title="Watchlist — quali dati storici scaricare e tenere aggiornati">
    <p>
        Prima di poter fare un backtest, un'ottimizzazione o qualunque analisi, la piattaforma ha
        bisogno dei <strong>dati storici dei prezzi</strong> (le "candele" OHLCV: apertura,
        massimo, minimo, chiusura, volume di ogni intervallo di tempo). Questa pagina è il punto
        dove dici "tieni sotto controllo questa coppia, su questo exchange, con questa
        granularità" — una volta aggiunta, un servizio in background la scarica e la mantiene
        aggiornata da sola, senza bisogno di tornare qui ogni volta.
    </p>
    <dl class="row mb-0">
        <dt class="col-sm-3">Sync automatico</dt>
        <dd class="col-sm-9">Il riquadro in alto dice se il servizio di aggiornamento <strong>sta girando adesso</strong> e quando ha completato l'ultimo giro. Se è fermo, TUTTE le serie invecchiano insieme: il guasto è lì, non nei simboli.</dd>
        <dt class="col-sm-3">Exchange</dt>
        <dd class="col-sm-9">La borsa da cui scaricare i dati (es. Binance).</dd>
        <dt class="col-sm-3">Symbol</dt>
        <dd class="col-sm-9">La coppia di trading, formato <code>BASE/QUOTE</code> — es. <code>BTC/USDT</code> significa "prezzo di Bitcoin espresso in Tether".</dd>
        <dt class="col-sm-3">Timeframe</dt>
        <dd class="col-sm-9">Ogni quanto tempo viene registrata una candela (1h = una ogni ora, 1d = una al giorno). Puoi tracciare lo stesso symbol su più timeframe contemporaneamente.</dd>
        <dt class="col-sm-3">Stato (Abilitata/Disabilitata)</dt>
        <dd class="col-sm-9">Solo le serie "Abilitata" vengono aggiornate automaticamente in background; puoi disabilitarne una senza cancellare i dati già scaricati. <strong>Non ferma il trading</strong>: le corsie si governano da /trading.</dd>
        <dt class="col-sm-3">Verifica su exchange</dt>
        <dd class="col-sm-9">Chiede all'exchange lo stato dei simboli (TRADING, BREAK, …): una serie ferma con sync vivo di solito è un simbolo sospeso.</dd>
        <dt class="col-sm-3">Sync now</dt>
        <dd class="col-sm-9">Forza subito un aggiornamento di quella serie, senza aspettare il prossimo giro automatico in background.</dd>
        <dt class="col-sm-3">Elimina</dt>
        <dd class="col-sm-9">Rimuove la serie dalla watchlist (smette di essere aggiornata), ma <strong>non cancella</strong> le candele già scaricate — restano disponibili per backtest/analisi.</dd>
    </dl>
</GuidaPanel>

@* [2026-08-15] LA DOMANDA VERA, per prima: «il sync sta girando adesso?». Nell'incidente del
   2026-08-14 (worker morto alle 22:44, 122 serie ferme per 6 ore) questa pagina sapeva solo
   elencare le vittime e consigliava di verificare BREAK sui simboli — l'imputato non era
   nominabile perché «ultimo giro di sync» non era scritto da nessuna parte. Ora il timbro del
   ciclo (HostHeartbeats, ruolo ingestion-sync) sta in testa, col suo verdetto. *@
<div class="card mb-3" style="max-width: 960px;">
    <div class="card-body py-2 d-flex align-items-center flex-wrap gap-2">
        <span>Sync automatico delle candele:</span>
        @if (Service.SyncPulse is not { } pulse)
        {
            <span class="badge bg-light text-dark border">caricamento…</span>
        }
        else if (pulse.Disabled)
        {
            @* Spento da configurazione NON è un guasto: dirlo evita la caccia al pod morto che
               non c'è (review 2026-08-15). *@
            <span class="badge bg-secondary">SPENTO</span>
            <span class="small text-body-secondary">
                il worker è disattivato da configurazione (<code>MarketData:Enabled=false</code>): le serie non vengono aggiornate.
                Riaccendilo da <a href="admin/autonomy">Autonomia</a>.
            </span>
        }
        else if (pulse.LastCycleUtc is not DateTime cycle)
        {
            <span class="badge bg-warning text-dark">MAI VISTO UN GIRO</span>
            <span class="small text-body-secondary">nessun timbro di ciclo a DB: verifica che il worker di sync sia in esecuzione (assetto kind: pod <code>procionemgr-ingestion</code>).</span>
        }
        else if (pulse.Stalled)
        {
            <span class="badge bg-danger">FERMO</span>
            <span class="small">
                ultimo giro <strong>@cycle.ToString("HH:mm") UTC</strong> (@AgeText(cycle) fa)@(pulse.Estimated ? " — stimato" : "").
                Il sync non sta girando: le serie qui sotto invecchiano tutte insieme.
                Assetto kind: pod <code>procionemgr-ingestion</code>; al suo ritorno l'arretrato si drena da solo.
            </span>
        }
        else
        {
            <span class="badge bg-success-subtle text-dark border">vivo</span>
            <span class="small text-body-secondary">
                ultimo giro @(pulse.Outcome is "ciclo interrotto" ? "interrotto dal budget (recupero in corso)" : "completato")
                alle <strong>@cycle.ToString("HH:mm:ss") UTC</strong> (@AgeText(cycle) fa)@(pulse.Estimated ? " — stimato dall'ultima serie sincronizzata" : "")
                · intervallo @((int)pulse.Interval.TotalMinutes) min
            </span>
        }
    </div>
</div>

<div class="card mb-4" style="max-width: 720px;">
    <div class="card-header">Aggiungi serie</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label">Exchange</label>
                <select class="form-select" @bind="_exchange">
                    @foreach (var ex in Enum.GetValues<ExchangeName>())
                    {
                        <option value="@ex">@ex</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Symbol</label>
                <input class="form-control" @bind="_symbol" placeholder="BTC/USDT" style="width: 11rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Timeframe</label>
                <select class="form-select" @bind="_timeframe">
                    @foreach (var tf in Timeframes.Supported.Keys)
                    {
                        <option value="@tf">@tf</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="AddAsync" disabled="@_busy">Aggiungi</button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_status))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")" style="max-width: 960px;">@_status</div>
}

<div class="card" style="max-width: 960px;">
    @* [2026-08-13→15] L'ORA DEL DATO, accanto al dato (Regola 5: mai mostrare un valore vecchio
       come attuale). Il 13 agosto un banner «33 serie FERME» fu letto come allarme in corso mentre
       il sync era sano da ore: allora la cura fu la fotografia con l'ora; ora la pagina si
       AGGIORNA DA SOLA (60 s, solo freschezza/corsie/timbro — mai i conteggi, che costano) e l'ora
       dice quando è passato l'ultimo giro di refresh. *@
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>
            Serie tracciate
            @if (Service.StaleEnabledCount() is > 0 and var nStale)
            {
                <span class="badge bg-danger ms-2">@nStale ferm@(nStale == 1 ? "a" : "e")</span>
            }
        </span>
        <span class="small text-body-secondary d-flex align-items-center gap-2">
            <label class="form-check-label d-flex align-items-center gap-1">
                <input class="form-check-input m-0" type="checkbox" @bind="_soloFerme" /> solo ferme
            </label>
            @if (Service.LoadedAtUtc is { } refreshed)
            {
                <span>auto-refresh 60 s · ultimo: @refreshed.ToString("HH:mm:ss") UTC</span>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="ReloadAsync" disabled="@_busy">Aggiorna</button>
        </span>
    </div>
    @if (Service.Rows is not { } allRows)
    {
        <div class="card-body"><em>Caricamento…</em></div>
    }
    else if (allRows.Count == 0)
    {
        <div class="card-body text-muted">Nessuna serie ancora. Aggiungine una sopra.</div>
    }
    else
    {
        @* [2026-08-13] La divergenza fra questa pagina e il trading vero. Sta in cima e in rosso
           perché è la combinazione PEGGIORE: una corsia che opera una serie che nessuno aggiorna
           più. Disabilitare qui ferma il sync, non il motore — e nulla lo diceva. *@
        @if (Service.LaneOnDisabledSeries() is { Count: > 0 } divergenti)
        {
            <div class="alert alert-danger py-2 small mb-0 rounded-0">
                🔌 <strong>@divergenti.Count corsi@(divergenti.Count == 1 ? "a opera" : "e operano") una serie DISABILITATA qui</strong>:
                @string.Join(", ", divergenti.Select(d => $"corsia {d.Lane.LaneId} ({d.Lane.Mode}) su {d.Series.Symbol} {d.Series.Timeframe}")).
                Questo interruttore governa <strong>l'aggiornamento delle candele</strong>, non il trading: la corsia
                continua a operare su dati che non si aggiornano più, e il feed real-time continua a sorvegliarla
                (si instrada dalle corsie in esecuzione, non da questa pagina).
                Decidi: <a href="trading" class="alert-link">ferma la corsia in Trading</a> oppure riabilita la serie qui sotto.
            </div>
        }

        @* [2026-08-15] Il banner delle ferme fa la DIAGNOSI, non solo il conteggio: con il sync
           fermo l'imputato è il sync (e dirlo evita di disabilitare serie sane — quasi-errore
           dell'incidente); con il sync vivo l'ipotesi giusta è la sospensione del simbolo, e la
           verifica su exchange è un bottone, non più un compito manuale. *@
        @if (Service.StaleEnabledCount() is > 0 and var staleCount)
        {
            @if (Service.SyncPulse is { Disabled: true })
            {
                <div class="alert alert-danger py-2 small mb-0 rounded-0">
                    ⚠️ <strong>@staleCount serie abilitat@(staleCount == 1 ? "a" : "e") FERM@(staleCount == 1 ? "A" : "E")</strong>
                    perché il <strong>worker di sync è SPENTO</strong> da configurazione (riquadro in alto).
                    Non è un guasto dei simboli: riaccendi il sync da <a href="admin/autonomy" class="alert-link">Autonomia</a>.
                </div>
            }
            else if (Service.SyncPulse is { Stalled: true })
            {
                <div class="alert alert-danger py-2 small mb-0 rounded-0">
                    ⚠️ <strong>@staleCount serie abilitat@(staleCount == 1 ? "a" : "e") FERM@(staleCount == 1 ? "A" : "E")</strong>
                    e il <strong>sync è fermo</strong> (riquadro in alto): l'imputato è il sync, non i simboli.
                    Non disabilitare le serie: al ritorno del sync l'arretrato si drena da solo
                    (le serie in drenaggio compaiono come <span class="badge bg-warning text-dark">in recupero</span>).
                </div>
            }
            else
            {
                <div class="alert alert-danger py-2 small mb-0 rounded-0">
                    ⚠️ <strong>@staleCount serie abilitat@(staleCount == 1 ? "a" : "e") FERM@(staleCount == 1 ? "A" : "E")</strong>
                    con il sync vivo: probabile sospensione del simbolo su exchange.
                    <button class="btn btn-sm btn-outline-light ms-1" @onclick="CheckStatusesAsync" disabled="@(_busy || _checkingStatuses)">
                        @(_checkingStatuses ? "verifico…" : "Verifica su exchange")
                    </button>
                    @if (Service.StatusesCheckedAtUtc is { } checkedAt)
                    {
                        <span class="d-block mt-1">
                            Verifica delle @checkedAt.ToString("HH:mm:ss") UTC: le sospese hanno il badge accanto al symbol —
                            per quelle, «Disabilita» annota il motivo da solo (un BREAK può essere temporaneo: la scelta resta tua).
                        </span>
                    }
                </div>
            }
        }
        <table class="table table-striped mb-0 align-middle">
            <thead>
                <tr>
                    <th>Exchange</th><th>Symbol</th><th>TF</th><th>Stato</th>
                    <th>Candele</th><th>Ultima candela / ritardo</th><th>Ultima sync</th><th class="text-end">Azioni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in VisibleRows())
                {
                    <tr>
                        <td><span class="badge bg-dark">@r.Series.Exchange</span></td>
                        <td>
                            @r.Series.Symbol
                            @if (r.ExchangeStatus is { } exStatus && !WatchlistPageService.IsTradable(r.Series.Exchange, exStatus))
                            {
                                <span class="badge bg-danger ms-1" title="Stato riportato dall'exchange">@exStatus</span>
                            }
                        </td>
                        <td>@r.Series.Timeframe</td>
                        <td>
                            @if (r.Series.Enabled)
                            {
                                <span class="badge bg-success">Abilitata</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Disabilitata</span>
                            }
                            <div class="small text-muted">@r.Series.LastSyncStatus</div>
                        </td>
                        <td>@(r.CandleCount?.ToString() ?? "…")</td>
                        <td>
                            @* [E7] Freschezza misurata contro ADESSO con la regola unica di
                               SeriesFreshness — non contro la serie stessa, che è il riferimento
                               che si sposta col guasto (B2.a). *@
                            @if (r.LastCandleUtc is DateTime last)
                            {
                                var behind = SeriesFreshness.BarsBehind(r.Series.Timeframe, last, DateTime.UtcNow);
                                var stale = SeriesFreshness.IsStale(r.Series.Timeframe, last, DateTime.UtcNow);
                                <div class="small">@last.ToString("u")</div>
                                @if (!r.Series.Enabled)
                                {
                                    <span class="badge bg-light text-muted border">non sincronizzata</span>
                                }
                                else if (stale && r.IsRecovering)
                                {
                                    @* Ferma ma l'ultima candela AVANZA e il sync gira: è il drenaggio
                                       post-blocco, non un guasto in corso. *@
                                    <span class="badge bg-warning text-dark">in recupero · @(behind is int rb ? $"{rb} barre indietro" : "ritardo non misurabile")</span>
                                }
                                else if (stale)
                                {
                                    <span class="badge bg-danger">FERMA · @(behind is int b ? $"{b} barre indietro" : "ritardo non misurabile")</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-dark border">aggiornata</span>
                                }
                            }
                            else
                            {
                                <span class="badge @(r.Series.Enabled ? "bg-danger" : "bg-light text-muted border")">nessuna candela</span>
                            }
                        </td>
                        <td>@(r.Series.LastSyncUtc?.ToString("u") ?? "—")</td>
                        <td class="text-end" style="white-space: nowrap;">
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => SyncNowAsync(r.Series.Id)" disabled="@_busy">
                                Sync now
                            </button>
                            <button class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => ToggleAsync(r.Series.Id)" disabled="@_busy">
                                @(r.Series.Enabled ? "Disabilita" : "Abilita")
                            </button>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteAsync(r.Series.Id)" disabled="@_busy">
                                Elimina
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private ExchangeName _exchange = ExchangeName.Binance;
    private string _symbol = "BTC/USDT";
    private string _timeframe = "1h";

    private bool _busy;
    private bool _isError;
    private string? _status;
    private bool _soloFerme;
    private bool _checkingStatuses;
    private PollingTimer? _timer;

    /// <summary>
    /// Vita della PAGINA: cancella le passate di conteggio quando l'utente naviga via. Senza,
    /// ogni azione lasciava dietro una scansione dell'indice che continuava per nessuno — e più
    /// azioni di fila le accumulavano in parallelo (review 2026-08-15).
    /// </summary>
    private readonly CancellationTokenSource _pageCts = new();

    /// <summary>Una passata di conteggio alla volta: la nuova annulla la precedente, che è ormai stantia.</summary>
    private CancellationTokenSource? _countCts;

    protected override async Task OnInitializedAsync()
    {
        await Service.LoadAsync(_pageCts.Token);
        StartCounts();

        // 60 s come Ensemble: la freschezza si muove al passo delle barre e il tick leggero non
        // tocca mai i conteggi. Il callback incapsula StateHasChanged (variante Bot.razor).
        _timer = new PollingTimer(TimeSpan.FromSeconds(60),
            () => InvokeAsync(async () =>
            {
                await Service.RefreshFreshnessAsync(_pageCts.Token);
                StateHasChanged();
            }),
            Logger);
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _countCts?.Cancel();
        _pageCts.Cancel();
        _countCts?.Dispose();
        _pageCts.Dispose();
    }

    private IEnumerable<WatchlistPageService.Row> VisibleRows()
    {
        var rows = Service.Rows ?? [];
        if (!_soloFerme)
        {
            return rows;
        }
        var now = DateTime.UtcNow;
        return rows.Where(r => r.Series.Enabled
            && SeriesFreshness.IsStale(r.Series.Timeframe, r.LastCandleUtc, now));
    }

    private static string AgeText(DateTime utc)
    {
        var age = DateTime.UtcNow - utc;
        return age.TotalHours >= 1 ? $"{(int)age.TotalHours} h {age.Minutes} min" : $"{(int)age.TotalMinutes} min";
    }

    /// <summary>
    /// I conteggi arrivano DOPO il primo paint: la colonna mostra «…» finché non ci sono. Una
    /// passata alla volta, cancellabile: la scansione dell'indice non deve sopravvivere né alla
    /// navigazione né a un'azione successiva che la rende stantia.
    /// </summary>
    private void StartCounts()
    {
        var previous = _countCts;
        var cts = CancellationTokenSource.CreateLinkedTokenSource(_pageCts.Token);
        _countCts = cts;
        previous?.Cancel();
        previous?.Dispose();

        _ = Task.Run(async () =>
        {
            try
            {
                await Service.LoadCountsAsync(cts.Token);
                await InvokeAsync(StateHasChanged);
            }
            catch (OperationCanceledException)
            {
                // Passata superata o pagina chiusa: nulla da dire.
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Conteggio candele della watchlist fallito (la pagina resta usabile).");
            }
        });
    }

    private async Task ReloadAsync()
    {
        _busy = true;
        try
        {
            await Service.LoadAsync(_pageCts.Token);
            StartCounts();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AddAsync()
    {
        _busy = true;
        try
        {
            var (message, isError) = await Service.AddAsync(_exchange, _symbol, _timeframe, _pageCts.Token);
            SetStatus(message, isError);
            await Service.LoadAsync(_pageCts.Token);
            StartCounts();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SyncNowAsync(int id)
    {
        _busy = true;
        try
        {
            var (message, isError) = await Service.SyncNowAsync(id, _pageCts.Token);
            SetStatus(message, isError);
            await Service.RefreshFreshnessAsync(_pageCts.Token);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleAsync(int id)
    {
        _busy = true;
        try
        {
            var (message, isError) = await Service.ToggleAsync(id, _pageCts.Token);
            SetStatus(message, isError);
            await Service.LoadAsync(_pageCts.Token);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(int id)
    {
        _busy = true;
        try
        {
            var (message, isError) = await Service.DeleteAsync(id, _pageCts.Token);
            SetStatus(message, isError);
            await Service.LoadAsync(_pageCts.Token);
            StartCounts();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CheckStatusesAsync()
    {
        _checkingStatuses = true;
        try
        {
            var esito = await Service.CheckExchangeStatusesAsync(_pageCts.Token);

            // L'esito dice anche cosa NON è stato verificato: «0 sospese» con tutte le chiamate
            // fallite rassicurava a vuoto — è la classe di difetto del Filone E (review 2026-08-15).
            if (esito.AllFailed)
            {
                SetStatus($"Verifica exchange NON riuscita: nessuno stato ottenuto da {string.Join(", ", esito.FailedExchanges)}. "
                        + "I badge di stato restano vuoti: non c'è alcun verdetto sui simboli.", true);
            }
            else if (esito.FailedExchanges.Count > 0)
            {
                SetStatus($"Verifica exchange PARZIALE: {esito.Suspended} serie ferm{(esito.Suspended == 1 ? "a risulta sospesa" : "e risultano sospese")}/non quotate. "
                        + $"Nessuno stato da {string.Join(", ", esito.FailedExchanges)}: quelle serie restano senza verdetto.", true);
            }
            else
            {
                SetStatus($"Verifica exchange completata: {esito.Suspended} serie ferm{(esito.Suspended == 1 ? "a risulta sospesa" : "e risultano sospese")}/non quotate.", false);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException || !_pageCts.IsCancellationRequested)
        {
            SetStatus($"Verifica exchange fallita: {ex.Message}", true);
        }
        finally
        {
            _checkingStatuses = false;
        }
    }

    private void SetStatus(string text, bool error)
    {
        _status = text;
        _isError = error;
    }
}
