@page "/market/watchlist"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ProcioneMGR.Data
@using ProcioneMGR.Services.Exchanges
@using ProcioneMGR.Services.Ingestion
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.Manager)]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IMarketDataSyncService SyncService
@inject ProcioneMGR.Services.MarketData.ISymbolCatalog SymbolCatalog

<PageTitle>Watchlist</PageTitle>

<h1>Watchlist di mercato</h1>

<GuidaPanel Title="Watchlist — quali dati storici scaricare e tenere aggiornati">
    <p>
        Prima di poter fare un backtest, un'ottimizzazione o qualunque analisi, la piattaforma ha
        bisogno dei <strong>dati storici dei prezzi</strong> (le "candele" OHLCV: apertura,
        massimo, minimo, chiusura, volume di ogni intervallo di tempo). Questa pagina è il punto
        dove dici "tieni sotto controllo questa coppia, su questo exchange, con questa
        granularità" — una volta aggiunta, un servizio in background la scarica e la mantiene
        aggiornata da sola, senza bisogno di tornare qui ogni volta.
    </p>
    <dl class="row mb-0">
        <dt class="col-sm-3">Exchange</dt>
        <dd class="col-sm-9">La borsa da cui scaricare i dati (es. Binance).</dd>
        <dt class="col-sm-3">Symbol</dt>
        <dd class="col-sm-9">La coppia di trading, formato <code>BASE/QUOTE</code> — es. <code>BTC/USDT</code> significa "prezzo di Bitcoin espresso in Tether".</dd>
        <dt class="col-sm-3">Timeframe</dt>
        <dd class="col-sm-9">Ogni quanto tempo viene registrata una candela (1h = una ogni ora, 1d = una al giorno). Puoi tracciare lo stesso symbol su più timeframe contemporaneamente.</dd>
        <dt class="col-sm-3">Stato (Abilitata/Disabilitata)</dt>
        <dd class="col-sm-9">Solo le serie "Abilitata" vengono aggiornate automaticamente in background; puoi disabilitarne una senza cancellare i dati già scaricati.</dd>
        <dt class="col-sm-3">Candele</dt>
        <dd class="col-sm-9">Quante candele sono già presenti nel database per quella serie — un numero basso significa che c'è ancora poco storico su cui lavorare.</dd>
        <dt class="col-sm-3">Sync now</dt>
        <dd class="col-sm-9">Forza subito un aggiornamento di quella serie, senza aspettare il prossimo giro automatico in background.</dd>
        <dt class="col-sm-3">Elimina</dt>
        <dd class="col-sm-9">Rimuove la serie dalla watchlist (smette di essere aggiornata), ma <strong>non cancella</strong> le candele già scaricate — restano disponibili per backtest/analisi.</dd>
    </dl>
</GuidaPanel>

<div class="card mb-4" style="max-width: 720px;">
    <div class="card-header">Aggiungi serie</div>
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label">Exchange</label>
                <select class="form-select" @bind="_exchange">
                    @foreach (var ex in Enum.GetValues<ExchangeName>())
                    {
                        <option value="@ex">@ex</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Symbol</label>
                <input class="form-control" @bind="_symbol" placeholder="BTC/USDT" style="width: 11rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Timeframe</label>
                <select class="form-select" @bind="_timeframe">
                    @foreach (var tf in Timeframes.Supported.Keys)
                    {
                        <option value="@tf">@tf</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="AddAsync" disabled="@_busy">Aggiungi</button>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_status))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")" style="max-width: 960px;">@_status</div>
}

<div class="card" style="max-width: 960px;">
    @* [2026-08-13] L'ORA DEL DATO, accanto al dato. Questa pagina è una fotografia scattata al
       caricamento e non si aggiorna da sola: il 13 agosto il banner «33 serie FERME» è stato letto
       come allarme in corso mentre il sync era tornato sano da ore, e la freschezza si giudica
       CONTRO ADESSO — con un «adesso» vecchio il verdetto è vecchio. Regola 5: mai mostrare un
       valore vecchio come se fosse attuale. *@
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Serie tracciate</span>
        <span class="small text-body-secondary">
            @if (_loadedAtUtc is { } scattata)
            {
                <span class="me-2">fotografia delle @scattata.ToString("HH:mm:ss") UTC@(DateTime.UtcNow - scattata > TimeSpan.FromMinutes(5) ? " — non più recente" : "")</span>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync" disabled="@_busy">Aggiorna</button>
        </span>
    </div>
    @if (_rows is null)
    {
        <div class="card-body"><em>Caricamento…</em></div>
    }
    else if (_rows.Count == 0)
    {
        <div class="card-body text-muted">Nessuna serie ancora. Aggiungine una sopra.</div>
    }
    else
    {
        @* [E7] Il conteggio delle ferme sta SOPRA la tabella: una serie morta in fondo all'elenco
           non deve dipendere dallo scroll per farsi vedere — MKR è stata ferma dieci mesi con la
           pagina che diceva «Abilitata». *@
        @* [2026-08-13] La divergenza fra questa pagina e il trading vero. Sta in cima e in rosso
           perché è la combinazione PEGGIORE: una corsia che opera una serie che nessuno aggiorna
           più. Disabilitare qui ferma il sync, non il motore — e nulla lo diceva. *@
        @if (LaneOnDisabledSeries() is { Count: > 0 } divergenti)
        {
            <div class="alert alert-danger py-2 small mb-0 rounded-0">
                🔌 <strong>@divergenti.Count corsi@(divergenti.Count == 1 ? "a opera" : "e operano") una serie DISABILITATA qui</strong>:
                @string.Join(", ", divergenti.Select(d => $"corsia {d.Lane.LaneId} ({d.Lane.Mode}) su {d.Series.Symbol} {d.Series.Timeframe}")).
                Questo interruttore governa <strong>l'aggiornamento delle candele</strong>, non il trading: la corsia
                continua a operare su dati che non si aggiornano più, e il feed real-time continua a sorvegliarla
                (si instrada dalle corsie in esecuzione, non da questa pagina).
                Decidi: <a href="trading" class="alert-link">ferma la corsia in Trading</a> oppure riabilita la serie qui sotto.
            </div>
        }

        @if (StaleEnabledCount() is > 0 and var staleCount)
        {
            <div class="alert alert-danger py-2 small mb-0 rounded-0">
                ⚠️ <strong>@staleCount serie abilitat@(staleCount == 1 ? "a" : "e") FERM@(staleCount == 1 ? "A" : "E")</strong>
                @if (_loadedAtUtc is { } t) { <text>alle @t.ToString("HH:mm") UTC</text> }:
                l'ultima candela chiusa era più indietro della tolleranza
                (@ProcioneMGR.Services.Ingestion.SeriesFreshness.DefaultToleranceBars barre). Il sync non le stava aggiornando:
                verifica su exchange se il simbolo è sospeso (stato BREAK) e valuta se disabilitarle.
                <span class="d-block mt-1">Il conteggio è di quel momento: premi <strong>Aggiorna</strong> qui sopra prima di decidere — un blocco del sync rientrato lascia questo avviso invariato finché la pagina non viene ricaricata.</span>
            </div>
        }
        <table class="table table-striped mb-0 align-middle">
            <thead>
                <tr>
                    <th>Exchange</th><th>Symbol</th><th>TF</th><th>Stato</th>
                    <th>Candele</th><th>Ultima candela / ritardo</th><th>Ultima sync</th><th class="text-end">Azioni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _rows)
                {
                    <tr>
                        <td><span class="badge bg-dark">@r.Series.Exchange</span></td>
                        <td>@r.Series.Symbol</td>
                        <td>@r.Series.Timeframe</td>
                        <td>
                            @if (r.Series.Enabled)
                            {
                                <span class="badge bg-success">Abilitata</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Disabilitata</span>
                            }
                            <div class="small text-muted">@r.Series.LastSyncStatus</div>
                        </td>
                        <td>@r.CandleCount</td>
                        <td>
                            @* [E7] Freschezza misurata contro ADESSO con la regola unica di
                               SeriesFreshness — non contro la serie stessa, che è il riferimento
                               che si sposta col guasto (B2.a). *@
                            @if (r.LastCandleUtc is DateTime last)
                            {
                                var behind = ProcioneMGR.Services.Ingestion.SeriesFreshness.BarsBehind(r.Series.Timeframe, last, DateTime.UtcNow);
                                var stale = ProcioneMGR.Services.Ingestion.SeriesFreshness.IsStale(r.Series.Timeframe, last, DateTime.UtcNow);
                                <div class="small">@last.ToString("u")</div>
                                @if (!r.Series.Enabled)
                                {
                                    <span class="badge bg-light text-muted border">non sincronizzata</span>
                                }
                                else if (stale)
                                {
                                    <span class="badge bg-danger">FERMA · @(behind is int b ? $"{b} barre indietro" : "ritardo non misurabile")</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-dark border">aggiornata</span>
                                }
                            }
                            else
                            {
                                <span class="badge @(r.Series.Enabled ? "bg-danger" : "bg-light text-muted border")">nessuna candela</span>
                            }
                        </td>
                        <td>@(r.Series.LastSyncUtc?.ToString("u") ?? "—")</td>
                        <td class="text-end" style="white-space: nowrap;">
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => SyncNowAsync(r.Series.Id)" disabled="@_busy">
                                Sync now
                            </button>
                            <button class="btn btn-sm btn-outline-secondary"
                                    @onclick="() => ToggleAsync(r.Series.Id)" disabled="@_busy">
                                @(r.Series.Enabled ? "Disabilita" : "Abilita")
                            </button>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteAsync(r.Series.Id)" disabled="@_busy">
                                Elimina
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private ExchangeName _exchange = ExchangeName.Binance;
    private string _symbol = "BTC/USDT";
    private string _timeframe = "1h";

    private List<Row>? _rows;
    private bool _busy;
    private bool _isError;
    private string? _status;

    /// <summary>Corsie in esecuzione: servono a confrontare la watchlist col trading vero.</summary>
    private List<LaneRow> _runningLanes = [];

    /// <summary>Quando è stata scattata la fotografia mostrata. La freschezza si giudica contro ADESSO: senza quest'ora, un verdetto vecchio si legge come corrente.</summary>
    private DateTime? _loadedAtUtc;

    private sealed record Row(TrackedSeries Series, int CandleCount, DateTime? LastCandleUtc);

    private sealed record LaneRow(int LaneId, string Symbol, string Timeframe, string Mode);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>[E7] Serie ABILITATE la cui ultima candela è più indietro della tolleranza.</summary>
    private int StaleEnabledCount() => _rows?.Count(r => r.Series.Enabled
        && ProcioneMGR.Services.Ingestion.SeriesFreshness.IsStale(r.Series.Timeframe, r.LastCandleUtc, DateTime.UtcNow)) ?? 0;

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var series = await db.TrackedSeries
            .OrderBy(s => s.Exchange).ThenBy(s => s.Symbol).ThenBy(s => s.Timeframe)
            .ToListAsync();

        // Conteggio candele per (Symbol, Timeframe) in UNA sola query aggregata invece di una
        // CountAsync per serie: con molte serie e timeframe intraday (5m ~150k candele l'una) il
        // pattern N+1 diventava un collo di bottiglia a ogni caricamento pagina.
        // [E7] La stessa query porta anche l'ULTIMA candela: è il dato da cui la freschezza si
        // giudica contro adesso, e prima non arrivava mai a questa pagina.
        var aggregates = await db.OhlcvData
            .GroupBy(c => new { c.Symbol, c.Timeframe })
            .Select(g => new { g.Key.Symbol, g.Key.Timeframe, Count = g.Count(), Last = (DateTime?)g.Max(c => c.TimestampUtc) })
            .ToDictionaryAsync(x => (x.Symbol, x.Timeframe), x => (x.Count, x.Last));

        _rows = series
            .Select(s =>
            {
                var (count, last) = aggregates.GetValueOrDefault((s.Symbol, s.Timeframe));
                return new Row(s, count, last);
            })
            .ToList();

        // [2026-08-13] Le corsie IN ESECUZIONE, per scoprire quelle che operano una serie
        // disabilitata qui: vedi LaneOnDisabledSeries().
        _runningLanes = await db.TradingEngineStates.AsNoTracking()
            .Where(t => t.IsRunning)
            .Select(t => new LaneRow(t.LaneId, t.Symbol, t.Timeframe, t.Mode.ToString()))
            .ToListAsync();

        _loadedAtUtc = DateTime.UtcNow;
    }

    /// <summary>
    /// [2026-08-13] Corsie che operano una serie DISABILITATA in watchlist. È l'equivoco che è
    /// costato una mattinata di notifiche su STX/USDT: le quattro serie erano state disabilitate
    /// per far tacere gli allarmi, ma la corsia 7 continuava a operare STX/USDT 4h — questo
    /// interruttore governa il SYNC DELLE CANDELE, non il trading, e i due non si parlano. Il
    /// risultato era il peggiore dei due mondi: corsia viva su una serie che nessuno aggiorna più.
    /// </summary>
    private List<(LaneRow Lane, TrackedSeries Series)> LaneOnDisabledSeries()
    {
        if (_rows is null) return [];
        return _runningLanes
            .Select(l => (Lane: l, Series: _rows.FirstOrDefault(r =>
                !r.Series.Enabled
                && string.Equals(r.Series.Symbol, l.Symbol, StringComparison.OrdinalIgnoreCase)
                && r.Series.Timeframe == l.Timeframe)?.Series))
            .Where(x => x.Series is not null)
            .Select(x => (x.Lane, x.Series!))
            .ToList();
    }

    private async Task AddAsync()
    {
        var symbol = _symbol?.Trim().ToUpperInvariant() ?? "";
        if (string.IsNullOrWhiteSpace(symbol))
        {
            SetStatus("Inserisci un symbol (es. BTC/USDT).", error: true);
            return;
        }

        _busy = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var exists = await db.TrackedSeries.AnyAsync(s =>
                s.Exchange == _exchange && s.Symbol == symbol && s.Timeframe == _timeframe);
            if (exists)
            {
                SetStatus("Questa serie è già tracciata.", error: true);
                return;
            }

            db.TrackedSeries.Add(new TrackedSeries
            {
                Exchange = _exchange,
                Symbol = symbol,
                Timeframe = _timeframe,
                Enabled = true,
            });
            await db.SaveChangesAsync();
            SymbolCatalog.Invalidate(); // [E-04] i menu delle altre pagine vedono subito la serie nuova/rimossa
            SetStatus($"Aggiunta {_exchange} {symbol} {_timeframe}.", error: false);
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SyncNowAsync(int id)
    {
        _busy = true;
        try
        {
            var n = await SyncService.SyncSeriesAsync(id);
            SetStatus($"Sync completata: {n} candele processate.", error: false);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            SetStatus($"Errore sync: {ex.Message}", error: true);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleAsync(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var s = await db.TrackedSeries.FirstOrDefaultAsync(x => x.Id == id);
        if (s is not null)
        {
            s.Enabled = !s.Enabled;
            await db.SaveChangesAsync();
            SymbolCatalog.Invalidate(); // [E-04] i menu delle altre pagine vedono subito la serie nuova/rimossa

            // [2026-08-13] Dirlo NEL MOMENTO in cui l'equivoco nasce, non dopo: disabilitare una
            // serie che una corsia sta operando la lascia viva su candele che smettono di arrivare.
            if (!s.Enabled)
            {
                var lanes = await db.TradingEngineStates.AsNoTracking()
                    .Where(t => t.IsRunning && t.Symbol == s.Symbol && t.Timeframe == s.Timeframe)
                    .Select(t => new { t.LaneId, t.Mode })
                    .ToListAsync();
                if (lanes.Count > 0)
                {
                    SetStatus(
                        $"Serie disabilitata, ma {string.Join(" e ", lanes.Select(l => $"la corsia {l.LaneId} ({l.Mode})"))} "
                        + "la sta operando: qui si ferma solo l'aggiornamento delle candele, NON il trading. "
                        + "La corsia continuerà a decidere su dati che non si aggiornano più — fermala in /trading "
                        + "oppure riabilita la serie.", error: true);
                }
            }

            await LoadAsync();
        }
    }

    private async Task DeleteAsync(int id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.TrackedSeries.Where(x => x.Id == id).ExecuteDeleteAsync();
        SetStatus("Serie rimossa dalla watchlist (i dati OHLCV restano nel DB).", error: false);
        await LoadAsync();
    }

    private void SetStatus(string text, bool error)
    {
        _status = text;
        _isError = error;
    }
}
