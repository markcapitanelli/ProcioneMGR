@using Microsoft.JSInterop
@using ProcioneMGR.Data
@using ProcioneMGR.Services.Indicators
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_container" style="width: 100%; height: @(Height)px;"></div>

@code {
    /// <summary>Candele OHLCV (ordine cronologico crescente). Ignorate se <see cref="ShowCandles"/> è false.</summary>
    [Parameter] public IReadOnlyList<OhlcvData> Candles { get; set; } = Array.Empty<OhlcvData>();

    /// <summary>Serie sovrapposte (EMA, Bollinger, RSI, MACD, equity curve...).</summary>
    [Parameter] public IReadOnlyList<IndicatorSeries> Indicators { get; set; } = Array.Empty<IndicatorSeries>();

    /// <summary>Se false, nasconde candlestick/volume (modalità solo-linee, es. equity curve).</summary>
    [Parameter] public bool ShowCandles { get; set; } = true;

    [Parameter] public int Height { get; set; } = 480;

    /// <summary>[2026-08-03] Marker delle operazioni (entrate/uscite) sul grafico candele. Ignorati se ShowCandles è false.</summary>
    [Parameter] public IReadOnlyList<ChartMarker> Markers { get; set; } = Array.Empty<ChartMarker>();

    /// <summary>Linee orizzontali di prezzo (entry/SL/TP delle posizioni aperte). Ignorate se ShowCandles è false.</summary>
    [Parameter] public IReadOnlyList<ChartPriceLine> PriceLines { get; set; } = Array.Empty<ChartPriceLine>();

    /// <summary>Un marker: position "aboveBar"|"belowBar"|"inBar"; shape "arrowUp"|"arrowDown"|"circle"|"square".</summary>
    public sealed record ChartMarker(long Time, string Position, string Color, string Shape, string Text);

    public sealed record ChartPriceLine(double Price, string Color, string Title, bool Dashed = true);

    private ElementReference _container;
    private IJSObjectReference? _module;
    private readonly string _chartId = "chart_" + Guid.NewGuid().ToString("N");
    private bool _initialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/ohlcvChart.js");
            await _module.InvokeVoidAsync("init", _container, _chartId, ShowCandles);
            _initialized = true;
            await PushAllAsync();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_initialized)
        {
            await PushAllAsync();
        }
    }

    private async Task PushAllAsync()
    {
        if (_module is null) return;

        if (ShowCandles)
        {
            var candlePayload = Candles.Select(c => new
            {
                time = ToUnixSeconds(c.TimestampUtc),
                open = (double)c.Open,
                high = (double)c.High,
                low = (double)c.Low,
                close = (double)c.Close,
                volume = (double)c.Volume,
            }).ToArray();
            await _module.InvokeVoidAsync("setData", _chartId, candlePayload);

            await _module.InvokeVoidAsync("setMarkers", _chartId, Markers
                .OrderBy(m => m.Time) // lightweight-charts esige i marker in ordine di tempo
                .Select(m => new { time = m.Time, position = m.Position, color = m.Color, shape = m.Shape, text = m.Text })
                .ToArray());
            await _module.InvokeVoidAsync("setPriceLines", _chartId, PriceLines
                .Select(l => new { price = l.Price, color = l.Color, title = l.Title, dashed = l.Dashed })
                .ToArray());
        }

        var indicatorPayload = Indicators.Select(s => new
        {
            title = s.Title,
            color = s.Color,
            type = s.Type.ToString(),
            scale = s.Scale,
            data = s.Points.Select(p => new { time = p.Time, value = p.Value }).ToArray(),
        }).ToArray();
        await _module.InvokeVoidAsync("setIndicators", _chartId, indicatorPayload);
    }

    private static long ToUnixSeconds(DateTime utc) =>
        new DateTimeOffset(DateTime.SpecifyKind(utc, DateTimeKind.Utc)).ToUnixTimeSeconds();

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose", _chartId);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
