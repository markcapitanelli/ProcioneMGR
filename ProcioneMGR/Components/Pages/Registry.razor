@page "/registry"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ProcioneMGR.Data
@using ProcioneMGR.Services.Registry
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.Manager)]

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IModelRegistry Reg

<PageTitle>Registry modelli</PageTitle>

<h1>Registry modelli</h1>

<GuidaPanel Title="Ciclo di vita dei modelli ML — chi è il Champion, e perché">
    <p>
        Ogni modello vive uno <strong>stadio</strong>: <em>Staging → Challenger → Champion</em>, con
        uscita a <em>Retired</em>. C'è <strong>un solo Champion per (coppia, timeframe)</strong>.
    </p>
    <p>
        La promozione a Champion passa dal <strong>gate del Deflated Sharpe</strong> (Fase 1): un
        modello con DSR inferiore non sostituisce mai quello in carica. Il monitor di drift, se un
        Champion degrada, lo <strong>ritira e accoda un retrain</strong> — mai un'azione sul trading Live.
    </p>
    <p class="mb-2">
        <strong>Una colonna DSR vuota non vuol dire «non ancora valutato».</strong> Al 2026-08-20, su
        <strong>164 modelli salvati nessuno aveva un Deflated Sharpe</strong> — e non per un guasto: 50
        di loro erano stati regolarmente validati dalla pipeline e <em>tutti</em> bocciati sull'holdout,
        con Sharpe fra −1 e −62. Il DSR si calcola solo per chi supera quel primo esame, quindi per loro
        non è mai esistito un numero. Da qui il badge <span class="badge bg-danger">scartato prima del
        gate</span>, che dice il fatto invece di lasciare un trattino ambiguo. Il trattino, dove resta,
        significa <em>«nessun esito registrato»</em>: i run precedenti al 2026-08-20 non scrivevano la
        provenienza.
    </p>
    <p>
        <strong>Due DSR non sono automaticamente confrontabili</strong>, ed è per questo che accanto al
        numero c'è la colonna «Misurato su». Un DSR prodotto dalla pagina <a href="ml">/ml</a> nasce da
        un solo track: N&nbsp;=&nbsp;1 significa <em>nessuna deflazione</em> — è di fatto un
        Probabilistic Sharpe — e per giunta su un backtest senza slippage né funding, quindi risulta
        sistematicamente più alto. Un DSR della pipeline è deflazionato sui tentativi veri della ricerca
        e misurato coi costi pieni. Se i due N differiscono di oltre un ordine di grandezza, o se uno
        dei due non è dichiarato (righe misurate prima del 2026-08-20), <strong>la promozione viene
        rifiutata</strong> invece di decidere su un confronto arbitrario: fai ripassare entrambi da una
        validazione della pipeline.
    </p>
    <p class="mb-0">
        <strong>Il ritiro si può annullare, ma non si annulla da solo.</strong> Un modello ritirato —
        a mano o dal monitor di drift — si riporta in <em>Staging</em> dal pulsante sulla sua riga:
        torna <em>eleggibile</em>, non torna Champion. Per riprendersi il posto deve ripassare da
        Challenger e ri-superare il gate DSR. Attenzione: il DSR di un modello ritirato è quello
        misurato <strong>prima</strong> del ritiro, e se il ritiro è venuto dal drift è esattamente la
        misura che il sistema ha dichiarato invecchiata — il motivo del ritiro resta scritto sulla riga
        apposta, per essere letto prima di rimetterlo in gioco.
        Torna a <a href="experiments">Esperimenti</a>.
    </p>
</GuidaPanel>

@if (_message is not null)
{
    <div class="alert @(_messageOk ? "alert-success" : "alert-warning") py-2">@_message</div>
}

@if (_groups.Count == 0)
{
    <div class="alert alert-info">Nessun modello salvato. Addestra un modello in <a href="ml">/ml</a>.</div>
}

@foreach (var g in _groups)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><strong>@g.Key.Symbol</strong> · @g.Key.Timeframe</span>
            @{ var champ = g.Value.FirstOrDefault(m => m.Stage == ModelStage.Champion); }
            <span class="small">
                @if (champ is not null)
                {
                    <span class="badge bg-success">Champion: @champ.Name (DSR @Fmt(champ.DeflatedSharpe))</span>
                }
                else
                {
                    <span class="badge bg-secondary">Nessun Champion attivo</span>
                }
            </span>
        </div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead><tr><th>Modello</th><th>Tipo</th><th>Stadio</th><th class="text-end">DSR</th><th>Misurato su</th><th class="text-end">Ver</th><th>Note</th><th class="text-end">Azioni</th></tr></thead>
                <tbody>
                    @foreach (var m in g.Value)
                    {
                        <tr class="@(m.Stage == ModelStage.Champion ? "table-success" : m.Stage == ModelStage.Retired ? "text-muted" : "")">
                            <td>@m.Name</td>
                            <td>@m.ModelType</td>
                            <td><span class="badge @StageClass(m.Stage)">@m.Stage</span></td>
                            <td class="text-end">@Fmt(m.DeflatedSharpe)</td>
                            @* [M2] La colonna DSR ha due scrittori con due metri diversi: senza la
                               provenienza accanto, due numeri incomparabili si leggono come una
                               classifica. Il gate di promozione ora rifiuta il confronto, ma chi
                               guarda la tabella deve poterlo vedere prima di premere il pulsante. *@
                            <td class="small">
                                @if (DsrProvenance(m) is { } prov)
                                {
                                    <span class="badge @prov.Css" title="@prov.Hint">@prov.Label</span>
                                }
                                else
                                {
                                    <span class="text-muted" title="Nessun esito di validazione registrato su questo modello. I run precedenti al 2026-08-20 non scrivevano la provenienza: il trattino qui significa «non so», non «non valutato».">—</span>
                                }
                            </td>
                            <td class="text-end">@m.Version</td>
                            <td class="small">
                                @* I tre campi del ritiro descrivono l'ULTIMO ritiro, lo stadio dice se è in corso:
                                   su una riga non-Retired vanno quindi dati come storia, non come stato attuale
                                   (regola 5, «mai mostrare un valore vecchio come se fosse attuale»). Prima qui si
                                   rendeva per sola nullità del campo, e un modello riportato in Staging avrebbe
                                   esibito «drift: 3 feature in alert» accanto a un badge vivo. *@
                                @if (m.RetiredReason is not null)
                                {
                                    @if (m.Stage == ModelStage.Retired)
                                    {
                                        <span>@m.RetiredReason</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic" title="Storia, non stato attuale: il modello oggi è @m.Stage.">
                                            già ritirato@(m.RetiredAtUtc is { } ra ? $" il {ra.ToLocalTime():dd/MM/yyyy}" : "") — @m.RetiredReason
                                        </span>
                                    }
                                }
                                @if (m.RetrainRequestedAtUtc is not null)
                                {
                                    <span class="badge bg-warning text-dark ms-1" title="Riaddestramento chiesto il @m.RetrainRequestedAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") e mai eseguito: la piattaforma non riaddestra da sola.">retrain accodato</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (m.Stage == ModelStage.Staging)
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ToChallenger(m.Id)" disabled="@_busy">→ Challenger</button>
                                }
                                @if (m.Stage is ModelStage.Staging or ModelStage.Challenger)
                                {
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => ToChampion(m.Id)" disabled="@_busy">→ Champion</button>
                                }
                                @* [2026-08-19] Conferma a DUE PASSI legata all'Id, come Trading.razor e Backup.razor.
                                   «Ritira» era l'unica azione distruttiva della pagina a un passo solo, e la tabella si
                                   riordina sotto il cursore (LoadAsync rimette i Retired in fondo): legare la domanda
                                   all'Id, e non alla posizione, è ciò che neutralizza la corsa. *@
                                @if (m.Stage != ModelStage.Retired && _confirmRetire != m.Id)
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => ArmRetire(m)" disabled="@_busy">Ritira</button>
                                }
                                @if (m.Stage == ModelStage.Retired && _confirmReinstate != m.Id)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ArmReinstate(m.Id)" disabled="@_busy">↩ Riporta in Staging</button>
                                }
                            </td>
                        </tr>

                        @if (_confirmRetire == m.Id)
                        {
                            <tr class="table-warning">
                                <td colspan="8">
                                    <div class="small mb-2">
                                        <strong>Ritirare «@m.Name»?</strong>
                                        @if (m.Stage == ModelStage.Champion)
                                        {
                                            <span> È il <strong>Champion</strong> di @m.Symbol @m.Timeframe: le corsie che lo montano come sentinella Champion restano <strong>senza modello</strong> finché non ne promuovi un altro.</span>
                                        }
                                        <span>
                                            Il ritiro <strong>non è definitivo ma non si annulla da solo</strong>: il modello si può riportare
                                            in Staging da qui, e per riprendersi il posto deve <strong>ri-superare il gate DSR</strong> contro
                                            il Champion che nel frattempo sarà in carica. Il motivo che scrivi qui è quello che leggerai
                                            se un giorno lo riporterai in gioco: scrivine uno utile.
                                        </span>
                                    </div>
                                    <div class="d-flex gap-2 align-items-center flex-wrap">
                                        <input class="form-control form-control-sm" style="max-width: 34rem;" maxlength="256"
                                               placeholder="Motivo del ritiro" @bind="_retireReason" @bind:event="oninput" disabled="@_busy" />
                                        <button class="btn btn-sm btn-danger" @onclick="() => Retire(m.Id)" disabled="@(_busy || string.IsNullOrWhiteSpace(_retireReason))">Sì, ritira</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmRetire = null" disabled="@_busy">Annulla</button>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (_confirmReinstate == m.Id)
                        {
                            <tr class="table-info">
                                <td colspan="8">
                                    <div class="small mb-2">
                                        <strong>Riportare «@m.Name» in Staging?</strong>
                                        <span>
                                            Era stato ritirato@(m.RetiredAtUtc is { } ra2 ? $" il {ra2.ToLocalTime():dd/MM/yyyy HH:mm}" : "") con questo motivo:
                                        </span>
                                        <div class="fst-italic my-1">«@(m.RetiredReason ?? "motivo non registrato")»</div>
                                        <span>
                                            Torna <strong>solo eleggibile</strong>, non Champion: dovrà ripassare da Challenger e ri-superare il
                                            gate DSR. Attenzione a due cose. Il DSR mostrato (@Fmt(m.DeflatedSharpe)) è quello misurato
                                            <strong>prima</strong> del ritiro — nessuno l'ha ricalcolato, e se il ritiro è venuto dal drift è
                                            proprio la misura che il sistema ha già dichiarato invecchiata. E se l'alert di drift persiste, il
                                            prossimo check può <strong>ri-ritirarlo</strong> appena torna Champion.
                                        </span>
                                    </div>
                                    <button class="btn btn-sm btn-primary" @onclick="() => Reinstate(m.Id)" disabled="@_busy">Sì, riporta in Staging</button>
                                    <button class="btn btn-sm btn-outline-secondary ms-1" @onclick="() => _confirmReinstate = null" disabled="@_busy">Annulla</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private readonly List<KeyValuePair<(string Symbol, string Timeframe), List<SavedMlModel>>> _groups = new();
    private bool _busy;
    private string? _message;
    private bool _messageOk;

    // Le conferme sono legate all'Id del modello, non a un booleano di pagina: due righe non possono
    // avere la domanda aperta insieme, e il riordino della tabella non sposta la domanda su un'altra riga.
    private int? _confirmRetire;
    private int? _confirmReinstate;
    private string _retireReason = DefaultRetireReason;

    private const string DefaultRetireReason = "Ritirato manualmente dalla UI.";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        // Ogni ricarica chiude le conferme aperte: la tabella si riordina (i Retired vanno in fondo),
        // e una domanda armata su dati vecchi punterebbe l'operatore su una riga che si è spostata.
        _confirmRetire = null;
        _confirmReinstate = null;
        _groups.Clear();
        await using var db = await DbFactory.CreateDbContextAsync();
        var models = await db.SavedMlModels.AsNoTracking()
            .OrderBy(m => m.Symbol).ThenBy(m => m.Timeframe)
            .ToListAsync();

        foreach (var grp in models.GroupBy(m => (m.Symbol, m.Timeframe)))
        {
            var ordered = grp
                .OrderByDescending(m => m.Stage == ModelStage.Champion)
                .ThenBy(m => m.Stage == ModelStage.Retired)
                .ThenByDescending(m => m.DeflatedSharpe)
                .ToList();
            _groups.Add(new(grp.Key, ordered));
        }
    }

    private async Task ToChallenger(int id)
    {
        _busy = true;
        // [2026-08-19] Diceva «Promosso a Challenger.» a prescindere, perché il registry no-oppava in
        // silenzio su ogni stadio diverso da Staging. Ora l'esito viene da sotto, come per le altre tre.
        try { var outcome = await Reg.PromoteToChallengerAsync(id); SetMsg(outcome.Reason, outcome.Changed); }
        catch (Exception ex) { SetMsg(ex.Message, false); }
        await LoadAsync();
        _busy = false;
    }

    private async Task ToChampion(int id)
    {
        _busy = true;
        try
        {
            var outcome = await Reg.TryPromoteToChampionAsync(id);
            SetMsg(outcome.Reason, outcome.Promoted);
        }
        catch (Exception ex) { SetMsg(ex.Message, false); }
        await LoadAsync();
        _busy = false;
    }

    private void ArmRetire(SavedMlModel m)
    {
        _confirmReinstate = null;
        _retireReason = DefaultRetireReason;
        _confirmRetire = m.Id;
    }

    private void ArmReinstate(int id)
    {
        _confirmRetire = null;
        _confirmReinstate = id;
    }

    private async Task Retire(int id)
    {
        _busy = true;
        var reason = string.IsNullOrWhiteSpace(_retireReason) ? DefaultRetireReason : _retireReason.Trim();
        try { var outcome = await Reg.RetireAsync(id, reason, requestRetrain: false); SetMsg(outcome.Reason, outcome.Changed); }
        catch (Exception ex) { SetMsg(ex.Message, false); }
        await LoadAsync();
        _busy = false;
    }

    private async Task Reinstate(int id)
    {
        _busy = true;
        try
        {
            // L'esito viene dal registry, non dal fatto che la chiamata sia tornata: il modello può
            // non essere più Retired (ciclo drift, altra scheda) e in quel caso il banner deve dire di no.
            var outcome = await Reg.ReinstateToStagingAsync(id);
            SetMsg(outcome.Reason, outcome.Changed);
        }
        catch (Exception ex) { SetMsg(ex.Message, false); }
        await LoadAsync();
        _busy = false;
    }

    private void SetMsg(string msg, bool ok) { _message = msg; _messageOk = ok; }

    private static string Fmt(double? dsr) => dsr is { } v ? (v * 100).ToString("F1") + "%" : "—";

    /// <summary>
    /// [M2] Con quale metro è stato misurato il DSR della riga: etichetta, spiegazione e colore.
    /// <c>null</c> quando non c'è nessun DSR. Il caso «metro ignoto» è quello delle righe scritte
    /// prima del 2026-08-20: non si sa con che N, quindi il numero non è confrontabile con nessun
    /// altro e il gate di promozione lo rifiuta invece di indovinare.
    /// </summary>
    private static (string Label, string Hint, string Css)? DsrProvenance(SavedMlModel m)
    {
        // [M2b] «Nessun numero» e «numero mai misurato» sono due fatti diversi. Un modello che la
        // pipeline ha validato e scartato prima del gate DSR lo dichiara: il trattino da solo si
        // leggeva come «non ancora valutato», e su 164 modelli su 164 era il contrario.
        if (m.DeflatedSharpeSource == SavedMlModel.DsrSourceNeverValidated)
        {
            return ("mai proposto",
                "Il modello è stato addestrato e salvato, ma la correlazione di test non ha superato la soglia "
                + "(minTestCorrelation): non è mai diventato un candidato, quindi non è mai entrato nella validazione "
                + "holdout e nessun giudizio esiste su di lui. Non è «in attesa di valutazione»: è «messo da parte prima di provarlo».",
                "bg-secondary");
        }
        if (m.DeflatedSharpeSource == SavedMlModel.DsrSourceRejectedBeforeGate)
        {
            return ("scartato prima del gate",
                "La pipeline ha validato questo modello sull'holdout e lo ha fermato PRIMA del gate DSR "
                + "(Sharpe holdout sotto soglia, o troppo pochi trade): un Deflated Sharpe non è mai stato "
                + "calcolato, e il campo resta vuoto di proposito. Non è «non ancora valutato»: è «valutato e bocciato».",
                "bg-danger");
        }
        if (m.DeflatedSharpe is null) return null;
        if (m.DeflatedSharpeTrials is not int n)
        {
            return ("metro ignoto",
                "Misurato prima che la provenienza venisse registrata: non si sa con quanti tentativi è stato "
                + "deflazionato, quindi non è confrontabile con altri DSR. Rifallo passare da una validazione della pipeline.",
                "bg-warning text-dark");
        }
        return m.DeflatedSharpeSource switch
        {
            SavedMlModel.DsrSourcePipeline => ($"pipeline · N={n}",
                "Gate anti-overfitting della pipeline sull'holdout, con slippage, commissioni e funding pieni, "
                + "deflazionato sui tentativi effettivi della ricerca.",
                "bg-success"),
            SavedMlModel.DsrSourceMlLab => ($"ml-lab · N={n}",
                "Pagina /ml: un solo track, quindi N = 1 e nessuna deflazione (di fatto un Probabilistic Sharpe), "
                + "su un backtest senza slippage né funding. Risulta sistematicamente più alto di un DSR della pipeline.",
                "bg-secondary"),
            _ => ($"{m.DeflatedSharpeSource ?? "?"} · N={n}", "Origine non riconosciuta.", "bg-secondary"),
        };
    }

    private static string StageClass(ModelStage s) => s switch
    {
        ModelStage.Champion => "bg-success",
        ModelStage.Challenger => "bg-primary",
        ModelStage.Staging => "bg-secondary",
        _ => "bg-light text-dark",
    };
}
