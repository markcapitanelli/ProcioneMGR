@page "/metrics"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.JSInterop
@using ProcioneMGR.Data
@using ProcioneMGR.Services.Observability
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.Manager)]
@implements IAsyncDisposable

@inject MetricsCollector Collector
@inject IJSRuntime JS
@inject ILogger<Metrics> Logger
@inject IConfiguration Configuration

<PageTitle>Metriche</PageTitle>

<h1>Osservabilità <span class="badge bg-secondary">metriche runtime</span></h1>

@* [2026-08-05, item F7] Questa pagina legge i contatori del processo in cui gira, cioè il GUSCIO.
   Con Trading:UseRemoteTrading=true il motore che apre e chiude posizioni vive in un ALTRO
   processo (il servizio in cluster) e i suoi contatori restano lì: qui si vedono zeri, per sempre.
   Uno zero indistinguibile da «non è successo niente» su una dashboard è esattamente il controllo
   che rassicura a torto — finché il collegamento non c'è, la pagina lo deve dire. *@
@if (RemoteTrading)
{
    <div class="alert alert-warning d-flex align-items-start gap-2">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div>
            <strong>I contatori del trading NON sono su questa pagina.</strong>
            Il motore che apre e chiude le posizioni gira in un <strong>altro processo</strong>
            (<code>Trading:UseRemoteTrading</code> è attivo, host <code>@RemoteHost</code>): i suoi
            contatori vivono lì. Qui vedi quelli del guscio, e per trade, job di esecuzione e
            promozioni di corsia resteranno <strong>a zero comunque</strong> — non perché non stia
            succedendo nulla, ma perché sta succedendo altrove. Per lo stato vero del motore usa
            <a href="/trading">Trading</a>. Il collegamento di questa pagina al motore remoto è
            l'item F7 della roadmap.
        </div>
    </div>
}

<GuidaPanel Title="Metriche — cosa sta facendo la piattaforma, in numeri">
    <p>
        Questa dashboard legge i contatori interni emessi dal motore (<code>ProcioneMetrics</code>)
        e li mostra dal vivo — <strong>senza</strong> alcun servizio esterno. I totali sono
        <em>dalla partenza del processo</em>: si azzerano a ogni riavvio dell'applicazione. Se un
        numero è a zero, quell'evento non è ancora avvenuto in questa sessione (es. nessun trade
        eseguito, nessun job di esecuzione a fette, nessuna promozione di corsia).
    </p>
    <dl class="row mb-0">
        <dt class="col-sm-3">Trade eseguiti</dt>
        <dd class="col-sm-9">Aperture e chiusure di posizione dal motore (per lato Buy/Sell e azione Open/Close).</dd>
        <dt class="col-sm-3">Job di esecuzione</dt>
        <dd class="col-sm-9">Piani di esecuzione a fette (TWAP/VWAP/Iceberg) per esito: avviati, completati, falliti, annullati.</dd>
        <dt class="col-sm-3">Costo assunto vs pagato</dt>
        <dd class="col-sm-9">
            Il confronto fra lo slippage che la <em>selezione</em> assume e quello effettivamente
            pagato sugli ordini di corsia (Testnet/Live). È la verifica del modello di costo: se il
            pagato supera stabilmente l'assunto, le strategie promosse sono state scelte con un
            vantaggio che non esiste.
        </dd>
        <dt class="col-sm-3">Latenza ordini</dt>
        <dd class="col-sm-9">Millisecondi fra invio e risposta dell'exchange, ai percentili (P50/P95/P99).</dd>
        <dt class="col-sm-3">Slippage</dt>
        <dd class="col-sm-9">Implementation shortfall (bps) dei job completati: quanto il prezzo medio realizzato si è discostato dal prezzo di arrivo.</dd>
        <dt class="col-sm-3">Promozioni / Drift / Ritiri / Pipeline</dt>
        <dd class="col-sm-9">Eventi del ciclo autonomo: promozioni/retrocessioni di corsia, feature in drift, modelli ritirati dal registry, run di pipeline.</dd>
    </dl>
</GuidaPanel>

<div class="mb-3 d-flex align-items-center gap-2">
    <button class="btn btn-outline-secondary btn-sm" @onclick="Refresh">🔄 Aggiorna</button>
    <span class="text-muted small">Aggiornamento automatico ogni 5s · ultimo: @_lastRefresh.ToLocalTime().ToString("HH:mm:ss")</span>
</div>

<div class="row g-3 mb-3">
    <div class="col-auto">@Tile("Trade eseguiti", _s.Total("procione.trades.executed").ToString("N0"), "bi-arrow-left-right")</div>
    <div class="col-auto">@Tile("Job esecuzione", _s.Total("procione.execution.jobs").ToString("N0"), "bi-list-check")</div>
    <div class="col-auto">@Tile("Promozioni corsia", _s.Total("procione.lane.promotions").ToString("N0"), "bi-arrow-up-circle")</div>
    <div class="col-auto">@Tile("Feature in drift", _s.Total("procione.drift.alerts").ToString("N0"), "bi-exclamation-triangle")</div>
    <div class="col-auto">@Tile("Modelli ritirati", _s.Total("procione.models.retired").ToString("N0"), "bi-trash")</div>
    <div class="col-auto">@Tile("Run pipeline", _s.Total("procione.pipeline.runs").ToString("N0"), "bi-diagram-3")</div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Trade per azione e lato</div>
            <div class="card-body">
                @if (_s.Total("procione.trades.executed") == 0)
                {
                    <div class="text-muted">Nessun trade eseguito in questa sessione.</div>
                }
                else
                {
                    <div id="m_trades" style="width:100%;"></div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">Job di esecuzione per esito</div>
            <div class="card-body">
                @if (_s.Total("procione.execution.jobs") == 0)
                {
                    <div class="text-muted">Nessun job di esecuzione a fette in questa sessione.</div>
                }
                else
                {
                    <div id="m_jobs" style="width:100%;"></div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mt-3 border-primary">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><strong>Costo di esecuzione: assunto vs pagato</strong></span>
        <span class="small text-muted">ordini di corsia · @_shortfall.Count misurati</span>
    </div>
    <div class="card-body">
        @if (_shortfall.Count == 0)
        {
            <div class="text-muted">
                Nessun ordine misurabile in questa sessione. La misura esiste solo su
                <strong>Testnet/Live</strong>: in Paper il prezzo eseguito coincide per costruzione con
                quello di riferimento, quindi uno shortfall Paper sarebbe zero per definizione.
            </div>
        }
        else
        {
            <div class="row g-3 align-items-end">
                <div class="col-auto">
                    <div class="text-muted small">Assunto in selezione</div>
                    <div class="h4 mb-0 font-monospace">@ModeledBps.ToString("F1") bps</div>
                </div>
                <div class="col-auto">
                    <div class="text-muted small">Pagato (mediana)</div>
                    <div class="h4 mb-0 font-monospace">@_shortfall.P50.ToString("F1") bps</div>
                </div>
                <div class="col-auto">
                    <div class="text-muted small">Pagato (media)</div>
                    <div class="h4 mb-0 font-monospace">@_shortfall.Mean.ToString("F1") bps</div>
                </div>
                <div class="col-auto">
                    <div class="text-muted small">Coda (P95 / P99)</div>
                    <div class="h4 mb-0 font-monospace">@_shortfall.P95.ToString("F1") / @_shortfall.P99.ToString("F1")</div>
                </div>
                <div class="col-auto">
                    <span class="badge @CostVerdictClass">@CostVerdict</span>
                </div>
            </div>
            <div class="small text-muted mt-2">
                Positivo = costo. Il confronto è con
                <code>PipelineCosts.DefaultSlippagePercent</code> (@ModeledBps.ToString("F1") bps per fill),
                cioè il costo che la <em>selezione</em> assume quando decide se una strategia è
                profittevole: se il pagato è sistematicamente maggiore, le strategie promosse sono
                state scelte con un vantaggio che non esiste.
            </div>
        }
    </div>
</div>

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Latenza degli ordini (ms)</span>
        @if (_latency.Count > 0)
        {
            <span class="small text-muted">
                n=@_latency.Count · P50 @_latency.P50.ToString("F0") · P95 @_latency.P95.ToString("F0") · P99 @_latency.P99.ToString("F0") · max @_latency.Max.ToString("F0")
            </span>
        }
    </div>
    <div class="card-body">
        @if (_latency.Count == 0)
        {
            <div class="text-muted">Nessun ordine inviato a un exchange in questa sessione.</div>
        }
        else
        {
            <div id="m_lat" style="width:100%;"></div>
            <div class="small text-muted mt-2">
                Misura invio→risposta, inclusa l'attesa del rate-limiter interno: è il ritardo che la
                strategia subisce davvero. Va letta ai <strong>percentili alti</strong> — è sulla coda,
                non sulla media, che un ritardo costa un fill. I percentili sono calcolati sugli ultimi
                campioni della sessione, non su tutta la sua storia.
            </div>
        }
    </div>
</div>

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Slippage dei job completati (bps)</span>
        @if (_s.SlippageCount > 0)
        {
            <span class="small text-muted">
                n=@_s.SlippageCount · media @_s.SlippageMean.ToString("F1") · min @_s.SlippageMin.ToString("F1") · max @_s.SlippageMax.ToString("F1")
            </span>
        }
    </div>
    <div class="card-body">
        @if (_s.SlippageCount == 0)
        {
            <div class="text-muted">Nessun job completato con slippage misurato in questa sessione.</div>
        }
        else
        {
            <div id="m_slip" style="width:100%;"></div>
        }
    </div>
</div>

@* [I5] Tutto il resto di ciò che il collettore ha raccolto.

   Le card qui sopra sono scritte a mano, una per misura, e questo va bene per le misure che
   meritano un grafico. Ma finché ESISTEVANO SOLO QUELLE, uno strumento nuovo non compariva da
   nessuna parte: il collettore lo scartava (lista di tre nomi cablata) e la pagina non lo avrebbe
   comunque mostrato. Chi aggiungeva una misura non aveva modo di accorgersi che non arrivava —
   una pagina che tace su ciò che non conosce.

   Questa card chiude il giro: elenca ogni strumento raccolto che nessuna card dedicata già mostra.
   Non è bella, è ONESTA — e il gate di I5 («un istogramma nuovo compare in pagina senza modificare
   alcuna lista») senza di essa era soddisfatto nel collettore e falso nel prodotto. Trovato al
   livello 4 il 2026-08-19, non dai test. *@
<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Altre misure raccolte</span>
        <span class="small text-muted">@OtherHistograms.Count istogrammi · @OtherCounters.Count contatori</span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Ogni strumento del meter di piattaforma che non ha una card sua qui sopra. Compare da
            solo: nessuna lista da aggiornare quando se ne aggiunge uno.
        </p>
        @if (OtherHistograms.Count == 0 && OtherCounters.Count == 0)
        {
            <div class="text-muted">Nessuna altra misura registrata in questa sessione.</div>
        }
        else
        {
            @if (OtherHistograms.Count > 0)
            {
                <h6 class="small text-uppercase text-muted">Istogrammi</h6>
                <div class="table-responsive mb-3">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Strumento</th><th class="text-end">n</th><th class="text-end">media</th><th class="text-end">p50</th><th class="text-end">p95</th><th class="text-end">max</th></tr></thead>
                        <tbody>
                            @foreach (var (name, h) in OtherHistograms)
                            {
                                <tr>
                                    <td><code>@name</code></td>
                                    <td class="text-end">@h.Count</td>
                                    <td class="text-end">@h.Mean.ToString("F1")</td>
                                    <td class="text-end">@h.P50.ToString("F1")</td>
                                    <td class="text-end">@h.P95.ToString("F1")</td>
                                    <td class="text-end">@h.Max.ToString("F1")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (OtherCounters.Count > 0)
            {
                <h6 class="small text-uppercase text-muted">Contatori</h6>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Strumento</th><th class="text-end">totale</th></tr></thead>
                        <tbody>
                            @foreach (var (key, value) in OtherCounters)
                            {
                                <tr><td><code>@key</code></td><td class="text-end">@value</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@code {
    /// <summary>Istogrammi che hanno già una card dedicata qui sopra: non si ripetono in fondo.</summary>
    private static readonly HashSet<string> DedicatedHistograms =
    [
        MetricsCollector.TradingSlippageInstrument,
        MetricsCollector.OrderLatencyInstrument,
        MetricsCollector.ExecutionSlippageInstrument,
    ];

    /// <summary>
    /// [I5] Gli istogrammi raccolti che nessuna card mostra. Si includono anche quelli a zero
    /// misure: «lo strumento esiste e non ha ancora registrato nulla» e «lo strumento non esiste»
    /// sono cose diverse, e questa pagina serve proprio a distinguerle.
    /// </summary>
    private IReadOnlyList<(string Name, HistogramSummary Summary)> OtherHistograms =>
        _s.Histograms.Where(kv => !DedicatedHistograms.Contains(kv.Key))
            .OrderBy(kv => kv.Key, StringComparer.Ordinal)
            .Select(kv => (kv.Key, kv.Value))
            .ToList();

    /// <summary>I contatori raccolti, con i loro tag. Le card in cima ne mostrano solo alcuni aggregati.</summary>
    private IReadOnlyList<(string Key, long Value)> OtherCounters =>
        _s.Counters.OrderBy(kv => kv.Key, StringComparer.Ordinal)
            .Select(kv => (kv.Key, kv.Value))
            .ToList();

    /// <summary>
    /// [F7] Vero quando il motore di trading vive in un ALTRO processo: allora i contatori di
    /// trade/job/promozioni di questa pagina restano a zero per costruzione, e la pagina lo
    /// dichiara invece di lasciar credere che non stia succedendo nulla.
    /// </summary>
    private bool RemoteTrading => Configuration.GetValue("Trading:UseRemoteTrading", false);

    private string RemoteHost => Configuration["Trading:RemoteUrl"] is { Length: > 0 } url
        ? url
        : "non dichiarato";

    private MetricsSnapshot _s = default!;
    private DateTime _lastRefresh = DateTime.UtcNow;
    private PollingTimer? _timer;

    private IJSObjectReference? _charts;
    private bool _renderPending;

    private HistogramSummary _shortfall = HistogramSummary.Empty;
    private HistogramSummary _latency = HistogramSummary.Empty;

    /// <summary>Lo slippage che la selezione assume, in bps: 0,05% per fill ⇒ 5 bps.</summary>
    private static double ModeledBps => (double)ProcioneMGR.Services.Pipeline.PipelineCosts.DefaultSlippagePercent * 100d;

    /// <summary>
    /// Verdetto sul modello di costo. La soglia non è simmetrica di proposito: un costo reale
    /// MINORE dell'assunto è una buona notizia (la selezione è stata prudente), uno maggiore
    /// invalida le decisioni prese — quindi solo il secondo caso merita un allarme.
    /// </summary>
    private string CostVerdict => _shortfall.P50 > ModeledBps * 1.5
        ? "il modello sottostima il costo"
        : _shortfall.P50 < ModeledBps * 0.5 ? "modello prudente" : "modello coerente";

    private string CostVerdictClass => _shortfall.P50 > ModeledBps * 1.5
        ? "bg-danger"
        : _shortfall.P50 < ModeledBps * 0.5 ? "bg-info" : "bg-success";

    protected override void OnInitialized()
    {
        Refresh();
        _timer = new PollingTimer(TimeSpan.FromSeconds(5), () => InvokeAsync(Refresh), Logger);
    }

    private void Refresh()
    {
        _s = Collector.Snapshot();
        _shortfall = _s.Histogram(MetricsCollector.TradingSlippageInstrument);
        _latency = _s.Histogram(MetricsCollector.OrderLatencyInstrument);
        _lastRefresh = DateTime.UtcNow;
        _renderPending = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _renderPending = true;
        if (!_renderPending) return;
        _renderPending = false;
        await RenderChartsAsync();
    }

    private async Task RenderChartsAsync()
    {
        _charts ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");

        if (_s.Total("procione.trades.executed") > 0)
        {
            var byAction = _s.GroupByTag("procione.trades.executed", "action");
            var bySide = _s.GroupByTag("procione.trades.executed", "side");
            var labels = byAction.Select(x => "Azione: " + x.Value).Concat(bySide.Select(x => "Lato: " + x.Value)).ToArray();
            var values = byAction.Select(x => x.Count).Concat(bySide.Select(x => x.Count)).ToArray();
            await _charts.InvokeVoidAsync("bar", "m_trades", labels, values, "trade", (object?)null);
        }

        if (_s.Total("procione.execution.jobs") > 0)
        {
            var byStatus = _s.GroupByTag("procione.execution.jobs", "status");
            var colors = byStatus.Select(x => x.Value switch
            {
                "Completed" => "#1a9850",
                "Failed" => "#d73027",
                "Cancelled" => "#8c8c8c",
                "Started" => "#2962FF",
                _ => "#fdae61",
            }).ToArray();
            await _charts.InvokeVoidAsync("bar", "m_jobs",
                byStatus.Select(x => x.Value).ToArray(), byStatus.Select(x => x.Count).ToArray(), "job", colors);
        }

        if (_s.SlippageCount > 0)
        {
            var xs = _s.SlippageRecent.Select(p => new DateTimeOffset(DateTime.SpecifyKind(p.T, DateTimeKind.Utc)).ToUnixTimeSeconds()).ToArray();
            var ys = _s.SlippageRecent.Select(p => p.V).ToArray();
            var trace = new { name = "Slippage bps", x = xs, y = ys, color = "#FB8C00" };
            await _charts.InvokeVoidAsync("timeseries", "m_slip", new[] { trace }, "bps");
        }

        if (_latency.Count > 0)
        {
            var xs = _latency.Recent.Select(p => new DateTimeOffset(DateTime.SpecifyKind(p.T, DateTimeKind.Utc)).ToUnixTimeSeconds()).ToArray();
            var ys = _latency.Recent.Select(p => p.V).ToArray();
            var trace = new { name = "Latenza ms", x = xs, y = ys, color = "#2962FF" };
            await _charts.InvokeVoidAsync("timeseries", "m_lat", new[] { trace }, "ms");
        }
    }

    private static RenderFragment Tile(string label, string value, string icon) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "card text-center");
        builder.AddAttribute(2, "style", "min-width: 9rem;");
        builder.OpenElement(3, "div");
        builder.AddAttribute(4, "class", "card-body py-2");
        builder.OpenElement(5, "div");
        builder.AddAttribute(6, "class", "h4 mb-0");
        builder.AddContent(7, value);
        builder.CloseElement();
        builder.OpenElement(8, "div");
        builder.AddAttribute(9, "class", "text-muted small");
        builder.AddMarkupContent(10, $"<i class=\"bi {icon}\"></i> ");
        builder.AddContent(11, label);
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };

    public async ValueTask DisposeAsync()
    {
        if (_timer is not null) await _timer.DisposeAsync();
        try
        {
            if (_charts is not null)
            {
                await _charts.InvokeVoidAsync("dispose", "m_trades");
                await _charts.InvokeVoidAsync("dispose", "m_jobs");
                await _charts.InvokeVoidAsync("dispose", "m_slip");
                await _charts.InvokeVoidAsync("dispose", "m_lat");
                await _charts.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
    }
}
