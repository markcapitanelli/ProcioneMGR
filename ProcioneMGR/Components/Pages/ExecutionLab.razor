@page "/execution"
@rendermode InteractiveServer
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using ProcioneMGR.Data
@using ProcioneMGR.Services.Config
@using ProcioneMGR.Services.Execution
@using ProcioneMGR.Services.Experiments
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.Manager)]

@inject IExecutionAlgorithmFactory AlgoFactory
@inject IExecutionSimulator Simulator
@inject IOptionsMonitor<ExecutionParameters> ExecParamsMonitor
@inject IAppConfigWriter ConfigWriter
@inject IExperimentTracker Tracker
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Execution Lab</PageTitle>

<h1>Execution Lab</h1>

<GuidaPanel Title="Execution Lab — quanto costa DAVVERO eseguire un ordine">
    <p>
        Su size significative, distribuire un ordine nel tempo (<strong>TWAP</strong>,
        <strong>VWAP</strong>, <strong>Iceberg</strong>) riduce l'impatto di mercato rispetto a
        prenderlo tutto subito. Qui si <strong>misura</strong> quella differenza sulle candele fini
        recenti, invece di assumerla (rif. <code>docs/archive/ROADMAP-QLIB.md §1.2</code>).
    </p>
    <p>
        <strong>Non è più solo un laboratorio.</strong> L'esecuzione a fette è in produzione: le
        <em>aperture</em> di corsia in Testnet/Live possono passare da un piano a fette invece che
        da un ordine unico, si sceglie in <a href="trading">Trading</a> e l'avanzamento delle fette
        lo gestisce un worker dedicato. Due limiti dichiarati: le chiusure restano immediate (una
        protezione non si rateizza), e con gli stop appoggiati sull'exchange il piano viene saltato,
        perché l'exchange armerebbe solo la frazione già eseguita. Il costo davvero pagato si legge
        in <a href="metrics">Metriche</a>, alla riga «costo assunto vs pagato».
    </p>
    <p class="mb-0">
        Il modello di impatto è semplificato (lineare nella quota di volume assorbita) e va calibrato
        in Paper: i valori assoluti sono indicativi, il <em>confronto relativo</em> fra algoritmi è il
        punto. Ogni confronto viene registrato negli <a href="experiments">Esperimenti</a>.
    </p>
</GuidaPanel>

<div class="card mb-3">
    <div class="card-body">
        <ConfigPresets @ref="_presets" PageKey="execution" UserId="@_userId" Disabled="_busy"
                       ShowUi="false" Capture="CaptureConfigJson" Apply="ApplyConfigJson" />
        <div class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label mb-0">Symbol</label>
                <input class="form-control form-control-sm" @bind="_symbol" style="max-width: 140px;" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-0">Timeframe esecuzione</label>
                <select class="form-select form-select-sm" @bind="_timeframe" style="max-width: 100px;">
                    <option value="5m">5m</option>
                    <option value="15m">15m</option>
                    <option value="1h">1h</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-0">Lato</label>
                <select class="form-select form-select-sm" @bind="_side" style="max-width: 100px;">
                    <option value="Buy">Buy</option>
                    <option value="Sell">Sell</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-0">Quantità</label>
                <input type="number" step="any" class="form-control form-control-sm" @bind="_quantity" style="max-width: 120px;" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-0">Candele finestra</label>
                <input type="number" class="form-control form-control-sm" @bind="_windowCandles" style="max-width: 110px;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-primary" @onclick="CompareAsync" disabled="@_busy">
                    @(_busy ? "Confronto…" : "Confronta algoritmi")
                </button>
            </div>
        </div>

        @* Il modello di costo era l'unica cosa NON toccabile di questa pagina: i valori venivano
           dalla sezione "Execution" di appsettings, e senza pannello l'unico modo di calibrarli era
           l'editor di testo. Sono i parametri che decidono l'esito del confronto, quindi vivono qui,
           accanto al confronto, invece che in una pagina di amministrazione. *@
        <div class="mt-3">
            <AdvancedPanel Title="Modello di costo (impatto e spread)"
                           Summary="@($"{_execParams.ImpactModel} · impatto {_execParams.ImpactCoefficient:0.###} · mezzo spread {_execParams.HalfSpreadPct:P3} · max {_execParams.MaxSlices} fette")">
                <p class="text-muted small">
                    Sono i parametri con cui il simulatore trasforma un piano in un costo. Il modello
                    <strong>√partecipazione</strong> è la legge empirica di Almgren: raddoppiare la
                    quantità non raddoppia l'impatto. Vanno <strong>calibrati in Paper</strong>: i
                    valori assoluti restano indicativi, il confronto <em>relativo</em> fra algoritmi è
                    il punto. Il salvataggio vale entro ~1 secondo, anche per i confronti già aperti.
                </p>
                <div class="row g-2 align-items-end">
                    <div class="col-auto">
                        <label class="form-label mb-0">Forma dell'impatto</label>
                        <select class="form-select form-select-sm" @bind="_execParams.ImpactModel" style="width: 11rem;">
                            <option value="@MarketImpactModel.SquareRoot">√ partecipazione</option>
                            <option value="@MarketImpactModel.Linear">Lineare</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-0">Coefficiente d'impatto</label>
                        <input type="number" step="0.01" class="form-control form-control-sm" @bind="_execParams.ImpactCoefficient" style="width: 9rem;" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-0">Tetto impatto per fetta</label>
                        <input type="number" step="0.01" class="form-control form-control-sm" @bind="_execParams.MaxImpactPct" style="width: 9rem;" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-0">Mezzo spread (frazione)</label>
                        <input type="number" step="0.0001" class="form-control form-control-sm" @bind="_execParams.HalfSpreadPct" style="width: 9rem;" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-0">Fette massime</label>
                        <input type="number" class="form-control form-control-sm" @bind="_execParams.MaxSlices" min="1" style="width: 7rem;" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-0">Clip Iceberg (frazione)</label>
                        <input type="number" step="0.05" class="form-control form-control-sm" @bind="_execParams.IcebergClipFraction" style="width: 9rem;" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-0" title="Denominatore dell'urgenza di Adaptive: σ realizzata / riferimento.">Volatilità di riferimento</label>
                        <input type="number" step="0.001" class="form-control form-control-sm" @bind="_execParams.ReferenceVolatility" style="width: 9rem;" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-0">Decadimento base (Adaptive)</label>
                        <input type="number" step="0.01" class="form-control form-control-sm" @bind="_execParams.DecayBaseRate" style="width: 9rem;" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="SaveExecParamsAsync" disabled="@_busy">Salva modello</button>
                        <button class="btn btn-sm btn-link" @onclick="ReloadExecParams" disabled="@_busy">Annulla modifiche</button>
                    </div>
                </div>
            </AdvancedPanel>
        </div>

        @if (!string.IsNullOrEmpty(_msg))
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-info") py-2 mt-3 mb-0">@_msg</div>
        }
    </div>
</div>

@if (_results.Count > 0)
{
    <div class="card">
        <div class="card-header">
            Confronto su @_symbol · @_timeframe — quantità @_quantity (@_side), arrivo @_arrival.ToString("0.####")
        </div>
        <div class="table-responsive">
            <table class="table table-sm mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Algoritmo</th>
                        <th class="text-end">Ordini figli</th>
                        <th class="text-end">Prezzo medio</th>
                        <th class="text-end">Shortfall (bps)</th>
                        <th class="text-end">vs Immediate</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var immediateBps = _results.FirstOrDefault(r => r.Algorithm == "Immediate")?.SlippageBps ?? 0m;
                        var best = _results.Min(r => r.SlippageBps);
                    }
                    @foreach (var r in _results.OrderBy(r => r.SlippageBps))
                    {
                        var delta = r.SlippageBps - immediateBps;
                        <tr class="@(r.SlippageBps == best ? "table-success" : "")">
                            <td>@r.Algorithm @(r.SlippageBps == best ? "🏆" : "")</td>
                            <td class="text-end">@r.Fills.Count</td>
                            <td class="text-end">@r.AverageFillPrice.ToString("0.####")</td>
                            <td class="text-end">@r.SlippageBps.ToString("F1")</td>
                            <td class="text-end @(delta < 0 ? "text-success" : delta > 0 ? "text-danger" : "")">
                                @(r.Algorithm == "Immediate" ? "—" : (delta <= 0 ? "" : "+") + delta.ToString("F1"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private string _symbol = "BTC/USDT"; // Convenzione piattaforma: con slash, come Backtest/ML Lab.
    private string _timeframe = "5m";
    private string _side = "Buy";
    private decimal _quantity = 100m;
    private int _windowCandles = 48;

    private decimal _arrival;
    private List<ExecutionResult> _results = new();
    private bool _busy;
    private bool _isError;
    private string? _msg;

    private string? _userId;
    private ConfigPresets? _presets;

    /// <summary>
    /// Copia di lavoro del modello di costo: si parte dal monitor e si scrive solo al Salva, così i
    /// campi non saltano sotto le dita quando il file appena scritto viene ricaricato.
    /// </summary>
    private ExecutionParameters _execParams = new();

    /// <summary>Memoria dell'ultima configurazione usata (modalità silenziosa: form minimo).</summary>
    private sealed record PageConfig(string Symbol, string Timeframe, string Side, decimal Quantity, int WindowCandles);

    private string CaptureConfigJson() => JsonSerializer.Serialize(new PageConfig(
        _symbol.Trim(), _timeframe, _side, _quantity, _windowCandles));

    private void ApplyConfigJson(string json)
    {
        PageConfig? cfg;
        try { cfg = JsonSerializer.Deserialize<PageConfig>(json); }
        catch (JsonException) { return; }
        if (cfg is null) return;
        if (!string.IsNullOrWhiteSpace(cfg.Symbol)) _symbol = cfg.Symbol;
        if (cfg.Timeframe is "5m" or "15m" or "1h") _timeframe = cfg.Timeframe;
        if (cfg.Side is "Buy" or "Sell") _side = cfg.Side;
        if (cfg.Quantity > 0m) _quantity = cfg.Quantity;
        _windowCandles = Math.Clamp(cfg.WindowCandles, 2, 2000);
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        ReloadExecParams();
    }

    private void ReloadExecParams()
    {
        var live = ExecParamsMonitor.CurrentValue;
        _execParams = JsonSerializer.Deserialize<ExecutionParameters>(JsonSerializer.Serialize(live))!;
    }

    private async Task SaveExecParamsAsync()
    {
        _busy = true; _msg = null; _isError = false;
        try
        {
            var error = AdminConfigRules.Validate(_execParams);
            if (error is not null) { _msg = error; _isError = true; return; }

            await ConfigWriter.SaveSectionAsync("Execution", _execParams);
            _msg = "Modello di costo salvato: vale entro ~1 secondo, rilancia il confronto per vederne l'effetto.";
        }
        catch (Exception ex) { _msg = $"Salvataggio fallito: {ex.Message}"; _isError = true; }
        finally { _busy = false; }
    }

    private async Task CompareAsync()
    {
        if (_busy) return;

        // Memoria dell'ultima configurazione usata (best-effort, mai bloccante).
        if (_presets is not null) await _presets.SaveLastUsedAsync();

        _busy = true; _msg = null; _isError = false; _results = new();
        try
        {
            if (_quantity <= 0m) { _msg = "La quantità deve essere positiva."; _isError = true; return; }
            var window = Math.Clamp(_windowCandles, 2, 2000);

            List<OhlcvData> candles;
            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                candles = await db.OhlcvData.AsNoTracking()
                    .Where(c => c.Symbol == _symbol.Trim() && c.Timeframe == _timeframe)
                    .OrderByDescending(c => c.TimestampUtc)
                    .Take(window)
                    .ToListAsync();
            }
            candles.Reverse();

            if (candles.Count < 2)
            {
                _msg = $"Candele insufficienti per {_symbol} {_timeframe}: fai prima un Fetch/Sync di questi dati.";
                _isError = true;
                return;
            }

            _arrival = candles[0].Open > 0m ? candles[0].Open : candles[0].Close;
            var side = _side == "Sell" ? ExecutionSide.Sell : ExecutionSide.Buy;
            var intent = new ExecutionIntent(_symbol.Trim(), side, _quantity, _arrival);

            // I parametri del confronto sono quelli VIVI del monitor, non la copia di lavoro del
            // form: così un valore digitato ma non salvato non falsa un risultato che finisce negli
            // Esperimenti — lì dentro deve esserci ciò che la piattaforma userebbe davvero.
            var execParams = ExecParamsMonitor.CurrentValue;
            foreach (var algo in AlgoFactory.All)
            {
                var plan = algo.BuildPlan(intent, candles, execParams);
                _results.Add(Simulator.Simulate(plan, intent, candles, execParams));
            }

            var runId = await Tracker.SafeStartRunAsync(
                "Execution",
                $"{_side} {_quantity} {_symbol.Trim()} · {_timeframe}",
                new { _symbol, _timeframe, _side, _quantity, Window = candles.Count, Arrival = _arrival },
                _symbol.Trim(), _timeframe);
            await Tracker.SafeLogMetricsAsync(runId,
                _results.ToDictionary(r => $"{r.Algorithm}_bps", r => r.SlippageBps));
            await Tracker.SafeCompleteAsync(runId, "Completed");

            var best = _results.OrderBy(r => r.SlippageBps).First();
            _msg = $"Confronto su {candles.Count} candele: migliore = {best.Algorithm} ({best.SlippageBps:F1} bps).";
        }
        catch (Exception ex) { _msg = $"Errore: {ex.Message}"; _isError = true; }
        finally { _busy = false; }
    }
}
