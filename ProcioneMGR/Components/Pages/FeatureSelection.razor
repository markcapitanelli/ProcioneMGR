@page "/feature-selection"
@rendermode InteractiveServer
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using ProcioneMGR.Data
@using ProcioneMGR.Services.Alpha
@using ProcioneMGR.Services.Alpha.Alpha158
@using ProcioneMGR.Services.Exchanges
@using ProcioneMGR.Services.Indicators
@using ProcioneMGR.Services.Microstructure
@using ProcioneMGR.Services.ML
@attribute [Authorize(Roles = AppRoles.Admin + "," + AppRoles.Manager)]
@implements IAsyncDisposable

@inject IIcFeatureSelector Selector
@inject IFactorDriftAnalyzer DriftAnalyzer
@inject IFactorIcHistoryStore IcHistory
@inject IConfiguration Config
@inject IAlphaFactorFactory Factory
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Selezione feature (IC)</PageTitle>

<h1>Selezione feature <span class="badge bg-secondary">Information Coefficient</span></h1>

<GuidaPanel Title="Feature selection — quali fattori valgono davvero">
    <p>
        Prima di addestrare un modello ML conviene sapere <em>quali</em> fattori (indicatori) hanno un
        legame con i rendimenti futuri e quali sono solo rumore. L'<strong>Information Coefficient (IC)</strong>
        è la correlazione (di Spearman) fra il valore del fattore oggi e il rendimento nei periodi
        successivi (orizzonte forward): più è alto in valore assoluto, più il fattore "informa".
        Il segno non conta (un segnale vale sia positivo che negativo), per questo si ordina per <strong>|IC|</strong>.
    </p>
    <dl class="row mb-0">
        <dt class="col-sm-3">IC / |IC|</dt>
        <dd class="col-sm-9">Correlazione fattore→rendimento forward. |IC| è il criterio di ordinamento.</dd>
        <dt class="col-sm-3">Information Ratio</dt>
        <dd class="col-sm-9">Stabilità dell'IC nel tempo (IC medio ÷ deviazione standard su finestre mobili): un IC alto ma instabile vale meno di uno più basso ma costante.</dd>
        <dt class="col-sm-3">Consistenza segno</dt>
        <dd class="col-sm-9">Quota di finestre in cui l'IC ha lo STESSO segno del full-sample: ≥ 0.5 = segno affidabile.</dd>
        <dt class="col-sm-3">Filtri</dt>
        <dd class="col-sm-9">|IC| minimo, IR minimo e "solo segno consistente" scartano i fattori-rumore; i sopravvissuti (fino a Top N) sono quelli da passare a un modello ML.</dd>
        <dt class="col-sm-3">Filtro incrementale</dt>
        <dd class="col-sm-9">Opzionale: molti fattori con |IC| alto dicono la <em>stessa</em> cosa. Il filtro li passa in ordine di |IC| e tiene solo chi <strong>aggiunge</strong> informazione oltre ai già tenuti (IC parziale, con soglia di rumore e nullo per permutazione).</dd>
    </dl>
</GuidaPanel>

<div class="card mb-3">
    <div class="card-header">Configurazione</div>
    <div class="card-body">
        <ConfigPresets @ref="_presets" PageKey="feature-selection" UserId="@_userId" Disabled="_busy"
                       Capture="CaptureConfigJson" Apply="ApplyConfigJson" />
        <div class="row g-3 align-items-end">
            <div class="col-auto">
                <label class="form-label">Exchange</label>
                <select class="form-select" @bind="_exchange" disabled="@_busy">
                    @foreach (var ex in Enum.GetValues<ExchangeName>()) { <option value="@ex">@ex</option> }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Symbol</label>
                <input class="form-control" list="fs_symbols" @bind="_symbol" style="width: 10rem;" disabled="@_busy" />
                <datalist id="fs_symbols">@foreach (var s in _knownSymbols) { <option value="@s"></option> }</datalist>
            </div>
            <div class="col-auto">
                <label class="form-label">Timeframe</label>
                <select class="form-select" @bind="_timeframe" disabled="@_busy">
                    @foreach (var tf in Timeframes.Supported.Keys) { <option value="@tf">@tf</option> }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Da</label>
                <input type="date" class="form-control" @bind="_from" disabled="@_busy" />
            </div>
            <div class="col-auto">
                <label class="form-label">A</label>
                <input type="date" class="form-control" @bind="_to" disabled="@_busy" />
            </div>
            <div class="col-auto">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="fs_a158" @bind="_includeAlpha158" disabled="@_busy" />
                    <label class="form-check-label" for="fs_a158">Includi catalogo Alpha158 (@_alpha158Count fattori, più lento)</label>
                </div>
            </div>
        </div>

        <DataAvailability Symbol="@_symbol" Timeframe="@_timeframe" From="_from" To="_to" Disabled="_busy"
                          OnApplyRange="@(r => { _from = r.From; _to = r.To; })"
                          OnHasDataChanged="@(has => _hasData = has)" />

        @* Orizzonte e filtri di selezione hanno default sensati: pannello avanzate. *@
        <AdvancedPanel Summary="@AdvancedSummary">
            <div class="row g-3 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Orizzonte forward</label>
                    <input type="number" class="form-control" style="width:7rem" @bind="_forwardHorizon" disabled="@_busy" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Top N</label>
                    <input type="number" class="form-control" style="width:6rem" @bind="_topN" disabled="@_busy" />
                </div>
                <div class="col-auto">
                    <label class="form-label">|IC| minimo</label>
                    <input type="number" step="any" class="form-control" style="width:7rem" @bind="_minAbsIc" disabled="@_busy" />
                </div>
                <div class="col-auto">
                    <label class="form-label">IR minimo</label>
                    <input type="number" step="any" class="form-control" style="width:7rem" @bind="_minIr" disabled="@_busy" />
                </div>
                <div class="col-auto">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="fs_sign" @bind="_requireConsistentSign" disabled="@_busy" />
                        <label class="form-check-label" for="fs_sign">Solo segno consistente</label>
                    </div>
                </div>
                <div class="col-auto">
                    @* [2.6] Il gate anti-ridondanza del modulo Microstructure, applicato ai fattori
                       tenuti. Default spento: cambia l'insieme selezionato, e chi lo accende deve
                       sapere che lo sta facendo. *@
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" id="fs_incgate" @bind="_incrementalGate" disabled="@_busy" />
                        <label class="form-check-label" for="fs_incgate"
                               title="Passa i tenuti in ordine di |IC| e scarta chi non aggiunge informazione oltre ai precedenti (IC parziale + nullo per permutazione).">
                            Filtro incrementale (scarta i ridondanti)
                        </label>
                    </div>
                </div>
            </div>
        </AdvancedPanel>

        <div class="mt-3">
            <button class="btn btn-primary" @onclick="RunAsync" disabled="@(_busy || !_hasData)"
                    title="@(!_hasData ? $"Nessun dato per {_symbol} {_timeframe}: scaricali prima da Watchlist." : null)">
                @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Valuta fattori
            </button>
        </div>
        <div class="text-muted small mt-2">Candidati da valutare: <strong>@CandidateCount()</strong></div>
        @if (!string.IsNullOrEmpty(_status))
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-info") mt-3 mb-0">@_status</div>
        }
    </div>
</div>

@* [D2, persistenza] La storia REGISTRATA dal job periodico. Sta FUORI dal blocco che richiede una
   valutazione perché è il pezzo che si deve vedere appena si apre la pagina, senza calcolare niente:
   è la differenza fra un monitor che risponde a chi lo interroga e uno che si fa trovare. Il verdetto
   qui è ricostruito dalle finestre registrate con lo stesso Judge del calcolo fresco. *@
<div class="card mb-3" id="drift-recorded">
    <div class="card-header d-flex justify-content-between align-items-center">
        @* Si mostra la serie EFFETTIVAMENTE caricata, non quella selezionata nel form: cambiare la
           tendina senza ricaricare lascerebbe altrimenti un'intestazione che mente sui dati sotto. *@
        <span>Storia registrata dal job — @(_recorded is not null ? $"{_recorded.Symbol} {_recorded.Timeframe}" : $"{_symbol} {_timeframe}")</span>
        <span class="d-flex align-items-center gap-2">
            @if (_recorded is not null)
            {
                var recordedAlerts = _recorded.Alerts.Count;
                <span class="badge @(recordedAlerts > 0 ? "bg-warning text-dark" : "bg-success")">
                    @(recordedAlerts > 0 ? $"{recordedAlerts} in allarme" : "nessun allarme")
                </span>
            }
            <button class="btn btn-sm btn-outline-secondary" @onclick="LoadRecordedAsync" disabled="@_recordedBusy">
                @if (_recordedBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Ricarica
            </button>
        </span>
    </div>
    <div class="card-body">
        @if (_recorded is null)
        {
            <div class="text-body-secondary small">
                Il job non ha ancora registrato questa serie. Calcola la deriva delle serie della
                <strong>watchlist</strong> ogni @_recordedIntervalHours ore e scrive una riga per finestra:
                se qui non c'è nulla, o la serie non è in watchlist, o il job non ha ancora fatto il primo giro
                (parte 2 minuti dopo l'avvio).
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Fattore</th>
                            <th>IC nel tempo</th>
                            <th class="text-end">riferimento</th>
                            <th class="text-end">recente</th>
                            <th class="text-end">soglia</th>
                            <th class="text-end">finestre</th>
                            <th>Verdetto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _recorded.Reports)
                        {
                            <tr class="@(r.Status switch {
                                FactorDriftStatus.SignFlip => "table-danger",
                                FactorDriftStatus.Weakening => "table-warning",
                                _ => "" })">
                                <td>@r.FeatureName</td>
                                <td>@IcSparkline(r)</td>
                                <td class="text-end font-monospace">@r.ReferenceIc.ToString("F3")</td>
                                <td class="text-end font-monospace">@r.RecentIc.ToString("F3")</td>
                                <td class="text-end font-monospace text-body-secondary">@r.NoiseFloor.ToString("F3")</td>
                                <td class="text-end font-monospace text-body-secondary">
                                    @r.Series.Count × @(r.Series.Count > 0 ? r.Series[^1].Observations : 0)
                                </td>
                                <td>
                                    <span class="badge @(r.Status switch {
                                        FactorDriftStatus.SignFlip => "bg-danger",
                                        FactorDriftStatus.Weakening => "bg-warning text-dark",
                                        FactorDriftStatus.Insufficient => "bg-secondary",
                                        _ => "bg-success" })">@DriftLabel(r.Status)</span>
                                    <div class="small text-body-secondary">@r.StatusMessage</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @* Le tre cose che rendono confrontabili (o no) questo pannello e quello sotto: orizzonte,
               ampiezza della finestra e quante candele ha visto il job. Senza dirle, due verdetti
               diversi sulla stessa serie sembrano una contraddizione invece che due misure diverse. *@
            <div class="alert alert-light border small mt-2 mb-2 py-2">
                Orizzonte forward: <strong>1 barra</strong> (quello del job).
                @if (_forwardHorizon != 1)
                {
                    <span class="text-danger">
                        Il form qui sopra è impostato su @_forwardHorizon: i numeri dei due pannelli
                        <strong>non sono confrontabili</strong>.
                    </span>
                }
                Il job calcola sulle ultime <strong>@_recordedMaxCandles.ToString("N0")</strong> candele
                (tetto <code>FactorDrift:MaxCandles</code>): se qui sotto valuti un periodo più lungo, la
                finestra proposta è più ampia e la soglia più bassa — stessa regola, campione diverso.
            </div>
            <div class="form-text mt-2">
                Ultimo calcolo del job: <strong>@_recorded.ComputedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</strong>
                @if (_recorded.Reports.Count > 0 && _recorded.Reports[0].Series.Count > 0)
                {
                    <text> · periodo coperto dalle finestre registrate:
                    @_recorded.Reports.Min(r => r.Series.Count > 0 ? r.Series[0].WindowStartUtc : DateTime.MaxValue).ToString("yyyy-MM-dd")
                    → @_recorded.Reports.Max(r => r.Series.Count > 0 ? r.Series[^1].WindowEndUtc : DateTime.MinValue).ToString("yyyy-MM-dd")</text>
                }
                . Le righe vengono <strong>riscritte, non duplicate</strong>, quando il job ricalcola la stessa
                finestra. Qui non compare l'IC full-sample: dalle finestre registrate non è ricostruibile, e
                mostrarne una media spacciata per ricalcolo sarebbe un numero falso — per quello c'è il
                pannello qui sotto, che ricalcola davvero.
            </div>
        }
    </div>
</div>

@if (_ranked is not null)
{
    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>|IC| per fattore (verde = IC positivo, rosso = negativo) — riquadro = supera i filtri</span>
            <span class="small text-muted">@_kept.Count / @_ranked.Count tenuti · @_observations osservazioni</span>
        </div>
        <div class="card-body"><div id="fs_ic_chart" style="width:100%;"></div></div>
    </div>

    <div class="card">
        <div class="card-header">Classifica fattori</div>
        <div class="table-responsive">
            <table class="table table-sm table-striped mb-0">
                <thead><tr><th>#</th><th>Fattore</th><th class="text-end">IC</th><th class="text-end">|IC|</th><th class="text-end">Info Ratio</th><th class="text-end">Consistenza</th><th class="text-end">Oss.</th><th class="text-center">Tenuto</th></tr></thead>
                <tbody>
                    @{ var rank = 0; }
                    @foreach (var s in _ranked)
                    {
                        rank++;
                        var kept = _kept.Contains(s.Spec.FeatureName);
                        <tr class="@(kept ? "table-success" : "")">
                            <td>@rank</td>
                            <td>@s.Spec.FeatureName</td>
                            <td class="text-end @(s.Evaluation.InformationCoefficient >= 0 ? "text-success" : "text-danger")">@s.Evaluation.InformationCoefficient.ToString("F4")</td>
                            <td class="text-end fw-semibold">@s.AbsIc.ToString("F4")</td>
                            <td class="text-end">@s.Evaluation.InformationRatio.ToString("F3")</td>
                            <td class="text-end">@s.Evaluation.IcConsistency.ToString("P0")</td>
                            <td class="text-end">@s.Evaluation.Observations</td>
                            <td class="text-center">
                                @if (kept)
                                {
                                    <text>✅</text>
                                }
                                else if (_redundant.Contains(s.Spec.FeatureName))
                                {
                                    @* [2.6] Superava i filtri per |IC|, ma non aggiunge informazione
                                       oltre ai fattori già tenuti: il tooltip dice quanto ne resta. *@
                                    var o = _incOutcomes is not null && _incOutcomes.TryGetValue(s.Spec.FeatureName, out var oo) ? oo : null;
                                    <span class="badge bg-warning text-dark"
                                          title="@(o is null ? "Ridondante coi fattori già tenuti." : $"IC parziale {o.PartialIc:F4} (grezzo {o.RawIc:F4}, correlazione col tenuto {o.CorrelationWithProxy:F2}): {o.Message}")">
                                        ridondante
                                    </span>
                                }
                                else
                                {
                                    <text>—</text>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* [D2] Deriva dei fattori: un IC full-sample alto può nascondere un fattore che informava e
       ha smesso. Qui si guarda la stessa misura NEL TEMPO. *@
    <div class="card mt-3" id="drift-panel">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Deriva nel tempo — un fattore che informava può aver smesso</span>
            @if (_drift is not null)
            {
                var alerts = _drift.Count(d => d.IsAlert);
                <span class="badge @(alerts > 0 ? "bg-warning text-dark" : "bg-success")">
                    @(alerts > 0 ? $"{alerts} in allarme" : "nessun allarme")
                </span>
            }
        </div>
        <div class="card-body">
            <div class="row g-2 align-items-end mb-3">
                <div class="col-auto">
                    <label class="form-label">Fattori da analizzare (i primi per |IC|)</label>
                    <input type="number" class="form-control" style="width: 8rem;" min="1" max="50" @bind="_driftTopN" disabled="@_busy" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Ampiezza finestra (osservazioni)</label>
                    <input type="number" class="form-control" style="width: 10rem;" min="50" max="5000" step="50" @bind="_driftWindow" disabled="@_busy" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-primary" @onclick="AnalyzeDriftAsync" disabled="@_busy">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Analizza deriva
                    </button>
                </div>
                <div class="col-auto">
                    <span class="form-text">
                        Pavimento di rumore a questa finestra:
                        <strong>@FactorDriftAnalyzer.NoiseFloorFor(Math.Max(10, _driftWindow)).ToString("F3")</strong>
                        — sotto questo valore un IC non è distinguibile da zero.
                    </span>
                </div>
            </div>

            @if (_drift is not null)
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Fattore</th>
                                <th>IC nel tempo</th>
                                <th class="text-end">riferimento</th>
                                <th class="text-end">recente</th>
                                <th class="text-end">soglia</th>
                                <th>Verdetto</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in _drift)
                            {
                                <tr class="@(d.Status switch {
                                    FactorDriftStatus.SignFlip => "table-danger",
                                    FactorDriftStatus.Weakening => "table-warning",
                                    _ => "" })">
                                    <td>@d.FeatureName</td>
                                    <td>@IcSparkline(d)</td>
                                    <td class="text-end font-monospace">@d.ReferenceIc.ToString("F3")</td>
                                    <td class="text-end font-monospace">@d.RecentIc.ToString("F3")</td>
                                    <td class="text-end font-monospace text-body-secondary">@d.NoiseFloor.ToString("F3")</td>
                                    <td>
                                        <span class="badge @(d.Status switch {
                                            FactorDriftStatus.SignFlip => "bg-danger",
                                            FactorDriftStatus.Weakening => "bg-warning text-dark",
                                            FactorDriftStatus.Insufficient => "bg-secondary",
                                            _ => "bg-success" })">@DriftLabel(d.Status)</span>
                                        <div class="small text-body-secondary">@d.StatusMessage</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="form-text mt-2">
                    Le finestre sono <strong>non sovrapposte</strong>: pochi punti indipendenti invece di molti
                    punti che si assomigliano per costruzione. La soglia mostrata è il massimo fra il minimo
                    economico (0,02) e il pavimento di rumore statistico della finestra scelta — allargare la
                    finestra abbassa la soglia e rende visibili segnali più deboli, al prezzo di meno punti.
                </div>
            }
            else
            {
                <div class="text-body-secondary small">
                    Non ancora calcolata. L'analisi riusa le candele della valutazione qui sopra.
                </div>
            }
        </div>
    </div>

    @* [D3] Deviazione dichiarata invece che nascosta. Il PRD §5d chiedeva che il confronto fra OFI e
       proxy trade-flow passasse "dallo stesso /feature-selection". Non passa di qui, e la ragione non
       è pigrizia: i dati di microstruttura NON stanno nel database — il pilota di raccolta è
       deliberatamente spento perché la misura ha detto che non conviene accenderlo. Chi arriva qui con
       quella domanda merita di trovare la risposta, non il silenzio. *@
    <div class="card mt-3">
        <div class="card-header">Microstruttura (OFI) — perché non si misura da questa pagina</div>
        <div class="card-body small text-body-secondary">
            <p class="mb-2">
                La domanda «il <strong>book</strong> aggiunge informazione oltre allo sbilanciamento taker
                che vedi qui?» è stata misurata il <strong>2026-07-28</strong> su 30 giorni × 3 simboli di
                dump storici Binance, non da qui: i dati di book <strong>non sono nel database</strong>, e
                la raccolta dal vivo resta spenta proprio perché la misura ha detto che non conviene
                accenderla.
            </p>
            <p class="mb-2">
                Esito, in una riga: lo sbilanciamento di profondità <strong>aggiunge</strong> informazione
                (|IC parziale| 0,040-0,046 a 5 minuti, p 0,005, su 3 simboli su 3) ma
                <strong>non paga il giro</strong> — edge lordo ~0,7 punti base contro 4 di andata e
                ritorno. Il tape aggregato <em>sotto</em> il minuto non aggiunge nulla.
            </p>
            <p class="mb-0">
                Per rifarla: <code>dotnet run --project tools/PlatformExpand -- ofi BTCUSDT,ETHUSDT,SOLUSDT 30</code>.
                Metodo, limiti e numeri completi in <code>docs/REPORT-D3-OFI-2026-07-28.md</code>.
            </p>
        </div>
    </div>
}

@code {
    private ExchangeName _exchange = ExchangeName.Binance;
    private string _symbol = "BTC/USDT";
    private string _timeframe = "1h";
    private DateTime _from = new(2024, 6, 1);
    private DateTime _to = new(2026, 6, 1);
    private int _forwardHorizon = 1;
    private int _topN = 20;
    private double _minAbsIc = 0.02;
    private double _minIr;
    private bool _requireConsistentSign;

    // Aggiornato dal componente DataAvailability (gating della valutazione).
    private bool _hasData = true;

    /// <summary>Riassunto delle impostazioni avanzate, visibile a pannello chiuso.</summary>
    private string AdvancedSummary =>
        $"Orizzonte {_forwardHorizon} · Top {_topN} · |IC| ≥ {_minAbsIc:0.###} · IR ≥ {_minIr:0.###}"
        + (_requireConsistentSign ? " · solo segno consistente" : "")
        + (_incrementalGate ? " · filtro incrementale" : "");
    private bool _includeAlpha158;

    // [2.6] Filtro incrementale: esiti per fattore dell'ultima valutazione (null = filtro spento).
    private bool _incrementalGate;
    private HashSet<string> _redundant = new();
    private Dictionary<string, IncrementalIcOutcome>? _incOutcomes;

    private List<string> _knownSymbols = new();
    private int _alpha158Count;

    private IReadOnlyList<ScoredFactor>? _ranked;
    private HashSet<string> _kept = new();
    private int _observations;

    // [D2] Deriva dei fattori. Le candele dell'ultima valutazione restano in memoria per non
    // rifare la stessa query quando si chiede l'analisi nel tempo sugli stessi dati.
    private List<OhlcvData>? _candles;
    private IReadOnlyList<FactorDriftReport>? _drift;
    private int _driftTopN = 12;
    private int _driftWindow = 250;

    private bool _busy;
    private bool _isError;
    private string? _status;

    private IJSObjectReference? _chartModule;
    private bool _chartPending;

    // [D2, persistenza] Storia registrata dal job per la serie selezionata. Non è un calcolo: è una
    // lettura di tabella, quindi si può fare al caricamento della pagina senza far aspettare nessuno.
    private FactorDriftSeriesSnapshot? _recorded;
    private bool _recordedBusy;
    private int _recordedIntervalHours = 12;
    private int _recordedMaxCandles = 20_000;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthProvider.GetAuthenticationStateAsync();
        _userId = state.User.FindFirstValue(ClaimTypes.NameIdentifier);
        _alpha158Count = Factory.Prototypes.Count(IsAlpha158);
        await using var db = await DbFactory.CreateDbContextAsync();
        _knownSymbols = await db.OhlcvData.Select(c => c.Symbol).Distinct().OrderBy(s => s).ToListAsync();

        _recordedIntervalHours = Math.Max(1, Config.GetValue("FactorDrift:IntervalHours", 12));
        _recordedMaxCandles = Math.Clamp(Config.GetValue("FactorDrift:MaxCandles", 20_000), 1_000, 200_000);
        await LoadRecordedAsync();
    }

    /// <summary>
    /// Rilegge la storia registrata per la serie selezionata. Mai bloccante: se la tabella non è
    /// ancora stata creata (migrazione non applicata) il pannello resta vuoto invece di rompere la
    /// pagina — la deriva è advisory, non un ingranaggio del percorso operativo.
    /// </summary>
    private async Task LoadRecordedAsync()
    {
        _recordedBusy = true;
        try
        {
            _recorded = await IcHistory.LoadSnapshotAsync(
                _symbol.Trim(), _timeframe, new FactorDriftConfig { ForwardHorizon = 1 });
        }
        catch { _recorded = null; }
        finally { _recordedBusy = false; }
    }

    private string? _userId;
    private ConfigPresets? _presets;

    /// <summary>Fotografia completa del form per preset e memoria dell'ultima configurazione.</summary>
    private sealed record PageConfig(
        string Exchange, string Symbol, string Timeframe, DateTime From, DateTime To,
        int ForwardHorizon, int TopN, double MinAbsIc, double MinIr,
        bool RequireConsistentSign, bool IncludeAlpha158, bool IncrementalGate = false);

    private string CaptureConfigJson() => JsonSerializer.Serialize(new PageConfig(
        _exchange.ToString(), _symbol.Trim(), _timeframe, _from, _to,
        _forwardHorizon, _topN, _minAbsIc, _minIr, _requireConsistentSign, _includeAlpha158,
        _incrementalGate));

    private void ApplyConfigJson(string json)
    {
        PageConfig? cfg;
        try { cfg = JsonSerializer.Deserialize<PageConfig>(json); }
        catch (JsonException) { return; } // preset malformato: il form resta com'è
        if (cfg is null) return;

        if (Enum.TryParse<ExchangeName>(cfg.Exchange, ignoreCase: true, out var ex)) _exchange = ex;
        if (!string.IsNullOrWhiteSpace(cfg.Symbol)) _symbol = cfg.Symbol;
        if (Timeframes.Supported.ContainsKey(cfg.Timeframe)) _timeframe = cfg.Timeframe;
        _from = cfg.From.Date;
        _to = cfg.To.Date;
        _forwardHorizon = cfg.ForwardHorizon;
        _topN = cfg.TopN;
        _minAbsIc = cfg.MinAbsIc;
        _minIr = cfg.MinIr;
        _requireConsistentSign = cfg.RequireConsistentSign;
        _includeAlpha158 = cfg.IncludeAlpha158;
        _incrementalGate = cfg.IncrementalGate;
    }

    private static bool IsAlpha158(IAlphaFactor f) => Alpha158Catalog.TryCreate(f.Name, out _);

    private List<FactorSpec> Candidates() => Factory.Prototypes
        .Where(f => _includeAlpha158 || !IsAlpha158(f))
        .Select(f => new FactorSpec(f.Name, f, f.ParameterDefinitions.ToDictionary(d => d.Key, d => d.Default)))
        .ToList();

    private int CandidateCount() => Factory.Prototypes.Count(f => _includeAlpha158 || !IsAlpha158(f));

    private async Task RunAsync()
    {
        // Memoria dell'ultima configurazione usata (best-effort, mai bloccante).
        if (_presets is not null) await _presets.SaveLastUsedAsync();

        _busy = true; _isError = false; _status = null; _ranked = null; _drift = null; _candles = null;
        _redundant = new(); _incOutcomes = null;
        try
        {
            List<OhlcvData> candles;
            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                var fromUtc = DateTime.SpecifyKind(_from.Date, DateTimeKind.Utc);
                var toUtc = DateTime.SpecifyKind(_to.Date, DateTimeKind.Utc);
                candles = await db.OhlcvData
                    .Where(c => c.Symbol == _symbol.Trim() && c.Timeframe == _timeframe && c.TimestampUtc >= fromUtc && c.TimestampUtc <= toUtc)
                    .OrderBy(c => c.TimestampUtc)
                    .ToListAsync();
            }
            if (candles.Count < 100)
            {
                SetStatus($"Solo {candles.Count} candele nel range: servono più dati (ingerisci in /market-analysis).", true);
                return;
            }

            var config = new IcFeatureSelectionConfig
            {
                ForwardHorizon = _forwardHorizon,
                TopN = _topN,
                MinAbsIc = _minAbsIc,
                MinInformationRatio = _minIr,
                RequireConsistentSign = _requireConsistentSign,
            };
            var candidates = Candidates();
            var useIncremental = _incrementalGate;
            var horizon = _forwardHorizon;

            // CPU-bound (valuta N fattori): fuori dal thread del circuito.
            var (ranked, selected, incremental) = await Task.Run(() =>
            {
                var r = Selector.Rank(candidates, candles, config);
                var sel = Selector.Select(candidates, candles, config);

                // [2.6] Il filtro lavora SUI TENUTI, nell'ordine della classifica (|IC| decrescente):
                // il migliore fa da capostipite, gli altri devono aggiungere informazione oltre a lui.
                IncrementalFilterResult? inc = null;
                if (useIncremental && sel.Count > 1)
                {
                    var selNames = sel.Select(s => s.FeatureName).ToHashSet();
                    var ordered = r.Where(s => selNames.Contains(s.Spec.FeatureName)).Select(s => s.Spec).ToList();
                    inc = IncrementalFactorFilter.Apply(ordered, candles, horizon);
                }
                return (r, sel, inc);
            });

            _ranked = ranked;
            _candles = candles;
            _kept = incremental is not null
                ? incremental.Kept.Select(k => k.FeatureName).ToHashSet()
                : selected.Select(s => s.FeatureName).ToHashSet();
            _redundant = incremental is null
                ? new()
                : incremental.Entries.Where(e => !e.Kept).Select(e => e.Spec.FeatureName).ToHashSet();
            _incOutcomes = incremental?.Entries
                .Where(e => e.Outcome is not null)
                .ToDictionary(e => e.Spec.FeatureName, e => e.Outcome!);
            _driftWindow = SuggestDriftWindow(ranked);
            _observations = ranked.Count > 0 ? ranked.Max(s => s.Evaluation.Observations) : 0;
            _chartPending = true;
            var message = $"Valutati {ranked.Count} fattori su {candles.Count} candele: {_kept.Count} superano i filtri.";
            if (incremental is not null && incremental.DroppedCount > 0)
            {
                message += $" Il filtro incrementale ne ha scartati {incremental.DroppedCount} come ridondanti.";
            }
            SetStatus(message, false);

            // La serie può essere cambiata rispetto al caricamento della pagina: la storia registrata
            // segue la serie che si sta guardando.
            await LoadRecordedAsync();
        }
        catch (Exception ex) { SetStatus($"Errore: {ex.Message}", true); }
        finally { _busy = false; }
    }

    /// <summary>
    /// [D2] Ampiezza di finestra proposta dopo una valutazione: quella che produce ~10 finestre
    /// sui dati effettivamente disponibili.
    ///
    /// Non è un dettaglio estetico. Il pavimento di rumore dell'IC va come <c>1,96/√n</c>: con la
    /// finestra fissa a 250 che questa pagina proponeva all'inizio, la soglia risulta 0,124 e
    /// **nessun fattore reale la supera** — misurato dal vivo su BTC/USDT 1h, dove tutti e dieci i
    /// fattori finivano in "non informava già" e il pannello non diceva nulla di utile. Con ~2500
    /// osservazioni la soglia scende a 0,039 e la stessa serie mostra due fattori che si sono
    /// spenti davvero. Il compromesso è dichiarato: finestre più larghe vedono segnali più deboli
    /// ma danno meno punti nel tempo, e chi vuole l'altro lato del baratto cambia il numero.
    /// </summary>
    private static int SuggestDriftWindow(IReadOnlyList<ScoredFactor> ranked)
    {
        var observations = ranked.Count > 0 ? ranked.Max(s => s.Evaluation.Observations) : 0;
        if (observations <= 0) return 250;
        // Regola CONDIVISA col job periodico: sulla stessa numerosità i due devono proporre la stessa
        // finestra, altrimenti la stessa serie riceve soglie diverse e verdetti che si contraddicono.
        return FactorDriftAnalyzer.SuggestWindowSize(observations);
    }

    /// <summary>
    /// [D2] Analizza la deriva nel tempo dei primi fattori per |IC|. Si limita ai primi N perché
    /// col catalogo Alpha158 attivo i candidati sono centinaia, e la domanda "questo fattore si sta
    /// spegnendo?" ha senso su quelli che stavi per usare, non su tutti.
    /// </summary>
    private async Task AnalyzeDriftAsync()
    {
        if (_ranked is null || _candles is null)
        {
            SetStatus("Esegui prima 'Valuta fattori': la deriva si calcola sulle stesse candele.", true);
            return;
        }

        _busy = true; _isError = false; _status = null;
        try
        {
            var specs = _ranked.Take(Math.Clamp(_driftTopN, 1, 50)).Select(s => s.Spec).ToList();
            var config = new FactorDriftConfig
            {
                ForwardHorizon = _forwardHorizon,
                WindowSize = Math.Clamp(_driftWindow, 50, 5000),
                MinAbsIc = _minAbsIc,
            };
            var candles = _candles;

            // CPU-bound come la valutazione: fuori dal thread del circuito.
            _drift = await Task.Run(() => DriftAnalyzer.AnalyzeMany(specs, candles, config));

            var alerts = _drift.Count(d => d.IsAlert);
            var insufficient = _drift.Count(d => d.Status == FactorDriftStatus.Insufficient);
            var message = $"Deriva analizzata su {_drift.Count} fattori: {alerts} in allarme.";
            if (insufficient > 0)
            {
                message += $" {insufficient} senza finestre sufficienti: allarga il periodo o riduci l'ampiezza della finestra.";
            }
            SetStatus(message, false);
        }
        catch (Exception ex) { SetStatus($"Errore nell'analisi di deriva: {ex.Message}", true); }
        finally { _busy = false; }
    }

    private static string DriftLabel(FactorDriftStatus status) => status switch
    {
        FactorDriftStatus.SignFlip => "segno invertito",
        FactorDriftStatus.Weakening => "si è spento",
        FactorDriftStatus.Insufficient => "dati insufficienti",
        _ => "stabile",
    };

    /// <summary>
    /// Sparkline SVG dell'IC finestra per finestra, con lo zero come riferimento e la banda del
    /// rumore ombreggiata: senza quella banda una spezzata che oscilla sembrerebbe raccontare
    /// qualcosa anche quando sta solo rimbalzando dentro l'errore di misura.
    /// </summary>
    private static RenderFragment IcSparkline(FactorDriftReport report) => builder =>
    {
        const double w = 130, h = 28;
        var series = report.Series;
        if (series.Count < 2)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "text-body-secondary small");
            builder.AddContent(2, "—");
            builder.CloseElement();
            return;
        }

        var scale = Math.Max(series.Max(p => Math.Abs(p.InformationCoefficient)), report.NoiseFloor);
        if (scale <= 0) scale = 1;

        double Y(double ic) => h / 2 - ic / scale * (h / 2 - 2);
        var points = string.Join(" ", series.Select((p, i) =>
        {
            var x = series.Count == 1 ? 0 : i * w / (series.Count - 1);
            return FormattableString.Invariant($"{x:F1},{Y(p.InformationCoefficient):F1}");
        }));

        var bandTop = Y(report.NoiseFloor);
        var bandHeight = Y(-report.NoiseFloor) - bandTop;

        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "width", w);
        builder.AddAttribute(2, "height", h);
        builder.AddAttribute(3, "role", "img");
        builder.AddAttribute(4, "aria-label",
            FormattableString.Invariant($"IC per finestra, da {series[0].InformationCoefficient:F3} a {series[^1].InformationCoefficient:F3}"));

        // Banda del rumore.
        builder.OpenElement(10, "rect");
        builder.AddAttribute(11, "x", "0");
        builder.AddAttribute(12, "y", FormattableString.Invariant($"{bandTop:F1}"));
        builder.AddAttribute(13, "width", FormattableString.Invariant($"{w:F0}"));
        builder.AddAttribute(14, "height", FormattableString.Invariant($"{bandHeight:F1}"));
        builder.AddAttribute(15, "fill", "currentColor");
        builder.AddAttribute(16, "opacity", "0.08");
        builder.CloseElement();

        // Linea dello zero.
        builder.OpenElement(20, "line");
        builder.AddAttribute(21, "x1", "0");
        builder.AddAttribute(22, "y1", FormattableString.Invariant($"{h / 2:F1}"));
        builder.AddAttribute(23, "x2", FormattableString.Invariant($"{w:F0}"));
        builder.AddAttribute(24, "y2", FormattableString.Invariant($"{h / 2:F1}"));
        builder.AddAttribute(25, "stroke", "currentColor");
        builder.AddAttribute(26, "opacity", "0.25");
        builder.AddAttribute(27, "stroke-width", "1");
        builder.CloseElement();

        // Spezzata dell'IC.
        builder.OpenElement(30, "polyline");
        builder.AddAttribute(31, "points", points);
        builder.AddAttribute(32, "fill", "none");
        builder.AddAttribute(33, "stroke", report.IsAlert ? "var(--bs-danger)" : "var(--bs-primary)");
        builder.AddAttribute(34, "stroke-width", "1.5");
        builder.CloseElement();

        builder.CloseElement();
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chartPending && _ranked is not null)
        {
            _chartPending = false;
            await RenderChartAsync();
        }
    }

    private async Task RenderChartAsync()
    {
        if (_ranked is null || _ranked.Count == 0) return;
        _chartModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/charts.js");

        var top = _ranked.Take(25).ToList();
        var labels = top.Select(s => s.Spec.FeatureName).ToArray();
        var values = top.Select(s => s.AbsIc).ToArray();
        // Verde se IC positivo, rosso se negativo; bordo scuro se tenuto.
        var colors = top.Select(s => s.Evaluation.InformationCoefficient >= 0 ? "#1a9850" : "#d73027").ToArray();

        await _chartModule.InvokeVoidAsync("barh", "fs_ic_chart", labels, values, "|IC|", colors);
    }

    private void SetStatus(string text, bool error) { _status = text; _isError = error; }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_chartModule is not null)
            {
                await _chartModule.InvokeVoidAsync("dispose", "fs_ic_chart");
                await _chartModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException) { }
    }
}
