    /// <summary>
    /// [G6] Spiegazione su richiesta di UN run. <paramref name="force"/> rigenera al posto di
    /// restituire quella già scritta. Un fallimento si dice: senza messaggio, un pulsante che non
    /// fa nulla è indistinguibile da un pulsante rotto.
    /// </summary>
    private async Task ExplainRunAsync(Guid runId, bool force)
    {
        _busy = true; _explainStatus = null; _explainIsError = false;
        try
        {
            var narration = await RejectionExplain.ExplainRunAsync(runId, force);
            if (narration is null)
            {
                _explainIsError = true;
                _explainStatus = "Nessuna spiegazione prodotta: il layer AI non ha risposto " +
                                 "(spento, senza chiave, breaker aperto o budget esaurito — lo stato è nelle card qui sopra). " +
                                 "I numeri del run restano quelli che vedi.";
            }
            else
            {
                _explainStatus = $"Spiegazione scritta da {narration.ModelUsed}" +
                                 (narration.DiscardedNotes > 0
                                     ? $" · {narration.DiscardedNotes} note scartate perché riferite a candidati inesistenti."
                                     : ".");
            }
            _rejections = await RejectionExplain.GetRecentAsync(5);
        }
        catch (Exception ex)
        {
            _explainIsError = true;
            _explainStatus = $"Spiegazione fallita: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _guard = Guard.GetStatus();

            // [AF1] Snapshot consumo + verdetto budget + valori correnti del form.
            _usage = UsageSink.GetSnapshot();
            _budgetVerdict = UsageSink.CheckBudget();
            var budget = BudgetMonitor.CurrentValue;
            _budgetTracking = budget.TrackingEnabled;
            _budgetDailyCalls = budget.DailyCallLimit;
            _budgetDailyTokens = budget.DailyTokenLimit;
            _budgetMonthlyTokens = budget.MonthlyTokenLimit;

            // [AF3] Comitato: copia locale (mai riferire il CurrentValue vivo dentro un form).
            var committee = CommitteeMonitor.CurrentValue;
            _committee = new ProcioneMGR.Services.Llm.Committee.CommitteeOptions
            {
                Enabled = committee.Enabled,
                Providers = [.. committee.Providers],
                TimeoutSeconds = committee.TimeoutSeconds,
                MinValidVotes = committee.MinValidVotes,
            };
            _committeeProvidersCsv = string.Join(",", committee.Providers);

            // [G6] Interruttore della prosa + i verdetti recenti. Il digest è deterministico:
            // questa lista si popola anche col layer AI spento, ed è il punto della funzione.
            var llmOpt = LlmOptionsMonitor.CurrentValue;
            _explainEnabled = llmOpt.ExplainRejections;
            _explainTopN = llmOpt.ExplainRejectionsTopN;
            _rejections = await RejectionExplain.GetRecentAsync(5);

            // [G4] Copia locale delle opzioni (mai il CurrentValue vivo dentro un form) + le righe.
            _postMortem = JsonSerializer.Deserialize<ProcioneMGR.Services.Llm.Narration.PostMortemOptions>(
                JsonSerializer.Serialize(PostMortemMonitor.CurrentValue))!;
            _postMortems = await PostMortems.GetRecentAsync(20);

            await using var db = await DbFactory.CreateDbContextAsync();
            var rows = await db.PipelineArtifacts
                .Where(a => a.Kind == LlmArtifactKinds.Advisory)
                .OrderByDescending(a => a.CreatedAt)
                .Take(50)
                .Select(a => new { a.RunId, a.CreatedAt, a.PayloadJson })
                .ToListAsync();

            _items = rows.Select(r =>
            {
                SupervisorAdvisory adv;
                try { adv = JsonSerializer.Deserialize<SupervisorAdvisory>(r.PayloadJson) ?? new(); }
                catch { adv = new SupervisorAdvisory { IsError = true, Summary = "Advisory non leggibile." }; }
                return new AdvisoryItem(r.RunId, r.CreatedAt, adv);
            }).ToList();

            // [Fase C] I secondi pareri degli stessi run, per l'affiancamento nelle card.
            var runIds = _items.Select(i => i.RunId).ToList();
            var comparisonRows = await db.PipelineArtifacts
                .Where(a => a.Kind == LlmArtifactKinds.AdvisoryComparison && runIds.Contains(a.RunId))
                .Select(a => new { a.RunId, a.CreatedAt, a.PayloadJson })
                .ToListAsync();
            _comparisons = comparisonRows
                .Select(r =>
                {
                    SupervisorAdvisory adv;
                    try { adv = JsonSerializer.Deserialize<SupervisorAdvisory>(r.PayloadJson) ?? new(); }
                    catch { adv = new SupervisorAdvisory { IsError = true, Summary = "Secondo parere non leggibile." }; }
                    return new AdvisoryItem(r.RunId, r.CreatedAt, adv);
                })
                .GroupBy(i => i.RunId)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(i => i.CreatedAt).First());

            _okCount = _items.Count(i => !i.Advisory.IsError);
            _errorCount = _items.Count(i => i.Advisory.IsError);

            // Stessa anti-join del worker: run completati recenti ancora senza advisory.
            var since = DateTime.UtcNow.AddDays(-7);
            _pendingRuns = await db.PipelineRuns
                .Where(r => r.Status == "Completed" && r.CompletedAt != null && r.CompletedAt >= since)
                .Where(r => !db.PipelineArtifacts.Any(a => a.RunId == r.Id && a.Kind == LlmArtifactKinds.Advisory))
                .CountAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RetryNowAsync()
    {
        _busy = true; _actionIsError = false; _actionStatus = null;
        try
        {
            await LlmWorker.TickAsync(CancellationToken.None, forceProbe: true);
            _actionStatus = "Tentativo eseguito (cooldown del breaker ignorato). Stato e advisory aggiornati qui sotto.";
        }
        catch (Exception ex)
        {
            _actionIsError = true;
            _actionStatus = $"Tentativo fallito: {ex.Message}";
        }
        finally { _busy = false; }
        await LoadAsync();
    }

    private async Task ReanalyzeErrorsAsync()
    {
        _busy = true; _actionIsError = false; _actionStatus = null;
        try
        {
            var deleted = await Supervisor.DeleteErrorAdvisoriesAsync(DateTime.UtcNow.AddDays(-7), CancellationToken.None);
            _actionStatus = deleted == 0
                ? "Nessun advisory in errore nella finestra di 7 giorni."
                : $"Eliminati {deleted} advisory in errore: i run verranno rianalizzati dal ciclo automatico (≤5 per tick), o subito con \"Riprova adesso\".";
        }
        catch (Exception ex)
        {
            _actionIsError = true;
            _actionStatus = $"Pulizia fallita: {ex.Message}";
        }
        finally { _busy = false; }
        await LoadAsync();
    }

