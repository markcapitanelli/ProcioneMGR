@page "/admin/ai-supervisor"
@rendermode InteractiveServer
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ProcioneMGR.Data
@using ProcioneMGR.Services.Llm
@using ProcioneMGR.Services.Pipeline
@attribute [Authorize(Roles = $"{AppRoles.Admin},{AppRoles.Manager}")]

@using Microsoft.Extensions.Options
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ILlmClient LlmClient
@inject ILlmCallGuard Guard
@inject IPipelineSupervisor Supervisor
@inject LlmSupervisorWorker LlmWorker
@inject IAiKeyStore KeyStore
@inject IOptionsMonitor<LlmOptions> LlmOptionsMonitor
@inject ILlmClientResolver ClientResolver
@inject ProcioneMGR.Services.Config.IAppConfigWriter ConfigWriter

<PageTitle>Supervisione AI</PageTitle>

<h1>Supervisione AI del ciclo di ricerca</h1>

<GuidaPanel Title="Supervisione AI — un consulente sulle cacce, non un esecutore">
    <p>
        A ogni run del pipeline concluso, un agente AR (Claude) legge la <code>PipelineRecommendation</code>
        prodotta dal motore e scrive un <strong>parere leggibile</strong>: un riepilogo, eventuali
        aggiustamenti proposti ai parametri di caccia, e le decisioni che richiedono la tua
        <strong>conferma esplicita</strong>.
    </p>
    <p class="mb-0">
        <strong>Confine di sicurezza (non negoziabile):</strong> l'AI è <em>solo advisory</em>. Non può
        avviare il trading live, non può bypassare i controlli di sicurezza (<code>SafetyChecker</code>),
        non apre posizioni. I suoi suggerimenti sui parametri sono spunti da valutare, mai comandi
        applicati in automatico. Il layer è attivo solo se <code>Llm:Enabled=true</code> e il provider
        attivo ha una chiave (inserita qui sotto, cifrata a riposo, o via variabile d'ambiente).
    </p>
</GuidaPanel>

@* ---- [Multi-provider 2026-08] Provider attivo, modelli e chiavi ---- *@
<div class="card mb-3">
    <div class="card-header"><i class="bi bi-key me-1"></i>Provider e chiavi</div>
    <div class="card-body">
        <p class="text-muted small">
            Il provider scelto qui serve OGNI chiamata del layer AI (hot-reload: effetto alla chiamata
            successiva, senza riavvio). Le chiavi sono cifrate a riposo (AES-256-GCM, stessa cifratura
            delle credenziali exchange); in assenza di chiave a database vale la variabile d'ambiente
            del provider. La chiave non viene mai rimostrata: solo la sua fonte.
        </p>
        <div class="row g-3 align-items-end mb-3">
            <div class="col-auto">
                <label class="form-label mb-0">Provider attivo</label>
                <select class="form-select" @bind="_provider">
                    @foreach (var p in AiProviders.Known)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
            @foreach (var p in AiProviders.Known)
            {
                <div class="col-auto">
                    <label class="form-label mb-0">
                        Modello @p
                        @if (_modelCatalog.TryGetValue(p, out var catalog) && catalog.Count > 0)
                        {
                            <span class="badge bg-light text-dark ms-1" title="modelli disponibili per la TUA chiave">@catalog.Count</span>
                        }
                    </label>
                    <div class="input-group" style="min-width: 17rem">
                        <input class="form-control" list="models-@p" @bind="_models[p]"
                               placeholder="@ModelPlaceholder(p)" />
                        <button class="btn btn-outline-secondary" title="Scarica dall'API l'elenco dei modelli disponibili per la chiave di @p"
                                @onclick="() => FetchModelsAsync(p)" disabled="@(_fetchingModels == p)">
                            @if (_fetchingModels == p)
                            { <span class="spinner-border spinner-border-sm"></span> }
                            else
                            { <i class="bi bi-cloud-download"></i> }
                        </button>
                    </div>
                    <datalist id="models-@p">
                        @if (_modelCatalog.TryGetValue(p, out var list))
                        {
                            @foreach (var m in list)
                            { <option value="@m"></option> }
                        }
                    </datalist>
                </div>
            }
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="SaveProviderAsync" disabled="@_busy">Salva provider/modelli</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_catalogStatus))
        {
            <div class="alert @(_catalogIsError ? "alert-danger" : "alert-success") py-2 mb-2" style="white-space: pre-wrap;">@_catalogStatus</div>
        }

        @* [Fase C] Secondo parere: stesso run, provider diverso, artifact separato. *@
        <div class="row g-3 align-items-end mb-3">
            <div class="col-auto form-check ms-2">
                <input class="form-check-input" type="checkbox" id="cmpEnabled" @bind="_comparisonEnabled" />
                <label class="form-check-label" for="cmpEnabled">
                    Secondo parere per ogni run
                    <span class="text-muted small">(chiede la stessa analisi anche al provider qui accanto: raddoppia il costo per run; best-effort — se fallisce, il run resta con un parere solo)</span>
                </label>
            </div>
            <div class="col-auto">
                <label class="form-label mb-0">Provider del secondo parere</label>
                <select class="form-select" @bind="_comparisonProvider">
                    @foreach (var p in AiProviders.Known)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <span class="text-muted small">Si salva con «Salva provider/modelli». Se coincide col provider attivo, il confronto si salta da solo.</span>
            </div>
        </div>

        <table class="table table-sm align-middle mb-3" style="max-width: 60rem">
            <thead class="table-light"><tr><th>Provider</th><th>Fonte chiave</th><th>Nuova chiave</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in AiProviders.Known)
                {
                    <tr>
                        <td><strong>@p</strong></td>
                        <td>
                            @switch (KeyStore.GetCachedSource(p))
                            {
                                case AiKeySource.Database:
                                    <span class="badge bg-success">a database (cifrata)</span>
                                    break;
                                case AiKeySource.Environment:
                                    <span class="badge bg-info text-dark">variabile d'ambiente (@AiProviders.EnvVarFor(p))</span>
                                    break;
                                default:
                                    <span class="badge bg-danger">assente</span>
                                    break;
                            }
                        </td>
                        <td style="min-width: 22rem">
                            @* oninput e non il default onchange: col default il valore si committa
                               solo al blur, e il click su un Salva ancora disabilitato viene
                               INGOIATO dal pulsante — l'utente incolla, preme, e non succede
                               niente (successo davvero, 2026-08-01). *@
                            <input type="password" class="form-control form-control-sm" autocomplete="off"
                                   placeholder="incolla qui la chiave e premi Salva"
                                   @bind="_keyInputs[p]" @bind:event="oninput" />
                        </td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-primary me-1" @onclick="() => SaveKeyAsync(p)"
                                    disabled="@_busy">Salva</button>
                            @if (KeyStore.GetCachedSource(p) == AiKeySource.Database)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveKeyAsync(p)" disabled="@_busy">Rimuovi</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-outline-primary" @onclick="TestNowAsync" disabled="@_busy">
                @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                Prova collegamento (@_provider · @(ActiveModel))
            </button>
            <span class="text-muted small">Una chiamata vera al provider attivo: la risposta (o l'errore, testuale) compare qui sotto.</span>
        </div>
        @if (_testResult is not null)
        {
            <div class="alert @(_testIsError ? "alert-danger" : "alert-success") py-2 mt-2 mb-0" style="white-space: pre-wrap;">@_testResult</div>
        }
    </div>
</div>

@* ---- Stato del layer (chiave, breaker, backlog) + azioni di recupero ---- *@
<div class="card mb-3">
    <div class="card-header"><i class="bi bi-heart-pulse me-1"></i>Stato del layer AI</div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            @* Il badge riporta il provider SALVATO (quello che serve davvero le chiamate), non la
               tendina locale: la differenza fra i due è esattamente ciò che ha confuso il primo
               collaudo. *@
            @if (LlmClient.IsConfigured)
            { <span class="badge bg-success">@LlmOptionsMonitor.CurrentValue.Provider: chiave presente · @LlmClient.Model</span> }
            else
            { <span class="badge bg-danger">@LlmOptionsMonitor.CurrentValue.Provider: chiave ASSENTE (pannello qui sopra)</span> }

            @if (_guard is { BreakerOpen: true })
            {
                <span class="badge bg-danger">
                    SOSPESO — @(_guard.LastFailureCause ?? "errori ripetuti")@(_guard.NextProbeUtc is not null ? $", riprovo alle {_guard.NextProbeUtc.Value.ToLocalTime():HH:mm}" : "")
                </span>
            }
            else
            {
                <span class="badge bg-success">operativo</span>
            }

            <span class="badge bg-light text-dark">advisory ok: @_okCount</span>
            <span class="badge @(_errorCount > 0 ? "bg-warning text-dark" : "bg-light text-dark")">in errore: @_errorCount</span>
            <span class="badge @(_pendingRuns > 0 ? "text-bg-info" : "bg-light text-dark")">run in attesa (7 gg): @_pendingRuns</span>
        </div>
        <p class="text-muted small mb-2">
            @if (_guard is { BreakerOpen: true })
            {
                <span>Ultimo errore: <em>@_guard.LastFailureMessage</em>. Il ripristino è automatico (probe periodico);
                "Riprova adesso" forza un tentativo subito — utile appena risolta la causa (es. credito API ricaricato).</span>
            }
            else
            {
                <span>Ultimo tentativo: @FormatTs(_guard?.LastAttemptUtc) · ultimo successo: @FormatTs(_guard?.LastSuccessUtc).</span>
            }
        </p>
        @if (!string.IsNullOrEmpty(_actionStatus))
        {
            <div class="alert @(_actionIsError ? "alert-danger" : "alert-success") py-2">@_actionStatus</div>
        }
        <button class="btn btn-outline-secondary me-2" @onclick="LoadAsync" disabled="@_busy">Aggiorna</button>
        <button class="btn btn-primary me-2" @onclick="RetryNowAsync" disabled="@_busy">
            @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
            Riprova adesso
        </button>
        <button class="btn btn-outline-warning" @onclick="ReanalyzeErrorsAsync" disabled="@(_busy || _errorCount == 0)"
                title="Elimina gli advisory in errore dei run degli ultimi 7 giorni: verranno rianalizzati dal ciclo automatico.">
            Rianalizza advisory in errore
        </button>
    </div>
</div>

@if (_items is null)
{
    <p><em>Caricamento…</em></p>
}
else if (_items.Count == 0)
{
    <p><em>Nessun parere AI ancora prodotto. Compaiono qui dopo il completamento di un run del pipeline (con il layer AI abilitato).</em></p>
}
else
{
    @foreach (var item in _items)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-robot me-1"></i>Run <code>@item.RunId.ToString()[..8]</code>
                    <span class="badge @ConfidenceClass(item.Advisory.Confidence) ms-2">confidenza @item.Advisory.Confidence</span>
                    @if (item.Advisory.IsError)
                    {
                        <span class="badge bg-danger ms-1">errore</span>
                    }
                </span>
                <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @item.Advisory.ModelUsed</small>
            </div>
            <div class="card-body">
                <p style="white-space: pre-wrap;">@item.Advisory.Summary</p>

                @if (item.Advisory.ParameterSuggestions.Count > 0)
                {
                    <h6 class="mt-3">Aggiustamenti proposti (da valutare, non applicati)</h6>
                    <table class="table table-sm table-striped mb-0">
                        <thead class="table-light">
                            <tr><th>Parametro</th><th>Attuale/osservato</th><th>Proposto</th><th>Motivazione</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in item.Advisory.ParameterSuggestions)
                            {
                                <tr>
                                    <td><code>@s.Parameter</code></td>
                                    <td>@s.CurrentOrObserved</td>
                                    <td><strong>@s.Suggested</strong></td>
                                    <td>@s.Rationale</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (item.Advisory.DecisionsForUser.Count > 0)
                {
                    <h6 class="mt-3">Decisioni che richiedono la tua conferma</h6>
                    <ul class="mb-0">
                        @foreach (var d in item.Advisory.DecisionsForUser)
                        {
                            <li>@d</li>
                        }
                    </ul>
                }

                @* [Fase C] Il secondo parere dello stesso run, affiancato — mai al posto. *@
                @if (_comparisons.TryGetValue(item.RunId, out var second))
                {
                    <div class="border rounded p-3 mt-3 bg-light-subtle">
                        <h6 class="mb-2">
                            <i class="bi bi-people me-1"></i>Secondo parere
                            <span class="badge @ConfidenceClass(second.Advisory.Confidence) ms-2">confidenza @second.Advisory.Confidence</span>
                            <small class="text-muted ms-2">@second.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @second.Advisory.ModelUsed</small>
                        </h6>
                        <p style="white-space: pre-wrap;" class="mb-2">@second.Advisory.Summary</p>
                        @if (second.Advisory.ParameterSuggestions.Count > 0)
                        {
                            <table class="table table-sm table-striped mb-2">
                                <thead class="table-light">
                                    <tr><th>Parametro</th><th>Attuale/osservato</th><th>Proposto</th><th>Motivazione</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in second.Advisory.ParameterSuggestions)
                                    {
                                        <tr>
                                            <td><code>@s.Parameter</code></td>
                                            <td>@s.CurrentOrObserved</td>
                                            <td><strong>@s.Suggested</strong></td>
                                            <td>@s.Rationale</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        @if (second.Advisory.DecisionsForUser.Count > 0)
                        {
                            <ul class="mb-0">
                                @foreach (var d in second.Advisory.DecisionsForUser)
                                {
                                    <li>@d</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private sealed record AdvisoryItem(Guid RunId, DateTime CreatedAt, SupervisorAdvisory Advisory);

    private List<AdvisoryItem>? _items;
    private Dictionary<Guid, AdvisoryItem> _comparisons = new();
    private LlmGuardStatus? _guard;
    private int _okCount;
    private int _errorCount;
    private int _pendingRuns;
    private bool _busy;
    private bool _actionIsError;
    private string? _actionStatus;

    // ---- [Multi-provider] provider, modelli, chiavi, prova collegamento ----
    private string _provider = AiProviders.Anthropic;
    private readonly Dictionary<string, string> _models =
        AiProviders.Known.ToDictionary(p => p, _ => string.Empty);
    private bool _comparisonEnabled;
    private string _comparisonProvider = AiProviders.Nvidia;
    private readonly Dictionary<string, string> _keyInputs =
        AiProviders.Known.ToDictionary(p => p, _ => string.Empty);
    private string? _testResult;
    private bool _testIsError;

    // [Elenco modelli] catalogo per provider scaricato dall'API con la SUA chiave.
    private readonly Dictionary<string, IReadOnlyList<string>> _modelCatalog = new();
    private string? _fetchingModels;
    private bool _catalogIsError;
    private string? _catalogStatus;

    private string ActiveModel => _models.GetValueOrDefault(_provider, "");

    /// <summary>
    /// Scarica dall'API del provider l'elenco dei modelli disponibili per la SUA chiave e lo
    /// aggancia al campo modello (datalist). È il rimedio strutturale al caso Gemini del
    /// 2026-08-02: i nomi dei modelli invecchiano, l'elenco della propria chiave no.
    /// </summary>
    private async Task FetchModelsAsync(string provider)
    {
        _fetchingModels = provider; _catalogIsError = false; _catalogStatus = null;
        try
        {
            if (ClientResolver.Resolve(provider) is not IModelCatalogProvider catalogProvider)
            {
                _catalogIsError = true;
                _catalogStatus = $"Il provider {provider} non espone un elenco modelli.";
                return;
            }
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            var models = await catalogProvider.ListModelsAsync(cts.Token);
            _modelCatalog[provider] = models;
            _catalogStatus = models.Count == 0
                ? $"{provider}: l'API ha risposto con un elenco vuoto."
                : $"{provider}: {models.Count} modelli disponibili per la tua chiave — il campo ora li suggerisce mentre scrivi (freccia giù per sfogliarli).";
            if (models.Count > 0 && !models.Contains(_models[provider], StringComparer.OrdinalIgnoreCase))
            {
                _catalogStatus += $"\nATTENZIONE: il modello attuale «{_models[provider]}» NON è nell'elenco: sceglierne uno valido prima di salvare.";
            }
        }
        catch (Exception ex)
        {
            _catalogIsError = true;
            _catalogStatus = $"Elenco modelli {provider} non scaricabile: {ex.Message}";
        }
        finally { _fetchingModels = null; }
    }

    /// <summary>Il modello del provider dentro LlmOptions (campi piatti, stile NvidiaModel).</summary>
    private static string GetModelFor(LlmOptions o, string provider) => provider switch
    {
        AiProviders.Nvidia => o.NvidiaModel,
        AiProviders.Gemini => o.GeminiModel,
        AiProviders.Groq => o.GroqModel,
        AiProviders.HuggingFace => o.HuggingFaceModel,
        _ => o.Model,
    };

    private static void SetModelFor(LlmOptions o, string provider, string value)
    {
        switch (provider)
        {
            case AiProviders.Nvidia: o.NvidiaModel = value; break;
            case AiProviders.Gemini: o.GeminiModel = value; break;
            case AiProviders.Groq: o.GroqModel = value; break;
            case AiProviders.HuggingFace: o.HuggingFaceModel = value; break;
            default: o.Model = value; break;
        }
    }

    private static string ModelPlaceholder(string provider) => provider switch
    {
        AiProviders.Nvidia => "es. meta/llama-3.3-70b-instruct",
        AiProviders.Gemini => "es. models/gemini-3.6-flash",
        AiProviders.Groq => "es. llama-3.3-70b-versatile",
        AiProviders.HuggingFace => "es. meta-llama/Llama-3.3-70B-Instruct",
        _ => "es. claude-opus-4-8",
    };

    protected override async Task OnInitializedAsync()
    {
        var opt = LlmOptionsMonitor.CurrentValue;
        _provider = opt.Provider;
        foreach (var p in AiProviders.Known)
        {
            _models[p] = GetModelFor(opt, p);
        }
        _comparisonEnabled = opt.ComparisonEnabled;
        _comparisonProvider = opt.ComparisonProvider;
        await KeyStore.ReloadAsync();   // le fonti mostrate devono essere quelle VERE, non la cache di un processo vecchio
        await LoadAsync();
    }

    private async Task SaveProviderAsync()
    {
        _busy = true; _actionIsError = false; _actionStatus = null;
        try
        {
            // Clone VERO (roundtrip JSON) e non mutazione dell'istanza del monitor: SaveSectionAsync
            // riscrive l'intera sezione Llm, e perdere Enabled/soglie del breaker per strada sarebbe
            // il classico pannello che rompe ciò che non mostra; il roundtrip porta con sé anche i
            // campi futuri senza doverli elencare qui.
            var current = JsonSerializer.Deserialize<LlmOptions>(
                JsonSerializer.Serialize(LlmOptionsMonitor.CurrentValue))!;
            current.Provider = _provider;
            foreach (var p in AiProviders.Known)
            {
                SetModelFor(current, p, _models[p]);
            }
            current.ComparisonEnabled = _comparisonEnabled;
            current.ComparisonProvider = _comparisonProvider;
            await ConfigWriter.SaveSectionAsync("Llm", current);
            _actionStatus = $"Provider attivo: {_provider}" +
                            (_comparisonEnabled ? $" · secondo parere: {_comparisonProvider}" : " · secondo parere: off") +
                            ". Effetto alla prossima chiamata (hot-reload, ~1s).";
        }
        catch (Exception ex)
        {
            _actionIsError = true;
            _actionStatus = $"Salvataggio fallito: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task SaveKeyAsync(string provider)
    {
        if (string.IsNullOrWhiteSpace(_keyInputs[provider]))
        {
            _actionIsError = true;
            _actionStatus = $"Nessuna chiave nel campo {provider}: incollala e premi di nuovo Salva.";
            return;
        }
        _busy = true; _actionIsError = false; _actionStatus = null;
        try
        {
            await KeyStore.SetKeyAsync(provider, _keyInputs[provider].Trim());
            _keyInputs[provider] = string.Empty;   // mai trattenere la chiave nel circuito più del necessario
            _actionStatus = $"Chiave {provider} salvata (cifrata a riposo).";
        }
        catch (Exception ex)
        {
            _actionIsError = true;
            _actionStatus = $"Salvataggio chiave fallito: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task RemoveKeyAsync(string provider)
    {
        _busy = true; _actionIsError = false; _actionStatus = null;
        try
        {
            await KeyStore.RemoveKeyAsync(provider);
            _actionStatus = $"Chiave {provider} rimossa dal database (vale l'eventuale variabile d'ambiente).";
        }
        catch (Exception ex)
        {
            _actionIsError = true;
            _actionStatus = $"Rimozione fallita: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task TestNowAsync()
    {
        _busy = true; _testResult = null; _testIsError = false;
        try
        {
            // PRIMA si allinea la configurazione salvata a ciò che il pannello MOSTRA: il primo
            // collaudo dal vivo (2026-08-01) è partito con la tendina su Nvidia e la config ancora
            // su Anthropic — il test diceva Nvidia e chiamava Anthropic. Ciò che vedi è ciò che
            // viene provato, o il pulsante mente.
            var saved = LlmOptionsMonitor.CurrentValue;
            if (saved.Provider != _provider || AiProviders.Known.Any(p => GetModelFor(saved, p) != _models[p]))
            {
                var toWrite = JsonSerializer.Deserialize<LlmOptions>(JsonSerializer.Serialize(saved))!;
                toWrite.Provider = _provider;
                foreach (var p in AiProviders.Known)
                {
                    SetModelFor(toWrite, p, _models[p]);
                }
                await ConfigWriter.SaveSectionAsync("Llm", toWrite);

                // reloadOnChange impiega ~1s: si attende che le opzioni vive combacino, con un
                // tetto — se non arrivano si prosegue e l'esito lo dirà (mai un'attesa infinita).
                for (var i = 0; i < 20 && LlmOptionsMonitor.CurrentValue.Provider != _provider; i++)
                {
                    await Task.Delay(200);
                }
            }

            // Una chiamata VERA al provider attivo (via DelegatingLlmClient): è il pulsante che
            // chiede al canale se funziona — la lezione del token Telegram (2026-07-29).
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(90));
            var reply = await LlmClient.CompleteAsync(
                "Sei il test di collegamento di una piattaforma di trading. Rispondi in una sola riga.",
                $"Conferma il collegamento indicando il tuo nome modello. Ora UTC: {DateTime.UtcNow:u}.",
                cts.Token);
            _testResult = $"✔ {LlmClient.Model} ha risposto:\n{reply.Trim()}";
        }
        catch (Exception ex)
        {
            _testIsError = true;
            _testResult = $"✘ Collegamento fallito ({_provider} · {ActiveModel}):\n{ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task LoadAsync()
    {
        _busy = true;
        try
        {
            _guard = Guard.GetStatus();

            await using var db = await DbFactory.CreateDbContextAsync();
            var rows = await db.PipelineArtifacts
                .Where(a => a.Kind == LlmArtifactKinds.Advisory)
                .OrderByDescending(a => a.CreatedAt)
                .Take(50)
                .Select(a => new { a.RunId, a.CreatedAt, a.PayloadJson })
                .ToListAsync();

            _items = rows.Select(r =>
            {
                SupervisorAdvisory adv;
                try { adv = JsonSerializer.Deserialize<SupervisorAdvisory>(r.PayloadJson) ?? new(); }
                catch { adv = new SupervisorAdvisory { IsError = true, Summary = "Advisory non leggibile." }; }
                return new AdvisoryItem(r.RunId, r.CreatedAt, adv);
            }).ToList();

            // [Fase C] I secondi pareri degli stessi run, per l'affiancamento nelle card.
            var runIds = _items.Select(i => i.RunId).ToList();
            var comparisonRows = await db.PipelineArtifacts
                .Where(a => a.Kind == LlmArtifactKinds.AdvisoryComparison && runIds.Contains(a.RunId))
                .Select(a => new { a.RunId, a.CreatedAt, a.PayloadJson })
                .ToListAsync();
            _comparisons = comparisonRows
                .Select(r =>
                {
                    SupervisorAdvisory adv;
                    try { adv = JsonSerializer.Deserialize<SupervisorAdvisory>(r.PayloadJson) ?? new(); }
                    catch { adv = new SupervisorAdvisory { IsError = true, Summary = "Secondo parere non leggibile." }; }
                    return new AdvisoryItem(r.RunId, r.CreatedAt, adv);
                })
                .GroupBy(i => i.RunId)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(i => i.CreatedAt).First());

            _okCount = _items.Count(i => !i.Advisory.IsError);
            _errorCount = _items.Count(i => i.Advisory.IsError);

            // Stessa anti-join del worker: run completati recenti ancora senza advisory.
            var since = DateTime.UtcNow.AddDays(-7);
            _pendingRuns = await db.PipelineRuns
                .Where(r => r.Status == "Completed" && r.CompletedAt != null && r.CompletedAt >= since)
                .Where(r => !db.PipelineArtifacts.Any(a => a.RunId == r.Id && a.Kind == LlmArtifactKinds.Advisory))
                .CountAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RetryNowAsync()
    {
        _busy = true; _actionIsError = false; _actionStatus = null;
        try
        {
            await LlmWorker.TickAsync(CancellationToken.None, forceProbe: true);
            _actionStatus = "Tentativo eseguito (cooldown del breaker ignorato). Stato e advisory aggiornati qui sotto.";
        }
        catch (Exception ex)
        {
            _actionIsError = true;
            _actionStatus = $"Tentativo fallito: {ex.Message}";
        }
        finally { _busy = false; }
        await LoadAsync();
    }

    private async Task ReanalyzeErrorsAsync()
    {
        _busy = true; _actionIsError = false; _actionStatus = null;
        try
        {
            var deleted = await Supervisor.DeleteErrorAdvisoriesAsync(DateTime.UtcNow.AddDays(-7), CancellationToken.None);
            _actionStatus = deleted == 0
                ? "Nessun advisory in errore nella finestra di 7 giorni."
                : $"Eliminati {deleted} advisory in errore: i run verranno rianalizzati dal ciclo automatico (≤5 per tick), o subito con \"Riprova adesso\".";
        }
        catch (Exception ex)
        {
            _actionIsError = true;
            _actionStatus = $"Pulizia fallita: {ex.Message}";
        }
        finally { _busy = false; }
        await LoadAsync();
    }

    private static string FormatTs(DateTimeOffset? ts)
        => ts is null ? "mai" : ts.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm");

    private static string ConfidenceClass(string c) => c switch
    {
        "alta" => "bg-success",
        "bassa" => "bg-secondary",
        _ => "bg-info",
    };
}
