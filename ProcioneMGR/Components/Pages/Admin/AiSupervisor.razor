    /// <summary>[AF3] Salva la sezione Committee (validata dalle stesse regole del canale admin).</summary>
    /// <summary>
    /// [I8] La domanda sintetica a menù chiuso che il comitato non riceverà mai dalla flotta.
    ///
    /// <para>Il comitato è rimasto acceso sedici giorni senza emettere un voto: arbitra i
    /// <em>pareggi</em> di <c>Decide</c>, e la coda dell'orchestratore è sempre vuota. Senza questo
    /// pulsante «funziona?» non aveva risposta se non aspettando un pareggio che potrebbe non
    /// arrivare mai — e una verifica che si può fare solo quando serve non è una verifica.</para>
    ///
    /// <para><b>Non tocca la flotta</b>: nessuna assegnazione, nessuna riga di journal. Passa dallo
    /// stesso guard, dallo stesso budget e dallo stesso contratto dei giri veri, altrimenti
    /// dimostrerebbe qualcosa di diverso da ciò che succede in produzione.</para>
    /// </summary>
    private async Task ProbeCommitteeAsync()
    {
        _busy = true;
        _committeeProbe = null;
        try
        {
            // Si legge lo stato IN VIGORE, non i campi del form: il pulsante deve provare il
            // comitato che gira adesso, non quello che si sta per salvare.
            if (!CommitteeMonitor.CurrentValue.Enabled)
            {
                _committeeStatus = "Comitato SPENTO (Committee:Enabled = false): nessuna chiamata effettuata.";
                _committeeIsError = true;
                return;
            }

            var domanda = new ProcioneMGR.Services.Llm.Committee.CommitteeQuestion(
                "probe",
                "Verifica di funzionamento del comitato. Nessuna corsia è coinvolta e nessuna decisione "
                + "operativa dipende da questa risposta: serve solo a sapere se i provider rispondono "
                + "dentro il menù. Scegli l'opzione B.",
                [
                    new ProcioneMGR.Services.Llm.Committee.CommitteeOption("A", "Opzione A (di prova)"),
                    new ProcioneMGR.Services.Llm.Committee.CommitteeOption("B", "Opzione B (di prova)"),
                ],
                "A"); // default deterministico: se nessuno risponde validamente, esce A

            var verdetto = await Committee.AskAsync(domanda);
            _committeeProbe = verdetto;

            var validi = verdetto.Votes.Count(v => v.Valid);
            _committeeStatus = verdetto.Votes.Count == 0
                ? "Nessun provider interrogato: budget esaurito o nessun provider votante con chiave. Il comitato NON è verificato."
                : $"{validi} voti validi su {verdetto.Votes.Count} provider interrogati.";
            // Zero voti validi è un guasto del canale, non un esito: va colorato come tale.
            _committeeIsError = verdetto.Votes.Count == 0 || validi == 0;
        }
        catch (Exception ex)
        {
            _committeeStatus = $"Prova fallita: {ex.Message}";
            _committeeIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveCommitteeAsync()
