@page "/admin/ai-supervisor"
@rendermode InteractiveServer
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ProcioneMGR.Data
@using ProcioneMGR.Services.Llm
@using ProcioneMGR.Services.Pipeline
@attribute [Authorize(Roles = $"{AppRoles.Admin},{AppRoles.Manager}")]

@using Microsoft.Extensions.Options
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ILlmClient LlmClient
@inject ILlmCallGuard Guard
@inject IPipelineSupervisor Supervisor
@inject LlmSupervisorWorker LlmWorker
@inject IAiKeyStore KeyStore
@inject IOptionsMonitor<LlmOptions> LlmOptionsMonitor
@inject ILlmClientResolver ClientResolver
@inject ProcioneMGR.Services.Config.IAppConfigWriter ConfigWriter
@inject ILlmUsageSink UsageSink
@inject IOptionsMonitor<LlmBudgetOptions> BudgetMonitor
@inject IOptionsMonitor<ProcioneMGR.Services.Llm.Committee.CommitteeOptions> CommitteeMonitor
@* [I8] Il comitato vero, per il pulsante «Prova»: stesso guard, stesso budget, stesso contratto dei
   giri reali — provarne una copia dimostrerebbe qualcosa di diverso da cio' che succede in produzione. *@
@inject ProcioneMGR.Services.Llm.Committee.IAiCommittee Committee
@inject ProcioneMGR.Services.Llm.Narration.IRejectionExplainService RejectionExplain
@inject ProcioneMGR.Services.Llm.Narration.IPostMortemService PostMortems
@inject IOptionsMonitor<ProcioneMGR.Services.Llm.Narration.PostMortemOptions> PostMortemMonitor

<PageTitle>Supervisione AI</PageTitle>

<h1>Supervisione AI del ciclo di ricerca</h1>

<GuidaPanel Title="Supervisione AI — un consulente sulle cacce, non un esecutore">
    <p>
        A ogni run del pipeline concluso, un agente AR (Claude) legge la <code>PipelineRecommendation</code>
        prodotta dal motore e scrive un <strong>parere leggibile</strong>: un riepilogo, eventuali
        aggiustamenti proposti ai parametri di caccia, e le decisioni che richiedono la tua
        <strong>conferma esplicita</strong>.
    </p>
    <p class="mb-0">
        <strong>Confine di sicurezza (non negoziabile):</strong> l'AI è <em>solo advisory</em>. Non può
        avviare il trading live, non può bypassare i controlli di sicurezza (<code>SafetyChecker</code>),
        non apre posizioni. I suoi suggerimenti sui parametri sono spunti da valutare, mai comandi
        applicati in automatico. Il layer è attivo solo se <code>Llm:Enabled=true</code> e il provider
        attivo ha una chiave (inserita qui sotto, cifrata a riposo, o via variabile d'ambiente).
    </p>
</GuidaPanel>

@* ---- [Multi-provider 2026-08] Provider attivo, modelli e chiavi ---- *@
<div class="card mb-3">
    <div class="card-header"><i class="bi bi-key me-1"></i>Provider e chiavi</div>
    <div class="card-body">
        <p class="text-muted small">
            Il provider scelto qui serve OGNI chiamata del layer AI (hot-reload: effetto alla chiamata
            successiva, senza riavvio). Le chiavi sono cifrate a riposo (AES-256-GCM, stessa cifratura
            delle credenziali exchange); in assenza di chiave a database vale la variabile d'ambiente
            del provider. La chiave non viene mai rimostrata: solo la sua fonte.
        </p>
        @* ---- Riga principale: UNA AI, il SUO modello (auto), prova, salva. ---- *@
        <div class="row g-3 align-items-end mb-1">
            <div class="col-auto">
                <label class="form-label mb-0">AI attiva</label>
                <select class="form-select" @bind="_provider">
                    @foreach (var p in AiProviders.Known)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-0">
                    Modello
                    @if (_autoLoadingModels)
                    { <span class="spinner-border spinner-border-sm ms-1" title="scarico gli elenchi modelli dalle API"></span> }
                    else if (_modelCatalog.TryGetValue(_provider, out var activeCatalog) && activeCatalog.Count > 0)
                    { <span class="badge bg-light text-dark ms-1" title="modelli disponibili per la TUA chiave (freccia giù nel campo per sfogliarli)">@activeCatalog.Count disponibili</span> }
                </label>
                <input class="form-control" style="min-width: 19rem" list="models-@_provider"
                       @bind="_models[_provider]" placeholder="@ModelPlaceholder(_provider)" />
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-primary" @onclick="TestNowAsync" disabled="@_busy">
                    @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Prova collegamento
                </button>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="SaveProviderAsync" disabled="@_busy">Salva</button>
            </div>
        </div>
        <p class="text-muted small mb-2">
            Gli elenchi modelli si scaricano DA SOLI all'apertura (per le AI con una chiave) e il
            modello viene scelto in automatico se manca o non è più valido — puoi sempre cambiarlo
            dal campo. In caso di errore su una chiamata, la piattaforma passa da sola alla
            prossima AI: <strong>@FailoverChainText</strong>.
        </p>
        @foreach (var p in AiProviders.Known)
        {
            <datalist id="models-@p">
                @if (_modelCatalog.TryGetValue(p, out var list))
                {
                    @foreach (var m in list)
                    { <option value="@m"></option> }
                }
            </datalist>
        }
        @if (!string.IsNullOrEmpty(_catalogStatus))
        {
            <div class="alert @(_catalogIsError ? "alert-danger" : "alert-info") py-2 mb-2" style="white-space: pre-wrap;">@_catalogStatus</div>
        }
        @if (_testResult is not null)
        {
            <div class="alert @(_testIsError ? "alert-danger" : "alert-success") py-2 mb-2" style="white-space: pre-wrap;">@_testResult</div>
        }

        @* [Fase C] Secondo parere: stesso run, provider diverso, artifact separato. *@
        <div class="row g-3 align-items-end mb-3">
            <div class="col-auto form-check ms-2">
                <input class="form-check-input" type="checkbox" id="cmpEnabled" @bind="_comparisonEnabled" />
                <label class="form-check-label" for="cmpEnabled">
                    Secondo parere per ogni run
                    <span class="text-muted small">(chiede la stessa analisi anche al provider qui accanto: raddoppia il costo per run; best-effort — se fallisce, il run resta con un parere solo)</span>
                </label>
            </div>
            <div class="col-auto">
                <label class="form-label mb-0">Provider del secondo parere</label>
                <select class="form-select" @bind="_comparisonProvider">
                    @foreach (var p in AiProviders.Known)
                    {
                        <option value="@p">@p</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <span class="text-muted small">Si salva con «Salva provider/modelli». Se coincide col provider attivo, il confronto si salta da solo.</span>
            </div>
        </div>

        <table class="table table-sm align-middle mb-3" style="max-width: 60rem">
            <thead class="table-light"><tr><th>Provider</th><th>Fonte chiave</th><th>Nuova chiave</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in AiProviders.Known)
                {
                    <tr>
                        <td><strong>@p</strong></td>
                        <td>
                            @switch (KeyStore.GetCachedSource(p))
                            {
                                case AiKeySource.Database:
                                    <span class="badge bg-success">a database (cifrata)</span>
                                    break;
                                case AiKeySource.Environment:
                                    <span class="badge bg-info text-dark">variabile d'ambiente (@AiProviders.EnvVarFor(p))</span>
                                    break;
                                default:
                                    <span class="badge bg-danger">assente</span>
                                    break;
                            }
                        </td>
                        <td style="min-width: 22rem">
                            @* oninput e non il default onchange: col default il valore si committa
                               solo al blur, e il click su un Salva ancora disabilitato viene
                               INGOIATO dal pulsante — l'utente incolla, preme, e non succede
                               niente (successo davvero, 2026-08-01). *@
                            <input type="password" class="form-control form-control-sm" autocomplete="off"
                                   placeholder="incolla qui la chiave e premi Salva"
                                   @bind="_keyInputs[p]" @bind:event="oninput" />
                        </td>
                        <td class="text-nowrap">
                            <button class="btn btn-sm btn-primary me-1" @onclick="() => SaveKeyAsync(p)"
                                    disabled="@_busy">Salva</button>
                            @if (KeyStore.GetCachedSource(p) == AiKeySource.Database)
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveKeyAsync(p)" disabled="@_busy">Rimuovi</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <details class="mt-2">
            <summary class="text-muted">Modelli per AI (avanzate) — un campo per provider, con aggiornamento manuale dell'elenco</summary>
            <div class="row g-3 align-items-end mt-1">
                @foreach (var p in AiProviders.Known)
                {
                    <div class="col-auto">
                        <label class="form-label mb-0">
                            @p
                            @if (_modelCatalog.TryGetValue(p, out var catalog) && catalog.Count > 0)
                            { <span class="badge bg-light text-dark ms-1">@catalog.Count</span> }
                        </label>
                        <div class="input-group" style="min-width: 17rem">
                            <input class="form-control form-control-sm" list="models-@p" @bind="_models[p]"
                                   placeholder="@ModelPlaceholder(p)" />
                            <button class="btn btn-sm btn-outline-secondary" title="Aggiorna l'elenco modelli per la chiave di @p"
                                    @onclick="() => FetchModelsAsync(p)" disabled="@(_fetchingModels == p)">
                                @if (_fetchingModels == p)
                                { <span class="spinner-border spinner-border-sm"></span> }
                                else
                                { <i class="bi bi-arrow-clockwise"></i> }
                            </button>
                        </div>
                    </div>
                }
            </div>
            <p class="text-muted small mt-1 mb-0">Si salvano tutti insieme col pulsante «Salva» qui sopra.</p>
        </details>
    </div>
</div>

@* ---- Stato del layer (chiave, breaker, backlog) + azioni di recupero ---- *@
<div class="card mb-3">
    <div class="card-header"><i class="bi bi-heart-pulse me-1"></i>Stato del layer AI</div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            @* Il badge riporta il provider SALVATO (quello che serve davvero le chiamate), non la
               tendina locale: la differenza fra i due è esattamente ciò che ha confuso il primo
               collaudo. *@
            @if (LlmClient.IsConfigured)
            { <span class="badge bg-success">@LlmOptionsMonitor.CurrentValue.Provider: chiave presente · @LlmClient.Model</span> }
            else
            { <span class="badge bg-danger">@LlmOptionsMonitor.CurrentValue.Provider: chiave ASSENTE (pannello qui sopra)</span> }

            @if (_guard is { BreakerOpen: true })
            {
                <span class="badge bg-danger">
                    SOSPESO — @(_guard.LastFailureCause ?? "errori ripetuti")@(_guard.NextProbeUtc is not null ? $", riprovo alle {_guard.NextProbeUtc.Value.ToLocalTime():HH:mm}" : "")
                </span>
            }
            else
            {
                <span class="badge bg-success">operativo</span>
            }

            <span class="badge bg-light text-dark">advisory ok: @_okCount</span>
            <span class="badge @(_errorCount > 0 ? "bg-warning text-dark" : "bg-light text-dark")">in errore: @_errorCount</span>
            <span class="badge @(_pendingRuns > 0 ? "text-bg-info" : "bg-light text-dark")">run in attesa (7 gg): @_pendingRuns</span>
        </div>
        <p class="text-muted small mb-2">
            @if (_guard is { BreakerOpen: true })
            {
                <span>Ultimo errore: <em>@_guard.LastFailureMessage</em>. Il ripristino è automatico (probe periodico);
                "Riprova adesso" forza un tentativo subito — utile appena risolta la causa (es. credito API ricaricato).</span>
            }
            else
            {
                <span>Ultimo tentativo: @FormatTs(_guard?.LastAttemptUtc) · ultimo successo: @FormatTs(_guard?.LastSuccessUtc).</span>
            }
        </p>
        @if (!string.IsNullOrEmpty(_actionStatus))
        {
            <div class="alert @(_actionIsError ? "alert-danger" : "alert-success") py-2">@_actionStatus</div>
        }
        <button class="btn btn-outline-secondary me-2" @onclick="LoadAsync" disabled="@_busy">Aggiorna</button>
        <button class="btn btn-primary me-2" @onclick="RetryNowAsync" disabled="@_busy">
            @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
            Riprova adesso
        </button>
        <button class="btn btn-outline-warning" @onclick="ReanalyzeErrorsAsync" disabled="@(_busy || _errorCount == 0)"
                title="Elimina gli advisory in errore dei run degli ultimi 7 giorni: verranno rianalizzati dal ciclo automatico.">
            Rianalizza advisory in errore
        </button>
    </div>
</div>

@* ---- [AF1] Consumo e budget: quanto si è speso, e il freno al cost runaway ---- *@
<div class="card mb-3">
    <div class="card-header"><i class="bi bi-cash-coin me-1"></i>Consumo e budget</div>
    <div class="card-body">
        <p class="text-muted small">
            Ogni chiamata AI dichiara i token consumati, attribuiti al provider che l'ha
            <strong>davvero servita</strong> (col failover può non essere quello attivo). A budget
            esaurito le chiamate si sospendono <em>senza</em> toccare il breaker dei guasti e
            riprendono da sole al reset (mezzanotte UTC per i tetti giornalieri). 0 = nessun tetto.
        </p>
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            @if (_usage is { TrackingEnabled: true })
            {
                <span class="badge bg-success">conteggio attivo</span>
                <span class="badge bg-light text-dark">oggi: @_usage.TodayCalls chiamate · @_usage.TodayTokens token</span>
                <span class="badge bg-light text-dark">mese: @_usage.MonthTokens token</span>
                @if (NoCeilingInForce)
                {
                    <span class="badge bg-warning text-dark">NESSUN TETTO IN VIGORE</span>
                }
                @if (_budgetVerdict is { Exhausted: true })
                {
                    <span class="badge bg-warning text-dark">BUDGET ESAURITO — @_budgetVerdict.Reason</span>
                }
            }
            else
            {
                <span class="badge bg-secondary">conteggio spento — nessun conteggio, nessun tetto</span>
            }
        </div>

        @* [I3] «Conteggio attivo» si legge come «la spesa è sorvegliata», e con i tre limiti a zero
           non lo è: il controllo che ogni chiamata esegue prima di partire risponde SEMPRE sì
           (LlmUsage.CheckBudget salta ogni limite non positivo). È la classe «controllo che
           rassicura», e questo blocco è il suo rimedio: dice che non c'è tetto, e dà i numeri per
           sceglierne uno invece di lasciare l'operatore a indovinare. *@
        @if (_usage is { TrackingEnabled: true } && NoCeilingInForce)
        {
            <div class="alert alert-warning py-2 small">
                <strong>Il conteggio gira, ma non c'è alcun tetto.</strong> I tre limiti sono a
                <code>0</code>, e <strong>0 non è «zero»: è «nessun limite»</strong> — il controllo
                che precede ogni chiamata risponde sempre sì, e il budget non può esaurirsi.
                Conta perché il layer AI ha già smesso di funzionare una volta per credito esaurito
                <em>in silenzio</em>, e perché il comitato interroga più provider <em>per ogni</em>
                domanda: è il primo candidato alla spesa fuori controllo.
                <br />
                <strong>Per scegliere un numero</strong>, dai dati veri di questo processo: oggi
                <strong>@_usage.TodayCalls chiamate</strong> e @_usage.TodayTokens token; nel mese
                @_usage.MonthTokens token, cioè una media di circa
                <strong>@MonthlyAveragePerDay.ToString("N0") token al giorno</strong> sui
                @DaysElapsedThisMonth giorni trascorsi.
            </div>
        }
        @if (_usage is { TrackingEnabled: true, Today.Count: > 0 })
        {
            <div class="table-responsive mb-2">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Provider</th><th>Modello</th><th>Percorso</th><th class="text-end">Chiamate</th><th class="text-end">Token in</th><th class="text-end">Token out</th></tr></thead>
                    <tbody>
                        @foreach (var row in _usage.Today)
                        {
                            <tr>
                                <td>@row.Provider</td><td><code>@row.Model</code></td><td>@row.Path</td>
                                <td class="text-end">@row.Calls</td>
                                <td class="text-end">@row.PromptTokens</td>
                                <td class="text-end">@row.CompletionTokens</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted small mb-2">Solo i delta di oggi non ancora scritti a database; i totali nei badge comprendono anche il persistito.</p>
        }
        <div class="row g-2 align-items-end">
            <div class="col-auto form-check ms-2 mb-2">
                <input type="checkbox" class="form-check-input" id="budget-tracking" @bind="_budgetTracking" />
                <label class="form-check-label" for="budget-tracking">Conteggio attivo</label>
            </div>
            <div class="col-auto">
                <label class="form-label mb-0 small">Chiamate/giorno</label>
                <input type="number" class="form-control form-control-sm" style="width:8rem" min="0" @bind="_budgetDailyCalls" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-0 small">Token/giorno</label>
                <input type="number" class="form-control form-control-sm" style="width:8rem" min="0" @bind="_budgetDailyTokens" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-0 small">Token/mese</label>
                <input type="number" class="form-control form-control-sm" style="width:8rem" min="0" @bind="_budgetMonthlyTokens" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-primary" @onclick="SaveBudgetAsync" disabled="@_busy">Salva budget</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_budgetStatus))
        {
            <div class="alert @(_budgetIsError ? "alert-danger" : "alert-success") py-2 mt-2 mb-0">@_budgetStatus</div>
        }
    </div>
</div>

@* ---- [AF3] Comitato a scelta vincolata (sezione Committee) ---- *@
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-people me-1"></i>Comitato AI (scelta vincolata)</span>
        <span>
            @if (_committee.Enabled) { <span class="badge bg-success">ATTIVO</span> }
            else { <span class="badge bg-secondary">SPENTO</span> }
        </span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Sui <strong>pareggi</strong> dell'orchestratore di flotta (più candidati idonei per lo
            stesso slot Paper) i provider elencati votano <strong>in parallelo</strong> su un menù
            chiuso preparato dal codice: scelta fuori menù = astensione, quorum mancato = decide la
            regola deterministica. I voti finiscono nel journal della flotta. Serve anche
            l'interruttore «Comitato AI» nella card della flotta (/admin/autonomy). Il consumo
            passa dal budget qui sopra (path <code>committee</code>).
        </p>
        <div class="row g-2 align-items-end">
            <div class="col-auto form-check form-switch ms-2 mb-2">
                <input type="checkbox" class="form-check-input" id="committee-enabled" @bind="_committee.Enabled" />
                <label class="form-check-label" for="committee-enabled">Abilitato</label>
            </div>
            <div class="col-auto">
                <label class="form-label mb-0 small">Provider votanti (csv; vuoto = @string.Join(",", ProcioneMGR.Services.Llm.Committee.CommitteeOptions.DefaultProviders))</label>
                <input class="form-control form-control-sm" style="width:20rem" @bind="_committeeProvidersCsv" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-0 small">Quorum (voti validi)</label>
                <input type="number" class="form-control form-control-sm" style="width:6rem" min="1" @bind="_committee.MinValidVotes" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-0 small">Timeout voto (s)</label>
                <input type="number" class="form-control form-control-sm" style="width:6rem" min="5" @bind="_committee.TimeoutSeconds" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-primary me-2" @onclick="SaveCommitteeAsync" disabled="@_busy">Salva comitato</button>
                @* [I8] L'unico modo di sapere che il comitato funziona PRIMA che serva. Acceso da
                   sedici giorni, non ha mai votato — non per guasto, ma perché arbitra i pareggi e
                   la coda dell'orchestratore è sempre vuota. Senza questo pulsante, «funziona?» non
                   aveva risposta se non aspettando un pareggio che potrebbe non arrivare mai. *@
                <button class="btn btn-sm btn-outline-secondary" @onclick="ProbeCommitteeAsync" disabled="@_busy">
                    @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Prova il comitato
                </button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_committeeStatus))
        {
            <div class="alert @(_committeeIsError ? "alert-danger" : "alert-success") py-2 mt-2 mb-0">@_committeeStatus</div>
        }
        @* [I8] I voti REALI, provider per provider, con la causa di ogni astensione. Un comitato che
           vota senza che nessuno possa leggere il voto è «verde a livello di classe, inesistente a
           livello di prodotto». *@
        @if (_committeeProbe is { } probe)
        {
            <div class="mt-2">
                <div class="small mb-1">
                    Verdetto: <code>@probe.ChosenOptionId</code>
                    @if (probe.ByQuorum)
                    {
                        <span class="badge bg-success ms-1">per QUORUM</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary ms-1">default deterministico</span>
                        <span class="text-muted"> — la maggioranza non si è formata: è il comportamento previsto, non un guasto.</span>
                    }
                </div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead><tr><th>Provider</th><th>Voto</th><th>Confidenza</th><th>Motivo / causa dell'astensione</th></tr></thead>
                        <tbody>
                            @foreach (var v in probe.Votes)
                            {
                                <tr>
                                    <td>@v.Provider</td>
                                    <td>
                                        @if (v.Valid)
                                        {
                                            <span class="badge bg-primary">@v.OptionId</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">ASTENUTO</span>
                                        }
                                    </td>
                                    <td class="text-end">@(v.Confidence?.ToString("0.00") ?? "—")</td>
                                    <td class="small">@v.Reason</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="text-muted small mt-1 mb-0">
                    Domanda sintetica a menù chiuso: <strong>non tocca la flotta</strong>, non produce
                    assegnazioni e non entra nel journal delle decisioni. Consuma token veri sui
                    provider votanti, e passa dallo stesso budget del resto del layer AI.
                </p>
            </div>
        }
    </div>
</div>

@* ---- [G4] Post-mortem delle operazioni in perdita ---- *@
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-clipboard-pulse me-1"></i>Perché le operazioni sono andate male</span>
        <span>
            @if (_postMortem.Enabled && _postMortem.UseAi) { <span class="badge bg-success">ATTIVO CON AI</span> }
            else if (_postMortem.Enabled) { <span class="badge bg-info text-dark">SOLO CAUSE CALCOLABILI</span> }
            else { <span class="badge bg-secondary">SPENTO</span> }
        </span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Dopo ogni operazione chiusa in perdita oltre la soglia, la piattaforma registra i
            <strong>fatti</strong> (ingresso, uscita, durata, motivo, costi) e una
            <strong>causa scelta da un elenco chiuso</strong>. Dove la causa è aritmetica la
            calcola il codice e <strong>l'AI non viene nemmeno interpellata</strong>: è il caso di
            «costi che hanno mangiato il lordo» e della liquidazione forzata. Solo quando resta un
            dubbio si chiede all'AI, che può rispondere <em>soltanto</em> con una voce dell'elenco —
            qualunque altra cosa vale come nessuna risposta e la causa resta «inconcludente».
        </p>
        <p class="text-muted small mb-3">
            Il conteggio delle cause recenti di una corsia raggiunge il <strong>comitato</strong>
            quando deve scegliere su quella corsia: è contesto in più dentro il menù che già
            esiste, <strong>mai una scorciatoia che tocca un parametro da sola</strong>. Se questo
            pannello è spento, il comitato decide esattamente come prima.
        </p>

        <div class="row g-2 align-items-end mb-2">
            <div class="col-auto form-check form-switch ms-2 mb-2">
                <input type="checkbox" class="form-check-input" id="pm-enabled" @bind="_postMortem.Enabled" />
                <label class="form-check-label" for="pm-enabled">Registra i post-mortem</label>
            </div>
            <div class="col-auto form-check form-switch ms-2 mb-2">
                <input type="checkbox" class="form-check-input" id="pm-ai" @bind="_postMortem.UseAi" />
                <label class="form-check-label" for="pm-ai">Chiedi anche all'AI (costa)</label>
            </div>
            <div class="col-auto">
                <label class="form-label mb-0 small">Perdita oltre (%)</label>
                <input type="number" step="0.1" class="form-control form-control-sm" style="width:7rem" @bind="_postMortem.LossThresholdPercent" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-0 small">Max per giro</label>
                <input type="number" class="form-control form-control-sm" style="width:6rem" min="1" max="50" @bind="_postMortem.MaxPerRun" />
            </div>
            <div class="col-auto">
                <label class="form-label mb-0 small">Al comitato</label>
                <input type="number" class="form-control form-control-sm" style="width:6rem" min="0" max="50" @bind="_postMortem.CommitteeContextCount" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-primary" @onclick="SavePostMortemAsync" disabled="@_busy">Salva</button>
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-secondary" @onclick="RunPostMortemAsync" disabled="@_busy">
                    <i class="bi bi-play me-1"></i>Analizza adesso
                </button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_postMortemStatus))
        {
            <div class="alert @(_postMortemIsError ? "alert-danger" : "alert-success") py-2 mb-3">@_postMortemStatus</div>
        }

        @if (_postMortems is { Count: > 0 })
        {
            <table class="table table-sm table-striped mb-0">
                <thead class="table-light">
                    <tr><th>Quando</th><th>Corsia</th><th>Simbolo</th><th class="text-end">Perdita</th><th>Causa</th><th>Chi l'ha detto</th><th>Analisi</th></tr>
                </thead>
                <tbody>
                    @foreach (var pm in _postMortems)
                    {
                        <tr>
                            <td class="small">@pm.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            <td>@pm.LaneId</td>
                            <td><code>@pm.Symbol</code></td>
                            <td class="text-end text-danger">@pm.PnlPercent.ToString("F2")%</td>
                            <td>@ProcioneMGR.Services.Llm.Narration.PostMortemCauses.Label(pm.Cause)</td>
                            <td>
                                @switch (pm.Source)
                                {
                                    case "rules": <span class="badge bg-secondary" title="Causa aritmetica: nessuna AI interpellata.">codice</span> break;
                                    case "ai": <span class="badge bg-info text-dark" title="@pm.ModelUsed">AI</span> break;
                                    default: <span class="badge bg-light text-dark border" title="L'AI non ha risposto o è uscita dal menù: default deterministico.">default</span> break;
                                }
                            </td>
                            <td class="small fst-italic">@(string.IsNullOrWhiteSpace(pm.Narrative) ? "—" : pm.Narrative)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (_postMortems is not null)
        {
            <p class="text-muted mb-0"><em>Nessun post-mortem registrato. Compaiono qui dopo la prima operazione chiusa in perdita oltre la soglia, col pannello acceso.</em></p>
        }
    </div>
</div>

@* ---- [G6] Perché i candidati sono stati scartati ---- *@
<div class="card mb-3">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-funnel me-1"></i>Perché i candidati sono stati scartati</span>
        <span>
            @if (_explainEnabled) { <span class="badge bg-success">PROSA AUTOMATICA</span> }
            else { <span class="badge bg-secondary">SOLO NUMERI</span> }
        </span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Il <strong>riassunto per causa e i numeri</strong> qui sotto sono calcolati dal codice
            dai verdetti dei gate: <strong>non dipendono dall'AI</strong>, non costano nulla e si
            vedono anche col layer AI spento. L'interruttore riguarda solo le <em>parole</em>
            attorno a quei numeri: con la prosa automatica accesa, dopo ogni run il provider attivo
            scrive una spiegazione in italiano (path <code>explain</code>, passa dal budget qui
            sopra). Puoi comunque chiederla a mano run per run col pulsante «Spiega con l'AI».
        </p>
        <p class="text-muted small mb-3">
            I candidati di cui si parla sono <strong>già stati respinti e non sono mai stati
            schierati</strong>: non esiste un percorso per cui questo testo torni a toccare una
            decisione — ed è lì che sta la sicurezza, non nel fidarsi di ciò che l'AI scrive. Le
            note sono legate ai candidati per chiave e quelle riferite a candidati inesistenti
            vengono scartate: se succede, il conteggio è dichiarato accanto alla spiegazione.
        </p>

        <div class="row g-2 align-items-end mb-2">
            <div class="col-auto form-check form-switch ms-2 mb-2">
                <input type="checkbox" class="form-check-input" id="explain-enabled" @bind="_explainEnabled" />
                <label class="form-check-label" for="explain-enabled">Prosa automatica dopo ogni run</label>
            </div>
            <div class="col-auto">
                <label class="form-label mb-0 small">Bocciati riportati per esteso (1-20)</label>
                <input type="number" class="form-control form-control-sm" style="width:7rem" min="1" max="20" @bind="_explainTopN" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-primary" @onclick="SaveExplainAsync" disabled="@_busy">Salva</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_explainStatus))
        {
            <div class="alert @(_explainIsError ? "alert-danger" : "alert-success") py-2 mb-3">@_explainStatus</div>
        }

        @if (_rejections is null)
        {
            <p class="mb-0"><em>Caricamento dei verdetti…</em></p>
        }
        else if (_rejections.Count == 0)
        {
            <p class="text-muted mb-0">
                <em>Nessun run recente con candidati scartati. Compaiono qui appena un run del
                pipeline produce verdetti di validazione.</em>
            </p>
        }
        else
        {
            @foreach (var run in _rejections)
            {
                <div class="border rounded p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                        <div>
                            <strong>@run.ConfigurationName</strong>
                            <code class="ms-1">@run.RunId.ToString()[..8]</code>
                            <span class="text-muted ms-2 small">@run.CompletedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                        <div>
                            <span class="badge bg-light text-dark border">@run.Digest.Evaluated valutati</span>
                            <span class="badge @(run.Digest.Survived > 0 ? "bg-success" : "bg-secondary")">@run.Digest.Survived sopravvissuti</span>
                            <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">@run.Digest.Rejected scartati</span>
                            @if (run.Digest.GreyCount > 0)
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                    @run.Digest.GreyCount in fascia grigia
                                </span>
                            }
                        </div>
                    </div>

                    <div class="mb-2">
                        @foreach (var g in run.Digest.Groups)
                        {
                            <span class="badge bg-light text-dark border me-1 mb-1">@g.Count × @g.Label</span>
                        }
                    </div>

                    <table class="table table-sm table-striped mb-2">
                        <thead class="table-light">
                            <tr>
                                <th>I migliori fra gli scartati</th>
                                <th class="text-end">Sharpe holdout</th>
                                <th class="text-end">Trade</th>
                                <th class="text-end">DSR</th>
                                <th class="text-end">Gemello</th>
                                <th>Verdetto del motore</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in run.Digest.TopRejected)
                            {
                                <tr>
                                    <td>
                                        @c.StrategyName <code>@c.Symbol</code> @c.Timeframe
                                        @if (c.IsGrey) { <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1">grigio</span> }
                                    </td>
                                    <td class="text-end">@c.HoldoutSharpe.ToString("F2")</td>
                                    <td class="text-end">@c.HoldoutTrades</td>
                                    <td class="text-end">@(c.DeflatedSharpe?.ToString("F3") ?? "—")</td>
                                    <td class="text-end">@(c.NullTwinPercentile is { } p ? $"{p:F0}°" : "—")</td>
                                    <td class="small">@c.RejectReason</td>
                                </tr>
                                @if (run.Narration?.Notes.FirstOrDefault(n => n.Key == c.Key) is { } note)
                                {
                                    <tr class="table-light">
                                        <td colspan="6" class="small fst-italic">
                                            <i class="bi bi-chat-left-text me-1"></i>@note.Text
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>

                    @if (run.Narration is { } n2)
                    {
                        <div class="border-start border-3 ps-3 py-1 mb-2">
                            <p class="mb-1" style="white-space: pre-wrap;">@n2.Summary</p>
                            <small class="text-muted">
                                @n2.ModelUsed · @n2.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                @if (n2.DiscardedNotes > 0)
                                {
                                    <span class="text-warning-emphasis ms-1">
                                        · @n2.DiscardedNotes note scartate (riferite a candidati inesistenti)
                                    </span>
                                }
                            </small>
                        </div>
                    }

                    <button class="btn btn-sm btn-outline-secondary" disabled="@_busy"
                            @onclick="() => ExplainRunAsync(run.RunId, run.Narration is not null)">
                        <i class="bi bi-stars me-1"></i>@(run.Narration is null ? "Spiega con l'AI" : "Rigenera la spiegazione")
                    </button>
                </div>
            }
        }
    </div>
</div>

@if (_items is null)
{
    <p><em>Caricamento…</em></p>
}
else if (_items.Count == 0)
{
    <p><em>Nessun parere AI ancora prodotto. Compaiono qui dopo il completamento di un run del pipeline (con il layer AI abilitato).</em></p>
}
else
{
    @foreach (var item in _items)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-robot me-1"></i>Run <code>@item.RunId.ToString()[..8]</code>
                    <span class="badge @ConfidenceClass(item.Advisory.Confidence) ms-2">confidenza @item.Advisory.Confidence</span>
                    @if (item.Advisory.IsError)
                    {
                        <span class="badge bg-danger ms-1">errore</span>
                    }
                </span>
                <small class="text-muted">@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @item.Advisory.ModelUsed</small>
            </div>
            <div class="card-body">
                <p style="white-space: pre-wrap;">@item.Advisory.Summary</p>

                @if (item.Advisory.ParameterSuggestions.Count > 0)
                {
                    <h6 class="mt-3">Aggiustamenti proposti (da valutare, non applicati)</h6>
                    <table class="table table-sm table-striped mb-0">
                        <thead class="table-light">
                            <tr><th>Parametro</th><th>Attuale/osservato</th><th>Proposto</th><th>Motivazione</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var s in item.Advisory.ParameterSuggestions)
                            {
                                <tr>
                                    <td><code>@s.Parameter</code></td>
                                    <td>@s.CurrentOrObserved</td>
                                    <td><strong>@s.Suggested</strong></td>
                                    <td>@s.Rationale</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @if (item.Advisory.DecisionsForUser.Count > 0)
                {
                    <h6 class="mt-3">Decisioni che richiedono la tua conferma</h6>
                    <ul class="mb-0">
                        @foreach (var d in item.Advisory.DecisionsForUser)
                        {
                            <li>@d</li>
                        }
                    </ul>
                }

                @* [Fase C] Il secondo parere dello stesso run, affiancato — mai al posto. *@
                @if (_comparisons.TryGetValue(item.RunId, out var second))
                {
                    <div class="border rounded p-3 mt-3 bg-light-subtle">
                        <h6 class="mb-2">
                            <i class="bi bi-people me-1"></i>Secondo parere
                            <span class="badge @ConfidenceClass(second.Advisory.Confidence) ms-2">confidenza @second.Advisory.Confidence</span>
                            <small class="text-muted ms-2">@second.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") · @second.Advisory.ModelUsed</small>
                        </h6>
                        <p style="white-space: pre-wrap;" class="mb-2">@second.Advisory.Summary</p>
                        @if (second.Advisory.ParameterSuggestions.Count > 0)
                        {
                            <table class="table table-sm table-striped mb-2">
                                <thead class="table-light">
                                    <tr><th>Parametro</th><th>Attuale/osservato</th><th>Proposto</th><th>Motivazione</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in second.Advisory.ParameterSuggestions)
                                    {
                                        <tr>
                                            <td><code>@s.Parameter</code></td>
                                            <td>@s.CurrentOrObserved</td>
                                            <td><strong>@s.Suggested</strong></td>
                                            <td>@s.Rationale</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        @if (second.Advisory.DecisionsForUser.Count > 0)
                        {
                            <ul class="mb-0">
                                @foreach (var d in second.Advisory.DecisionsForUser)
                                {
                                    <li>@d</li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    private sealed record AdvisoryItem(Guid RunId, DateTime CreatedAt, SupervisorAdvisory Advisory);

    private List<AdvisoryItem>? _items;
    private Dictionary<Guid, AdvisoryItem> _comparisons = new();
    private LlmGuardStatus? _guard;
    private int _okCount;
    private int _errorCount;
    private int _pendingRuns;
    private bool _busy;
    private bool _actionIsError;
    private string? _actionStatus;

    // ---- [Multi-provider] provider, modelli, chiavi, prova collegamento ----
    private string _provider = AiProviders.Anthropic;
    private readonly Dictionary<string, string> _models =
        AiProviders.Known.ToDictionary(p => p, _ => string.Empty);
    private bool _comparisonEnabled;
    private string _comparisonProvider = AiProviders.Nvidia;
    private readonly Dictionary<string, string> _keyInputs =
        AiProviders.Known.ToDictionary(p => p, _ => string.Empty);
    private string? _testResult;
    private bool _testIsError;

    // ---- [AF1] Consumo e budget ----
    private LlmUsageSnapshot? _usage;
    private LlmBudgetVerdict? _budgetVerdict;

    /// <summary>
    /// [I3] Nessun tetto EFFETTIVO in vigore. Si legge da <c>BudgetMonitor.CurrentValue</c> e non
    /// dai campi del form: quelli sono la modifica che l'operatore sta digitando, non ciò che
    /// governa le chiamate adesso — e mostrare l'una per l'altra è come dichiarare applicata una
    /// configurazione mai salvata.
    /// </summary>
    private bool NoCeilingInForce
    {
        get
        {
            var b = BudgetMonitor.CurrentValue;
            return b.DailyCallLimit <= 0 && b.DailyTokenLimit <= 0 && b.MonthlyTokenLimit <= 0;
        }
    }

    /// <summary>Giorni trascorsi del mese corrente (almeno 1: il primo del mese non divide per zero).</summary>
    private static int DaysElapsedThisMonth => Math.Max(1, DateTime.UtcNow.Day);

    /// <summary>Media di token al giorno sul mese in corso — la base onesta per scegliere un tetto.</summary>
    private double MonthlyAveragePerDay => _usage is null ? 0 : (double)_usage.MonthTokens / DaysElapsedThisMonth;
    private bool _budgetTracking;
    private int _budgetDailyCalls;
    private int _budgetDailyTokens;
    private int _budgetMonthlyTokens;
    private string? _budgetStatus;
    private bool _budgetIsError;

    // ---- [AF3] Comitato ----
    private ProcioneMGR.Services.Llm.Committee.CommitteeOptions _committee = new();

    /// <summary>[I8] Esito dell'ultima prova del comitato: voti reali, provider per provider.</summary>
    private ProcioneMGR.Services.Llm.Committee.CommitteeVerdict? _committeeProbe;
    private string _committeeProvidersCsv = "";
    private string? _committeeStatus;
    private bool _committeeIsError;

    // ---- [G4] Post-mortem delle operazioni in perdita ----
    private ProcioneMGR.Services.Llm.Narration.PostMortemOptions _postMortem = new();
    private IReadOnlyList<ProcioneMGR.Data.TradePostMortem>? _postMortems;
    private string? _postMortemStatus;
    private bool _postMortemIsError;

    // ---- [G6] Perché i candidati sono stati scartati ----
    private IReadOnlyList<ProcioneMGR.Services.Llm.Narration.RunRejectionSummary>? _rejections;
    private bool _explainEnabled;
    private int _explainTopN = ProcioneMGR.Services.Llm.Narration.RejectionDigestBuilder.DefaultTopN;
    private string? _explainStatus;
    private bool _explainIsError;

    // [Elenco modelli] catalogo per provider scaricato dall'API con la SUA chiave.
    private readonly Dictionary<string, IReadOnlyList<string>> _modelCatalog = new();
    private string? _fetchingModels;
    private bool _autoLoadingModels;
    private bool _catalogIsError;
    private string? _catalogStatus;

    private string ActiveModel => _models.GetValueOrDefault(_provider, "");

    /// <summary>La catena di failover come la vedrà l'utente: attiva → prossime con chiave.</summary>
    private string FailoverChainText
    {
        get
        {
            var opt = LlmOptionsMonitor.CurrentValue;
            if (!opt.FailoverEnabled) return $"{_provider} (failover spento)";
            var chain = new List<string> { _provider };
            chain.AddRange(opt.EffectiveFailoverChain()
                .Where(p => !chain.Contains(p, StringComparer.OrdinalIgnoreCase))
                .Where(p => KeyStore.GetCachedSource(p) != AiKeySource.None));
            return string.Join(" → ", chain);
        }
    }

    /// <summary>
    /// [Auto-modelli] Al primo render scarica in background gli elenchi per OGNI provider con una
    /// chiave e, dove il modello configurato manca o non è più nell'elenco, ne sceglie uno da
    /// solo (ModelAutoSelector). Le scelte si confermano col «Salva» — e comunque a runtime il
    /// failover copre anche un modello rotto non ancora salvato.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _autoLoadingModels = true;
        await InvokeAsync(StateHasChanged);
        var autoPicked = new List<string>();
        try
        {
            foreach (var p in AiProviders.Known)
            {
                if (KeyStore.GetCachedSource(p) == AiKeySource.None) continue;
                if (ClientResolver.Resolve(p) is not IModelCatalogProvider catalogProvider) continue;
                try
                {
                    using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
                    var models = await catalogProvider.ListModelsAsync(cts.Token);
                    if (models.Count == 0) continue;
                    _modelCatalog[p] = models;

                    var current = _models.GetValueOrDefault(p, "");
                    if (string.IsNullOrWhiteSpace(current) || !models.Contains(current, StringComparer.OrdinalIgnoreCase))
                    {
                        if (ModelAutoSelector.Pick(p, models) is { } picked)
                        {
                            _models[p] = picked;
                            autoPicked.Add(string.IsNullOrWhiteSpace(current)
                                ? $"{p}: scelto {picked}"
                                : $"{p}: «{current}» non è più nell'elenco → scelto {picked}");
                        }
                    }
                }
                catch (Exception ex)
                {
                    // Un provider che non risponde non blocca gli altri: si dichiara e si prosegue.
                    autoPicked.Add($"{p}: elenco non scaricabile ({FirstLine(ex.Message)})");
                }
            }
            if (autoPicked.Count > 0)
            {
                _catalogIsError = false;
                _catalogStatus = "Modelli aggiornati in automatico:\n" + string.Join("\n", autoPicked) +
                                 "\nPremi «Salva» per confermare le scelte automatiche.";
            }
        }
        finally
        {
            _autoLoadingModels = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string FirstLine(string message)
    {
        var idx = message.IndexOfAny(['\r', '\n']);
        return idx < 0 ? message : message[..idx];
    }

    /// <summary>
    /// Scarica dall'API del provider l'elenco dei modelli disponibili per la SUA chiave e lo
    /// aggancia al campo modello (datalist). È il rimedio strutturale al caso Gemini del
    /// 2026-08-02: i nomi dei modelli invecchiano, l'elenco della propria chiave no.
    /// </summary>
    private async Task FetchModelsAsync(string provider)
    {
        _fetchingModels = provider; _catalogIsError = false; _catalogStatus = null;
        try
        {
            if (ClientResolver.Resolve(provider) is not IModelCatalogProvider catalogProvider)
            {
                _catalogIsError = true;
                _catalogStatus = $"Il provider {provider} non espone un elenco modelli.";
                return;
            }
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            var models = await catalogProvider.ListModelsAsync(cts.Token);
            _modelCatalog[provider] = models;
            _catalogStatus = models.Count == 0
                ? $"{provider}: l'API ha risposto con un elenco vuoto."
                : $"{provider}: {models.Count} modelli disponibili per la tua chiave — il campo ora li suggerisce mentre scrivi (freccia giù per sfogliarli).";
            if (models.Count > 0 && !models.Contains(_models[provider], StringComparer.OrdinalIgnoreCase))
            {
                _catalogStatus += $"\nATTENZIONE: il modello attuale «{_models[provider]}» NON è nell'elenco: sceglierne uno valido prima di salvare.";
            }
        }
        catch (Exception ex)
        {
            _catalogIsError = true;
            _catalogStatus = $"Elenco modelli {provider} non scaricabile: {ex.Message}";
        }
        finally { _fetchingModels = null; }
    }

    /// <summary>Il modello del provider dentro LlmOptions (campi piatti, stile NvidiaModel).</summary>
    private static string GetModelFor(LlmOptions o, string provider) => provider switch
    {
        AiProviders.Nvidia => o.NvidiaModel,
        AiProviders.Gemini => o.GeminiModel,
        AiProviders.Groq => o.GroqModel,
        AiProviders.HuggingFace => o.HuggingFaceModel,
        _ => o.Model,
    };

    private static void SetModelFor(LlmOptions o, string provider, string value)
    {
        switch (provider)
        {
            case AiProviders.Nvidia: o.NvidiaModel = value; break;
            case AiProviders.Gemini: o.GeminiModel = value; break;
            case AiProviders.Groq: o.GroqModel = value; break;
            case AiProviders.HuggingFace: o.HuggingFaceModel = value; break;
            default: o.Model = value; break;
        }
    }

    private static string ModelPlaceholder(string provider) => provider switch
    {
        AiProviders.Nvidia => "es. meta/llama-3.3-70b-instruct",
        AiProviders.Gemini => "es. models/gemini-3.6-flash",
        AiProviders.Groq => "es. llama-3.3-70b-versatile",
        AiProviders.HuggingFace => "es. meta-llama/Llama-3.3-70B-Instruct",
        _ => "es. claude-opus-4-8",
    };

    protected override async Task OnInitializedAsync()
    {
        var opt = LlmOptionsMonitor.CurrentValue;
        _provider = opt.Provider;
        foreach (var p in AiProviders.Known)
        {
            _models[p] = GetModelFor(opt, p);
        }
        _comparisonEnabled = opt.ComparisonEnabled;
        _comparisonProvider = opt.ComparisonProvider;
        await KeyStore.ReloadAsync();   // le fonti mostrate devono essere quelle VERE, non la cache di un processo vecchio
        await LoadAsync();
    }

    private async Task SaveProviderAsync()
    {
        _busy = true; _actionIsError = false; _actionStatus = null;
        try
        {
            // Clone VERO (roundtrip JSON) e non mutazione dell'istanza del monitor: SaveSectionAsync
            // riscrive l'intera sezione Llm, e perdere Enabled/soglie del breaker per strada sarebbe
            // il classico pannello che rompe ciò che non mostra; il roundtrip porta con sé anche i
            // campi futuri senza doverli elencare qui.
            var current = JsonSerializer.Deserialize<LlmOptions>(
                JsonSerializer.Serialize(LlmOptionsMonitor.CurrentValue))!;
            current.Provider = _provider;
            foreach (var p in AiProviders.Known)
            {
                SetModelFor(current, p, _models[p]);
            }
            current.ComparisonEnabled = _comparisonEnabled;
            current.ComparisonProvider = _comparisonProvider;
            await ConfigWriter.SaveSectionAsync("Llm", current);
            _actionStatus = $"Provider attivo: {_provider}" +
                            (_comparisonEnabled ? $" · secondo parere: {_comparisonProvider}" : " · secondo parere: off") +
                            ". Effetto alla prossima chiamata (hot-reload, ~1s).";
        }
        catch (Exception ex)
        {
            _actionIsError = true;
            _actionStatus = $"Salvataggio fallito: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task SaveKeyAsync(string provider)
    {
        if (string.IsNullOrWhiteSpace(_keyInputs[provider]))
        {
            _actionIsError = true;
            _actionStatus = $"Nessuna chiave nel campo {provider}: incollala e premi di nuovo Salva.";
            return;
        }
        _busy = true; _actionIsError = false; _actionStatus = null;
        try
        {
            await KeyStore.SetKeyAsync(provider, _keyInputs[provider].Trim());
            _keyInputs[provider] = string.Empty;   // mai trattenere la chiave nel circuito più del necessario
            _actionStatus = $"Chiave {provider} salvata (cifrata a riposo).";
        }
        catch (Exception ex)
        {
            _actionIsError = true;
            _actionStatus = $"Salvataggio chiave fallito: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task RemoveKeyAsync(string provider)
    {
        _busy = true; _actionIsError = false; _actionStatus = null;
        try
        {
            await KeyStore.RemoveKeyAsync(provider);
            _actionStatus = $"Chiave {provider} rimossa dal database (vale l'eventuale variabile d'ambiente).";
        }
        catch (Exception ex)
        {
            _actionIsError = true;
            _actionStatus = $"Rimozione fallita: {ex.Message}";
        }
        finally { _busy = false; }
    }

    private async Task TestNowAsync()
    {
        _busy = true; _testResult = null; _testIsError = false;
        try
        {
            // PRIMA si allinea la configurazione salvata a ciò che il pannello MOSTRA: il primo
            // collaudo dal vivo (2026-08-01) è partito con la tendina su Nvidia e la config ancora
            // su Anthropic — il test diceva Nvidia e chiamava Anthropic. Ciò che vedi è ciò che
            // viene provato, o il pulsante mente.
            var saved = LlmOptionsMonitor.CurrentValue;
            if (saved.Provider != _provider || AiProviders.Known.Any(p => GetModelFor(saved, p) != _models[p]))
            {
                var toWrite = JsonSerializer.Deserialize<LlmOptions>(JsonSerializer.Serialize(saved))!;
                toWrite.Provider = _provider;
                foreach (var p in AiProviders.Known)
                {
                    SetModelFor(toWrite, p, _models[p]);
                }
                await ConfigWriter.SaveSectionAsync("Llm", toWrite);

                // reloadOnChange impiega ~1s: si attende che le opzioni vive combacino, con un
                // tetto — se non arrivano si prosegue e l'esito lo dirà (mai un'attesa infinita).
                for (var i = 0; i < 20 && LlmOptionsMonitor.CurrentValue.Provider != _provider; i++)
                {
                    await Task.Delay(200);
                }
            }

            // Una chiamata VERA al provider SELEZIONATO, risolto direttamente (NON via
            // DelegatingLlmClient): col failover attivo il delegante maschererebbe il guasto
            // rispondendo con un'altra AI — e un test di collegamento che "passa" grazie a un
            // altro canale è un controllo che rassicura, non un test.
            var client = ClientResolver.Resolve(_provider)
                ?? throw new InvalidOperationException($"Provider '{_provider}' sconosciuto.");
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(90));
            var reply = await client.CompleteAsync(
                "Sei il test di collegamento di una piattaforma di trading. Rispondi in una sola riga.",
                $"Conferma il collegamento indicando il tuo nome modello. Ora UTC: {DateTime.UtcNow:u}.",
                cts.Token);
            _testResult = $"✔ {client.Model} ha risposto:\n{reply.Trim()}";
        }
        catch (Exception ex)
        {
            _testIsError = true;
            _testResult = $"✘ Collegamento fallito ({_provider} · {ActiveModel}):\n{ex.Message}";
        }
        finally { _busy = false; }
    }

