    /// <summary>[G4] Un giro di analisi su richiesta, senza aspettare il worker.</summary>
    private async Task RunPostMortemAsync()
    {
        _busy = true; _postMortemStatus = null; _postMortemIsError = false;
        try
        {
            if (!PostMortemMonitor.CurrentValue.Enabled)
            {
                _postMortemIsError = true;
                _postMortemStatus = "I post-mortem sono spenti: accendi l'interruttore e salva, poi riprova.";
                return;
            }
            var written = await PostMortems.AnalyzeRecentAsync();
            _postMortemStatus = written == 0
                ? "Nessuna operazione in perdita da analizzare (o sono già tutte analizzate)."
                : $"Analizzate {written} operazioni.";
            _postMortems = await PostMortems.GetRecentAsync(20);
        }
        catch (Exception ex)
        {
            _postMortemIsError = true;
            _postMortemStatus = $"Analisi fallita: {ex.Message}";
        }
        finally { _busy = false; }
    }

