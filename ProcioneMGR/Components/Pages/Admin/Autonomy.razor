    /// <summary>
    /// [Fase 3] Scrittura chirurgica di un singolo scalare (SaveValueAsync): niente POCO
    /// dell'intera sezione, niente rischio di cancellare chiavi non modellate.
    /// </summary>
    private async Task SaveScalarAsync<T>(string keyPath, T value, string label) where T : notnull
    {
        _busy = true; _isError = false; _status = null;
        try
        {
            await ConfigWriter.SaveValueAsync(keyPath, value);
            SetStatus($"{label}: salvato in appsettings.json — vale dal prossimo riavvio del processo interessato.", false);
        }
        catch (Exception ex) { SetStatus($"{label}: salvataggio fallito — {ex.Message}", true); }
        finally { _busy = false; }
    }

    /// <summary>
    /// [Fase 3] La topologia dell'ingestion si salva con la STESSA sezione del pannello sync
    /// (stesso POCO), ma da un bottone che resta attivo anche quando l'ingestion remota è accesa:
    /// altrimenti dalla UI non si potrebbe mai tornare indietro.
    /// </summary>
    private async Task SaveIngestionTopologyAsync()
    {
        if (_marketData.UseRemoteIngestion
            && !Uri.TryCreate(_marketData.RemoteIngestionUrl, UriKind.Absolute, out var uri))
        {
            SetStatus("Topologia ingestion: con l'ingestion remota accesa serve un URL assoluto (es. http://procionemgr-ingestion:8080).", true);
            return;
        }

        _busy = true; _isError = false; _status = null;
        try
        {
            await ConfigWriter.SaveSectionAsync("MarketData", _marketData);
            SetStatus("Topologia ingestion: salvata — vale dal prossimo riavvio, e va accompagnata dal deployment corrispondente.", false);
        }
        catch (Exception ex) { SetStatus($"Topologia ingestion: salvataggio fallito — {ex.Message}", true); }
        finally { _busy = false; }
    }

    /// <summary>[Fase 3] Il POCO è privato della pagina: la validazione sta qui, come per l'heartbeat.</summary>
    private async Task SaveMarketRegimeAsync()
    {
        if (_marketRegime.RetrainingIntervalDays < 1)
        {
            SetStatus("Retraining regime: l'intervallo dev'essere almeno 1 giorno.", true);
            return;
        }
        if (_marketRegime.Model is not (ProcioneMGR.Services.Regime.RegimeModelKinds.KMeans
            or ProcioneMGR.Services.Regime.RegimeModelKinds.Jump))
        {
            SetStatus("Retraining regime: algoritmi ammessi KMeans oppure Jump.", true);
            return;
        }
        if (_marketRegime.JumpLambda <= 0)
        {
            SetStatus("Retraining regime: λ dev'essere > 0 (a 0 il Jump degenera in K-means senza penalità di salto).", true);
            return;
        }
        await SaveAsync("MarketRegime", _marketRegime, "Retraining regime");
    }

    /// <summary>[Fase 3] Vuoto = canale disattivo (legittimo); valorizzato = URI assoluto.</summary>
    private async Task SaveMlRemoteUrlAsync()
    {
        var url = _topoMlRemoteUrl?.Trim();
        if (!string.IsNullOrEmpty(url) && !Uri.TryCreate(url, UriKind.Absolute, out _))
        {
            SetStatus("Ml:RemoteUrl: serve un URI assoluto (es. http://procionemgr-ml:8080), oppure vuoto per nessun canale.", true);
            return;
        }
        await SaveScalarAsync("Ml:RemoteUrl", url ?? "", "Servizio ML (Ml:RemoteUrl)");
    }

