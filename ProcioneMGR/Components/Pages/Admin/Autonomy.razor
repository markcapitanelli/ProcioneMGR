    private AutoReapplyOptions _autoReapply = new();
    private PromotionEvaluatorOptions _promotion = new();
    private ProcioneMGR.Services.Fleet.FleetOptions _fleet = new();
    private int _fleetFootprint = 3;
    private List<OrchestratorDecision> _fleetJournal = [];

    // ---- [F5] Il click umano sui candidati grigi ----
    private List<Guid> _greyRuns = [];
    private Guid? _greyRunId;
    private List<ProcioneMGR.Services.Fleet.GreyChoice> _greyChoices = [];
    private string _greyChoiceKey = "";
    private List<int> _freeFleetLanes = [];
    private int _greyLaneId;
    private bool _greyStartPaper = true;
    private string? _greyStatus;
    private bool _greyIsError;
    private ProcioneMGR.Services.Health.HeartbeatOptions _heartbeat = new();
    private string? _heartbeatStatus;
    private bool _heartbeatIsError;
    private DigestOptions _digest = new();
    private LlmOptions _llm = new();
    private SupervisorAgentOptions _supervisorAgent = new();
    private ProcioneMGR.Services.Sentiment.SentimentOptions _sentiment = new();
    private string _sentimentSymbolsCsv = "";
    private string _heritageFundingSymbolsCsv = "";
    private DriftMonitorOptions _drift = new();
    private MarketDataConfig _marketData = new();

    /// <summary>[E4] Vero quando lo scheduling del sync vive nel servizio ingestion remoto: i campi qui sono inerti e vanno dichiarati tali.</summary>
    private bool _remoteIngestion;
    private MarketRegimeConfig _marketRegime = new();
    private NotificationOptions _notifications = new();

    /// <summary>
    /// Il canale del MOTORE, distinto da quello del guscio qui sopra: altro processo, altra
    /// configurazione, altre variabili d'ambiente. Confonderli è il modo di credere di aver acceso
    /// gli allarmi di quarantena mentre restano spenti.
    /// </summary>
    private NotificationOptions _engineNotifications = new();
    private CampaignOptions _campaign = new();
    private RegimeTriggerOptions _regimeTrigger = new();
    private EnsembleComparatorOptions _comparator = new();
    private ModelRegistryOptions _registry = new();
    private MlComparisonOptions _ml = new();
    private CarryOptions _carry = new();
    private string _carrySymbolsCsv = "";

    /// <summary>Configurazione letta dal motore: la condividono la scheda carry e il canale di notifica.</summary>
    private EngineConfigSnapshot _engineSnapshot = new([], string.Empty, Writable: false);

    /// <summary>[E5] Spia del canale di notifica del motore (null = non ancora letta).</summary>
    private EngineNotificationChannelStatus? _engineChannel;

    /// <summary>
    /// Le sezioni del motore che QUESTA pagina mostra. Costante e non elenco ripetuto a ogni
    /// chiamata: <c>_engineSnapshot</c> è condiviso da più blocchi, e una rilettura che ne chiedesse
    /// meno svuoterebbe gli altri — salvando il carry sparivano i dati del canale di notifica.
    /// [E2/E3] Esecuzione live e dual-read ML aggiunte il 2026-07-31: i loro consumatori
    /// (ExecutionWorker, TradingEngine) vivono nell'host del motore, e questi pannelli scrivevano
    /// il file del guscio — la manopola non muoveva nulla.
    /// </summary>
    private static readonly string[] EngineSections = ["Carry", "Notifications", "Trading:LiveExecution", "Ml"];
    private LiquidationsOptions _liquidations = new();
    private ObservabilityConfig _observability = new();

    private List<DriftCheckResult> _driftResults = new();

    private bool _busy;
    private bool _isError;
    private string? _status;

    /// <summary>
    /// Il worker del carry vive nell'host del MOTORE: con <c>Trading:UseRemoteTrading=true</c> non
    /// è registrato qui. GetService (non Required) perché "assente" è uno stato legittimo da
    /// mostrare, non un errore da far esplodere in faccia a chi apre la pagina.
    /// </summary>
    private CarryWorker? CarryWorkerInstance => Services.GetService<CarryWorker>();

    /// <summary>L'accumulo liquidazioni vive sempre nel guscio: qui il servizio c'è per definizione.</summary>
    private LiquidationSyncWorker LiquidationWorker => Services.GetRequiredService<LiquidationSyncWorker>();

    /// <summary>Sezione MarketData di appsettings (nessun POCO esistente: il worker legge IConfiguration).</summary>
    private sealed class MarketDataConfig
    {
        public bool Enabled { get; set; } = true;
        public int SyncIntervalMinutes { get; set; } = 5;
        public int DefaultBackfillDays { get; set; } = 7;

        // Toggle Fase 1 microservizi: NON esposti nel form (richiedono riavvio, non hot-reload),
        // ma DEVONO stare nel POCO — SaveSectionAsync sostituisce l'intera sezione MarketData,
        // e senza queste proprietà un salvataggio da questa pagina le cancellerebbe dal file.
        public bool UseRemoteIngestion { get; set; }
        public string? RemoteIngestionUrl { get; set; }
    }

    /// <summary>Sezione MarketRegime di appsettings (come sopra).</summary>
    private sealed class MarketRegimeConfig
    {
        public bool Enabled { get; set; } = true;
        public int RetrainingIntervalDays { get; set; } = 7;

        // [Fase 3] Prima erano scalari FUORI dal POCO: SaveSectionAsync sostituisce l'intera
        // sezione e preserva solo gli OGGETTI non modellati, quindi un salvataggio del pannello
        // li avrebbe cancellati dal file. Modellarli è obbligatorio, esporli è il mandato.
        public string Model { get; set; } = ProcioneMGR.Services.Regime.RegimeModelKinds.KMeans;
        public double JumpLambda { get; set; } = 20.0;
    }

    // [Fase 3] Topologia e infrastruttura: scalari del file del guscio, tutti ⟳.
    private bool _topoUseRemoteTrading;
    private string? _topoMlRemoteUrl;
    private bool _topoDisableHttpsRedirect;
    private ProcioneMGR.Data.DatabaseMigrationOptions _database = new();
    private ProcioneMGR.Services.Alpha.FactorCacheOptions _factorCache = new();

    /// <summary>Sezione Observability (l'export OTLP si compone a startup, senza POCO di opzioni).</summary>
    private sealed class ObservabilityConfig
    {
        public bool Enabled { get; set; }
        public string OtlpEndpoint { get; set; } = "http://localhost:4317";
    }

    /// <summary>
    /// [AF5.1] Un salvataggio, DUE host: il file del guscio (AppConfigWriter) e la sezione del
    /// motore (IEngineConfigStore, che valida con AdminConfigRules e ricarica esplicitamente —
    /// reloadOnChange non attraversa un mount PVC). Gli esiti si riportano separati: «salvato sul
    /// guscio ma non sul motore» è un'informazione, non un dettaglio.
    /// </summary>
    private async Task SaveHeartbeatAsync()
    {
        var error = AdminConfigRules.Validate(_heartbeat);
        if (error is not null)
        {
            _heartbeatStatus = error;
            _heartbeatIsError = true;
            return;
        }

        var outcomes = new List<string>();
        var failed = false;
        try
        {
            await ConfigWriter.SaveSectionAsync("Heartbeat", _heartbeat);
            outcomes.Add("guscio: salvato");
        }
        catch (Exception ex)
        {
            outcomes.Add($"guscio: FALLITO ({ex.Message})");
            failed = true;
        }
        try
        {
            await EngineConfig.WriteAsync("Heartbeat", _heartbeat);
            outcomes.Add(EngineConfig.IsRemote ? "motore: salvato e ricaricato" : "motore in-process: stesso file del guscio");
        }
        catch (Exception ex)
        {
            outcomes.Add($"motore: FALLITO ({ex.Message})");
            failed = true;
        }

        _heartbeatStatus = string.Join(" · ", outcomes);
        _heartbeatIsError = failed;
    }

    /// <summary>[F5] Cambio run nel form: ricarica i grigi di QUEL run (dal suo artifact).</summary>
    private async Task OnGreyRunChangedAsync(ChangeEventArgs e)
    {
        _greyStatus = null;
        _greyChoices = [];
        _greyChoiceKey = "";
        _greyRunId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        if (_greyRunId is Guid runId)
        {
            _greyChoices = (await GreyDeployer.ListGreyAsync(runId)).ToList();
            if (_greyChoices.Count > 0)
            {
                var first = _greyChoices[0];
                _greyChoiceKey = $"{first.StrategyName}|{first.Symbol}|{first.Timeframe}";
            }
            else
            {
                _greyStatus = "Nessun candidato grigio leggibile in quel run.";
                _greyIsError = true;
            }
        }
    }

    private async Task DeployGreyAsync()
    {
        if (_greyRunId is not Guid runId || string.IsNullOrEmpty(_greyChoiceKey)) return;
        var parts = _greyChoiceKey.Split('|');
        if (parts.Length != 3) return;
        _busy = true;
        try
        {
            var result = await GreyDeployer.DeployAsync(runId, parts[0], parts[1], parts[2], _greyLaneId, _greyStartPaper);
            _greyStatus = result.Message;
            _greyIsError = !result.Success;
            if (result.Success)
            {
                // Journal e corsie libere sono cambiati: si rilegge lo stato vero, non lo si finge.
                await OnInitializedAsync();
            }
        }
        catch (Exception ex)
        {
            _greyStatus = $"Schieramento fallito: {ex.Message}";
            _greyIsError = true;
        }
        finally { _busy = false; }
    }

    private static string FleetKindBadge(string kind) => kind switch
    {
        "Assign" => "bg-success",
        "Retire" => "bg-warning text-dark",
        "ProposeGrey" => "text-bg-info",
        "Blocked" => "bg-secondary",
        _ => "bg-light text-dark",
    };

    protected override async Task OnInitializedAsync()
    {
        _autoReapply = Clone(AutoReapplyMonitor.CurrentValue);
        _promotion = Clone(PromotionMonitor.CurrentValue);

        _digest = Clone(DigestMonitor.CurrentValue);
        _heartbeat = new ProcioneMGR.Services.Health.HeartbeatOptions
        {
            Enabled = HeartbeatMonitor.CurrentValue.Enabled,
            WriteSeconds = HeartbeatMonitor.CurrentValue.WriteSeconds,
            StaleMinutes = HeartbeatMonitor.CurrentValue.StaleMinutes,
        };

        // [AF2] Config (editabile), stato e journal della flotta.
        _fleet = Clone(FleetMonitor.CurrentValue);
        _fleetFootprint = PipelineApplier.LaneCount; // l'impronta storica dell'auto-apply: il confine della flotta
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            _fleetJournal = await db.OrchestratorDecisions.AsNoTracking()
                .OrderByDescending(d => d.AtUtc)
                .Take(20)
                .ToListAsync();

            // [F5] I run proposti in fascia grigia, per il form del click umano (i più recenti,
            // deduplicati: run diversi possono proporre lo stesso candidato sottostante).
            _greyRuns = await db.OrchestratorDecisions.AsNoTracking()
                .Where(d => d.Kind == "ProposeGrey" && d.RunId != null)
                .OrderByDescending(d => d.AtUtc)
                .Select(d => d.RunId!.Value)
                .Take(30)
                .ToListAsync();
            _greyRuns = _greyRuns.Distinct().Take(10).ToList();
        }

        var lanes = await LaneDirectory.ListAsync();
        _freeFleetLanes = lanes.Where(l => l.Id >= PipelineApplier.LaneCount && !l.IsRunning).Select(l => l.Id).ToList();
        if (_freeFleetLanes.Count > 0 && !_freeFleetLanes.Contains(_greyLaneId)) _greyLaneId = _freeFleetLanes[0];
        _llm = Clone(LlmMonitor.CurrentValue);
        _supervisorAgent = Clone(SupervisorAgentMonitor.CurrentValue);
        _sentiment = Clone(SentimentMonitor.CurrentValue);
        _sentimentSymbolsCsv = SymbolsToCsv(_sentiment.Symbols);
        // Si mostra la lista EFFETTIVA (configurata o default incorporati): il campo vuoto direbbe
        // "nessun simbolo sorvegliato" mentre il guardiano ne sorveglia sei.
        _heritageFundingSymbolsCsv = SymbolsToCsv(_sentiment.HeritageGuard.EffectiveFundingSymbols);
        _drift = Clone(DriftMonitor.CurrentValue);
        _marketData = new MarketDataConfig
        {
            Enabled = Config.GetValue("MarketData:Enabled", true),
            SyncIntervalMinutes = Config.GetValue("MarketData:SyncIntervalMinutes", 5),
            DefaultBackfillDays = Config.GetValue("MarketData:DefaultBackfillDays", 7),
            // Round-trip dei toggle Fase 1 (non nel form): preservati al salvataggio della sezione.
            UseRemoteIngestion = Config.GetValue("MarketData:UseRemoteIngestion", false),
            RemoteIngestionUrl = Config.GetValue<string?>("MarketData:RemoteIngestionUrl"),
        };
        // [E4] Con l'ingestion remota questi campi non hanno NESSUN lettore in questo processo:
        // il pannello li disabilita e dice dove vive la manopola vera, invece di fingere.
        _remoteIngestion = _marketData.UseRemoteIngestion;
        _marketRegime = new MarketRegimeConfig
        {
            Enabled = Config.GetValue("MarketRegime:Enabled", true),
            RetrainingIntervalDays = Config.GetValue("MarketRegime:RetrainingIntervalDays", 7),
            Model = ProcioneMGR.Services.Regime.RegimeModelKinds.Normalize(
                Config["MarketRegime:Model"] ?? ProcioneMGR.Services.Regime.RegimeModelKinds.KMeans),
            JumpLambda = Config.GetValue("MarketRegime:JumpLambda", 20.0),
        };

        // [Fase 3] Topologia e infrastruttura.
        _topoUseRemoteTrading = Config.GetValue("Trading:UseRemoteTrading", false);
        _topoMlRemoteUrl = Config["Ml:RemoteUrl"];
        _topoDisableHttpsRedirect = Config.GetValue("Http:DisableHttpsRedirection", false);
        _database = new ProcioneMGR.Data.DatabaseMigrationOptions
        {
            AutoMigrate = Config.GetValue("Database:AutoMigrate", true),
            LockTimeoutSeconds = Config.GetValue("Database:LockTimeoutSeconds", 120),
        };
        _factorCache = new ProcioneMGR.Services.Alpha.FactorCacheOptions
        {
            MaxEntries = Config.GetValue("FactorCache:MaxEntries", 512),
        };
        _notifications = Clone(NotificationMonitor.CurrentValue);
        _campaign = Clone(CampaignMonitor.CurrentValue);
        _regimeTrigger = Clone(RegimeTriggerMonitor.CurrentValue);
        // Comparatore e Registry sono POCO singleton letti una volta al boot (nessun IOptionsMonitor
        // dietro): l'istanza iniettata È il valore in vigore, ed è per questo che i loro campi sono
        // marcati ⟳ invece di ✅.
        _comparator = Clone(ComparatorOptions);
        _registry = Clone(RegistryOptions);
        // Dal motore, non dal file locale: col trading remoto sono due cose diverse.
        _engineSnapshot = await EngineConfig.ReadAsync(EngineSections);
        _carry = _engineSnapshot.Bind<CarryOptions>("Carry");
        _carrySymbolsCsv = SymbolsToCsv(_carry.Symbols);
        _engineNotifications = _engineSnapshot.Bind<NotificationOptions>("Notifications");
        _liveExec = _engineSnapshot.Bind<LiveExecutionOptions>("Trading:LiveExecution");
        _ml = _engineSnapshot.Bind<MlComparisonOptions>("Ml");
        // [E5] Spia del canale del motore: si legge senza inviare nulla.
        _engineChannel = await EngineConfig.GetNotificationChannelStatusAsync();
        _liquidations = Clone(LiquidationsMonitor.CurrentValue);
        _observability = new ObservabilityConfig
        {
            Enabled = Config.GetValue("Observability:Enabled", false),
            OtlpEndpoint = Config.GetValue("Observability:OtlpEndpoint", "http://localhost:4317")!,
        };
        await LoadDriftResultsAsync();
    }

    /// <summary>Copia per-serializzazione: stacca l'istanza della UI da quella viva del monitor.</summary>
    private static T Clone<T>(T value) => JsonSerializer.Deserialize<T>(JsonSerializer.Serialize(value))!;

    private async Task LoadDriftResultsAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _driftResults = await db.DriftCheckResults.AsNoTracking()
            .OrderByDescending(r => r.CheckedAtUtc)
            .Take(20)
            .ToListAsync();
