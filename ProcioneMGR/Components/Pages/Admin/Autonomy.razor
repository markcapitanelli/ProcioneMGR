    /// <summary>[I8] Ci sono voti da mostrare? Stringa vuota e <c>"[]"</c> valgono entrambe «nessuno».</summary>
    private static bool HasVotes(string? votesJson) =>
        !string.IsNullOrWhiteSpace(votesJson) && votesJson.Trim() is not ("[]" or "null");

    /// <summary>
    /// [I8] I voti in chiaro, uno per riga. Un JSON illeggibile si DICHIARA invece di sparire:
    /// «nessun voto» e «voto non interpretabile» sono cose diverse, e mostrare la seconda come la
    /// prima è la classe che questa ondata bonifica.
    /// </summary>
    private static string FormatVotes(string? votesJson)
    {
        if (string.IsNullOrWhiteSpace(votesJson)) return "—";
        try
        {
            using var doc = JsonDocument.Parse(votesJson);
            var righe = doc.RootElement.EnumerateArray().Select(v =>
            {
                var provider = v.TryGetProperty("Provider", out var p) ? p.GetString() : "?";
                var valido = v.TryGetProperty("Valid", out var ok) && ok.GetBoolean();
                var scelta = v.TryGetProperty("OptionId", out var o) ? o.GetString() : null;
                var motivo = v.TryGetProperty("Reason", out var r) ? r.GetString() : null;
                return valido
                    ? $"{provider}: {scelta?[..Math.Min(8, scelta.Length)]} — {motivo}"
                    : $"{provider}: ASTENUTO — {motivo}";
            }).ToList();
            return righe.Count == 0 ? "—" : string.Join("\n", righe);
        }
        catch (JsonException)
        {
            return $"voti non interpretabili (JSON non valido): {votesJson[..Math.Min(120, votesJson.Length)]}";
        }
    }

