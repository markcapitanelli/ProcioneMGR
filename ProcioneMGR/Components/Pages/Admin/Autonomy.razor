    /// <summary>
    /// Salvataggio di una sezione OSPITATA DAL MOTORE: validazione con le stesse regole dei
    /// pannelli, scrittura via store (che riflette chi esegue, non questo processo) e rilettura
    /// della fotografia condivisa. Restituisce falso se la validazione o la scrittura falliscono.
    /// </summary>
    private async Task<bool> SaveEngineSectionAsync<T>(string section, T model, string label) where T : notnull
    {
        _busy = true; _isError = false; _status = null;
        try
        {
            var error = AdminConfigRules.Validate(model);
            if (error is not null) { SetStatus($"{label}: {error}", true); return false; }

            var result = await EngineConfig.WriteAsync(section, model);
            var dove = EngineConfig.IsRemote ? "sul motore" : "in appsettings.json";
            SetStatus(result.Warning is { } warning
                ? $"{label}: salvato {dove}, MA — {warning}"
                : $"{label}: salvato {dove}.", result.Warning is not null);

            _engineSnapshot = await EngineConfig.ReadAsync(EngineSections);
            return true;
        }
        catch (Exception ex) { SetStatus($"{label}: salvataggio fallito — {ex.Message}", true); return false; }
        finally { _busy = false; }
    }

