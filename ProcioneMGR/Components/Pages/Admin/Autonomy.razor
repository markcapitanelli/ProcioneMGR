    private async Task SendTestNotificationAsync()
    {
        _busy = true; _isError = false; _status = null;
        try
        {
            // Passa dal dispatcher vero (gate + rate-limit + provider corrente): una prova che
            // scavalcasse quella catena direbbe che "funziona" anche quando l'utente ha lasciato
            // Enabled=false, che è esattamente l'errore che si sta cercando di scoprire.
            var result = await Notifier.SendDiagnosticAsync(NotificationSeverity.Info,
                "Notifica di prova",
                "Se leggi questo messaggio, il canale configurato in /admin/autonomy recapita.",
                CancellationToken.None);

            var live = NotificationMonitor.CurrentValue;
            SetStatus(result.Outcome switch
            {
                NotificationOutcome.Delivered =>
                    $"Notifica CONSEGNATA al provider «{live.Provider}»: controlla di averla ricevuta.",
                NotificationOutcome.Disabled =>
                    "Notifiche SPENTE: il messaggio è stato scartato. Abilita e salva prima di riprovare.",
                NotificationOutcome.RateLimited =>
                    $"Rate-limit raggiunto ({live.MaxPerHour}/ora): non recapitata ora, sarà conteggiata nel primo messaggio successivo.",
                NotificationOutcome.UnknownProvider =>
                    $"Provider non riconosciuto — {result.Detail}",
                _ => $"Recapito FALLITO — {result.Detail}",
            }, !result.IsDelivered);
        }
        catch (Exception ex) { SetStatus($"Invio di prova fallito: {ex.Message}", true); }
        finally { _busy = false; }
    }

    /// <summary>
    /// Prova il canale del MOTORE. Il pulsante accanto prova quello del guscio: sembrano la stessa
    /// cosa e non lo sono — il motore è un altro processo, con un altro ambiente, ed è lui a
    /// emettere gli allarmi di quarantena. Che il guscio recapiti non dice nulla su di lui.
    /// </summary>
    /// <summary>
    /// Scrive il canale del motore SUL MOTORE. Separata da <c>SaveAsync</c> perché quella passa dal
    /// writer del guscio: usarla qui avrebbe salvato la configurazione nel processo sbagliato,
    /// lasciando l'operatore convinto di aver acceso gli allarmi di quarantena.
    /// </summary>
    private async Task SaveEngineNotificationsAsync()
    {
        _busy = true; _isError = false; _status = null;
        try
        {
            var error = AdminConfigRules.Validate(_engineNotifications);
            if (error is not null) { SetStatus($"Notifiche del motore: {error}", true); return; }

            var result = await EngineConfig.WriteAsync("Notifications", _engineNotifications);
            SetStatus(result.Warning is { } warning
                ? $"Notifiche del motore: salvate, MA — {warning}"
                : "Notifiche del motore: salvate. Usa «Prova dal motore» per verificare che recapiti davvero.",
                result.Warning is not null);

            _engineSnapshot = await EngineConfig.ReadAsync(EngineSections);
            _engineNotifications = _engineSnapshot.Bind<NotificationOptions>("Notifications");
        }
        catch (Exception ex) { SetStatus($"Notifiche del motore: salvataggio fallito — {ex.Message}", true); }
        finally { _busy = false; }
    }

    private async Task SendEngineTestNotificationAsync()
    {
        _busy = true; _isError = false; _status = null;
        try
        {
            var result = await EngineConfig.SendTestNotificationAsync();
            SetStatus(result.Outcome switch
            {
                NotificationOutcome.Delivered =>
                    "Motore: notifica CONSEGNATA — gli allarmi di quarantena ti raggiungono.",
                NotificationOutcome.Disabled =>
                    "Motore: notifiche SPENTE nella SUA configurazione. Accendile nel blocco «Canale del motore» e premi «Salva sul motore» — il pannello del guscio qui sopra non le tocca.",
                NotificationOutcome.RateLimited =>
                    "Motore: rate-limit raggiunto, non recapitata ora — sarà conteggiata nel primo messaggio successivo.",
                NotificationOutcome.UnknownProvider =>
                    $"Motore: provider non riconosciuto — {result.Detail}",
                _ => $"Motore: recapito FALLITO — {result.Detail}",
            }, !result.IsDelivered);

            // La prova ha appena mosso la spia del motore: rileggerla subito, o mostrerebbe
            // lo stato di prima della prova.
            _engineChannel = await EngineConfig.GetNotificationChannelStatusAsync();
        }
        catch (Exception ex) { SetStatus($"Motore: prova fallita — {ex.Message}", true); }
        finally { _busy = false; }
    }

    /// <summary>
    /// [E5] La spia del canale in una riga: ultimo recapito, e — se ci sono — i fallimenti
    /// accumulati col motivo. «Nessun recapito da questo avvio» non è un guasto (un canale sano può
    /// non aver avuto nulla da dire), ma non va nemmeno spacciato per prova di funzionamento.
    /// </summary>
    private static string DescribeChannel(NotificationChannelStatus s)
    {
        var parts = new List<string>
        {
            s.LastDeliveredUtc is DateTime d
                ? $"ultimo recapito {d:dd/MM HH:mm} UTC"
                : "nessun recapito da questo avvio",
        };
        if (s.FailuresSinceLastDelivery > 0)
        {
            parts.Add($"{s.FailuresSinceLastDelivery} fallimenti dall'ultimo recapito — ultimo: {s.LastFailureDetail} ({s.LastFailureUtc:dd/MM HH:mm} UTC)");
        }
        else if (s.LastFailureUtc is DateTime f)
        {
            parts.Add($"ultimo fallimento {f:dd/MM HH:mm} UTC, poi il canale ha ripreso");
        }
        return string.Join(" · ", parts);
    }

    private async Task RunDriftNowAsync()
    {
        _busy = true; _isError = false; _status = null;
        try
        {
            await DriftWorker.TickAsync(CancellationToken.None);
            await LoadDriftResultsAsync();
            SetStatus("Check drift eseguito su tutti i modelli salvati: esiti nella tabella.", false);
        }
        catch (Exception ex) { SetStatus($"Check drift fallito: {ex.Message}", true); }
        finally { _busy = false; }
    }

    private void SetStatus(string text, bool error) { _status = text; _isError = error; }

    // --- Frammenti di markup riusati -----------------------------------------------------------

    private static RenderFragment Hot() => b => b.AddMarkupContent(0,
        "<span class='badge bg-success' title='Effetto entro ~1 secondo, senza riavvio'>✅</span>");

    private static RenderFragment Restart() => b => b.AddMarkupContent(0,
        "<span class='badge bg-warning text-dark' title='Salvato subito, ma il timer legge il valore solo al riavvio'>⟳</span>");

    private static RenderFragment StateBadge(bool enabled) => b => b.AddMarkupContent(0, enabled
        ? "<span class='badge bg-success'>ATTIVO</span>"
        : "<span class='badge bg-secondary'>SPENTO</span>");

    private static RenderFragment SeverityBadge(DriftSeverity s) => b => b.AddMarkupContent(0, s switch
    {
        DriftSeverity.Alert => "<span class='badge bg-danger'>Alert</span>",
        DriftSeverity.Warning => "<span class='badge bg-warning text-dark'>Warning</span>",
        _ => "<span class='badge bg-success'>Pulito</span>",
    });

    /// <summary>Rende leggibile il JSON top-feature ("nome[Severity]"); tollerante ai payload vecchi/corrotti.</summary>
    private static string TopFeatures(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "—";
        try
        {
            using var doc = JsonDocument.Parse(json);
            return string.Join(", ", doc.RootElement.EnumerateArray()
                .Select(e => $"{e.GetProperty("name").GetString()}[{e.GetProperty("severity").GetString()}]"));
        }
        catch { return "—"; }
    }
}
