    private async Task RunCarryNowAsync()
    {
        _busy = true; _isError = false; _status = null;
        try
        {
            var worker = CarryWorkerInstance;
            if (worker is null)
            {
                SetStatus("Carry: il worker non gira in questo processo (trading remoto) — la valutazione avviene lì.", true);
                return;
