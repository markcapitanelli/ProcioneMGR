        if (_marketRegime.Model is not (ProcioneMGR.Services.Regime.RegimeModelKinds.KMeans
            or ProcioneMGR.Services.Regime.RegimeModelKinds.Jump))
        {
            SetStatus("Retraining regime: algoritmi ammessi KMeans oppure Jump.", true);
