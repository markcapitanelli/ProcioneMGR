        _digest = Clone(DigestMonitor.CurrentValue);
        _heartbeat = new ProcioneMGR.Services.Health.HeartbeatOptions
        {
            Enabled = HeartbeatMonitor.CurrentValue.Enabled,
            WriteSeconds = HeartbeatMonitor.CurrentValue.WriteSeconds,
