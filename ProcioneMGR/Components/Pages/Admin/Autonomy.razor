        };

        // [AF2] Config (editabile), stato e journal della flotta.
        _fleet = Clone(FleetMonitor.CurrentValue);
        _fleetExecutionLanesCsv = string.Join(", ", _fleet.ExecutionLanes);
        _llmFailoverCsv = string.Join(", ", _llm.FailoverProviders);
        _pairsWatch = Clone(PairsWatchMonitor.CurrentValue);
        _pairsWatchPairsCsv = string.Join(", ", _pairsWatch.Pairs);
        _fleetFootprint = PipelineApplier.LaneCount; // l'impronta storica dell'auto-apply: il confine della flotta
        await using (var db = await DbFactory.CreateDbContextAsync())
        {
            _fleetJournal = await db.OrchestratorDecisions.AsNoTracking()
                .OrderByDescending(d => d.AtUtc)
                .Take(20)
                .ToListAsync();

            // [F5] I run proposti in fascia grigia, per il form del click umano (i più recenti,
            // deduplicati: run diversi possono proporre lo stesso candidato sottostante).
            _greyRuns = await db.OrchestratorDecisions.AsNoTracking()
                .Where(d => d.Kind == "ProposeGrey" && d.RunId != null)
                .OrderByDescending(d => d.AtUtc)
                .Select(d => d.RunId!.Value)
                .Take(30)
                .ToListAsync();
            _greyRuns = _greyRuns.Distinct().Take(10).ToList();
        }

        var lanes = await LaneDirectory.ListAsync();
        _freeFleetLanes = lanes.Where(l => l.Id >= PipelineApplier.LaneCount && !l.IsRunning).Select(l => l.Id).ToList();
        if (_freeFleetLanes.Count > 0 && !_freeFleetLanes.Contains(_greyLaneId)) _greyLaneId = _freeFleetLanes[0];
        _llm = Clone(LlmMonitor.CurrentValue);
        _supervisorAgent = Clone(SupervisorAgentMonitor.CurrentValue);
        _sentiment = Clone(SentimentMonitor.CurrentValue);
        _sentimentSymbolsCsv = SymbolsToCsv(_sentiment.Symbols);
        // Si mostra la lista EFFETTIVA (configurata o default incorporati): il campo vuoto direbbe
        // "nessun simbolo sorvegliato" mentre il guardiano ne sorveglia sei.
        _heritageFundingSymbolsCsv = SymbolsToCsv(_sentiment.HeritageGuard.EffectiveFundingSymbols);
        _drift = Clone(DriftMonitor.CurrentValue);
        _driftStagesCsv = SymbolsToCsv(_drift.MonitorStages);
        _factorDrift = Clone(FactorDriftMonitor.CurrentValue);
        _marketData = new MarketDataConfig
        {
            Enabled = Config.GetValue("MarketData:Enabled", true),
            SyncIntervalMinutes = Config.GetValue("MarketData:SyncIntervalMinutes", 5),
            DefaultBackfillDays = Config.GetValue("MarketData:DefaultBackfillDays", 7),
            // Round-trip dei toggle Fase 1 (non nel form): preservati al salvataggio della sezione.
            UseRemoteIngestion = Config.GetValue("MarketData:UseRemoteIngestion", false),
            RemoteIngestionUrl = Config.GetValue<string?>("MarketData:RemoteIngestionUrl"),
        };
        // [E4] Con l'ingestion remota questi campi non hanno NESSUN lettore in questo processo:
        // il pannello li disabilita e dice dove vive la manopola vera, invece di fingere.
        _remoteIngestion = _marketData.UseRemoteIngestion;
        _marketRegime = new MarketRegimeConfig
        {
            Enabled = Config.GetValue("MarketRegime:Enabled", true),
            RetrainingIntervalDays = Config.GetValue("MarketRegime:RetrainingIntervalDays", 7),
            Model = ProcioneMGR.Services.Regime.RegimeModelKinds.Normalize(
                Config["MarketRegime:Model"] ?? ProcioneMGR.Services.Regime.RegimeModelKinds.KMeans),
            JumpLambda = Config.GetValue("MarketRegime:JumpLambda", 20.0),
        };

        // [Fase 3] Topologia e infrastruttura.
        _topoUseRemoteTrading = Config.GetValue("Trading:UseRemoteTrading", false);
        _topoReadTimeout = Config.GetValue("Trading:RemoteReadTimeoutSeconds", 10);
        _topoCommandTimeout = Config.GetValue("Trading:RemoteCommandTimeoutSeconds", 60);
        _topoMlRemoteUrl = Config["Ml:RemoteUrl"];
        _topoDisableHttpsRedirect = Config.GetValue("Http:DisableHttpsRedirection", false);
        _database = new ProcioneMGR.Data.DatabaseMigrationOptions
        {
            AutoMigrate = Config.GetValue("Database:AutoMigrate", true),
            LockTimeoutSeconds = Config.GetValue("Database:LockTimeoutSeconds", 120),
        };
        _factorCache = new ProcioneMGR.Services.Alpha.FactorCacheOptions
        {
            MaxEntries = Config.GetValue("FactorCache:MaxEntries", 512),
        };
        _notifications = Clone(NotificationMonitor.CurrentValue);
        _campaign = Clone(CampaignMonitor.CurrentValue);
        _regimeTrigger = Clone(RegimeTriggerMonitor.CurrentValue);
        // Comparatore e Registry sono POCO singleton letti una volta al boot (nessun IOptionsMonitor
        // dietro): l'istanza iniettata È il valore in vigore, ed è per questo che i loro campi sono
        // marcati ⟳ invece di ✅.
        _comparator = Clone(ComparatorOptions);
        _registry = Clone(RegistryOptions);
        // Dal motore, non dal file locale: col trading remoto sono due cose diverse.
        _engineSnapshot = await EngineConfig.ReadAsync(EngineSections);
        _carry = _engineSnapshot.Bind<CarryOptions>("Carry");
        _carrySymbolsCsv = SymbolsToCsv(_carry.Symbols);
        _engineNotifications = _engineSnapshot.Bind<NotificationOptions>("Notifications");
        _liveExec = _engineSnapshot.Bind<LiveExecutionOptions>("Trading:LiveExecution");
        _ml = _engineSnapshot.Bind<MlComparisonOptions>("Ml");
        // [E5] Spia del canale del motore: si legge senza inviare nulla.
        _engineChannel = await EngineConfig.GetNotificationChannelStatusAsync();
        _liquidations = Clone(LiquidationsMonitor.CurrentValue);
        _observability = new ObservabilityConfig
        {
            Enabled = Config.GetValue("Observability:Enabled", false),
            OtlpEndpoint = Config.GetValue("Observability:OtlpEndpoint", "http://localhost:4317")!,
        };
        await LoadDriftResultsAsync();
        await LoadDriftModelCountsAsync();
        await LoadWatchlistSeriesCountAsync();   // [M1] il denominatore della copertura del monitor fattori
        await LoadAgentStateAsync();
    }

