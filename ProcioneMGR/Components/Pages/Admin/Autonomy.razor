            SetStatus(evaluated > 0
                ? $"Carry: valutati {evaluated} simboli — stato aggiornato nella tabella qui sotto."
                : "Carry: nessun simbolo valutato (carry spento, oppure storia di funding ancora insufficiente).", false);
