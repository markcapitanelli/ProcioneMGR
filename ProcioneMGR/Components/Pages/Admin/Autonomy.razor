    /// <summary>
    /// [AF5.1] Un salvataggio, DUE host: il file del guscio (AppConfigWriter) e la sezione del
    /// motore (IEngineConfigStore, che valida con AdminConfigRules e ricarica esplicitamente —
    /// reloadOnChange non attraversa un mount PVC). Gli esiti si riportano separati: «salvato sul
    /// guscio ma non sul motore» è un'informazione, non un dettaglio.
    /// </summary>
    private async Task SaveHeartbeatAsync()
    {
        var error = AdminConfigRules.Validate(_heartbeat);
        if (error is not null)
        {
            _heartbeatStatus = error;
            _heartbeatIsError = true;
            return;
        }

        var outcomes = new List<string>();
        var failed = false;
        try
        {
            await ConfigWriter.SaveSectionAsync("Heartbeat", _heartbeat);
            outcomes.Add("guscio: salvato");
        }
        catch (Exception ex)
        {
            outcomes.Add($"guscio: FALLITO ({ex.Message})");
            failed = true;
        }
        try
        {
            await EngineConfig.WriteAsync("Heartbeat", _heartbeat);
            outcomes.Add(EngineConfig.IsRemote ? "motore: salvato e ricaricato" : "motore in-process: stesso file del guscio");
        }
        catch (Exception ex)
        {
            outcomes.Add($"motore: FALLITO ({ex.Message})");
            failed = true;
        }

        _heartbeatStatus = string.Join(" · ", outcomes);
        _heartbeatIsError = failed;
    }

    /// <summary>[F5] Cambio run nel form: ricarica i grigi di QUEL run (dal suo artifact).</summary>
    private async Task OnGreyRunChangedAsync(ChangeEventArgs e)
    {
        _greyStatus = null;
        _greyChoices = [];
        _greyChoiceKey = "";
        _greyRunId = Guid.TryParse(e.Value?.ToString(), out var id) ? id : null;
        if (_greyRunId is Guid runId)
        {
            _greyChoices = (await GreyDeployer.ListGreyAsync(runId)).ToList();
            if (_greyChoices.Count > 0)
            {
                var first = _greyChoices[0];
                _greyChoiceKey = $"{first.StrategyName}|{first.Symbol}|{first.Timeframe}";
            }
            else
            {
                _greyStatus = "Nessun candidato grigio leggibile in quel run.";
                _greyIsError = true;
            }
        }
    }

    private async Task DeployGreyAsync()
    {
        if (_greyRunId is not Guid runId || string.IsNullOrEmpty(_greyChoiceKey)) return;
        var parts = _greyChoiceKey.Split('|');
        if (parts.Length != 3) return;
        _busy = true;
        try
        {
            var result = await GreyDeployer.DeployAsync(runId, parts[0], parts[1], parts[2], _greyLaneId, _greyStartPaper);
            _greyStatus = result.Message;
            _greyIsError = !result.Success;
            if (result.Success)
            {
                // Journal e corsie libere sono cambiati: si rilegge lo stato vero, non lo si finge.
                await OnInitializedAsync();
            }
        }
        catch (Exception ex)
        {
            _greyStatus = $"Schieramento fallito: {ex.Message}";
            _greyIsError = true;
        }
        finally { _busy = false; }
    }

