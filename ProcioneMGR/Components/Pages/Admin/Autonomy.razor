@page "/admin/autonomy"
@rendermode InteractiveServer
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Options
@using ProcioneMGR.Data
@using ProcioneMGR.Services.Agents
@using ProcioneMGR.Services.Carry
@using ProcioneMGR.Services.Config
@using ProcioneMGR.Services.Ensemble
@using ProcioneMGR.Services.Llm
@using ProcioneMGR.Services.MarketData
@using ProcioneMGR.Services.ML
@using ProcioneMGR.Services.Monitoring.Drift
@using ProcioneMGR.Services.Notifications
@using ProcioneMGR.Services.Pipeline
@using ProcioneMGR.Services.Registry
@using ProcioneMGR.Services.Trading
@attribute [Authorize(Roles = AppRoles.Admin)]

@inject IAppConfigWriter ConfigWriter
@inject IConfiguration Config
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IOptionsMonitor<AutoReapplyOptions> AutoReapplyMonitor
@inject IOptionsMonitor<PromotionEvaluatorOptions> PromotionMonitor
@inject IOptionsMonitor<LlmOptions> LlmMonitor
@inject IOptionsMonitor<SupervisorAgentOptions> SupervisorAgentMonitor
@inject IOptionsMonitor<DriftMonitorOptions> DriftMonitor
@inject ILlmClient LlmClient
@inject LlmSupervisorWorker LlmWorker
@inject FeatureDriftWorker DriftWorker
@inject IOptionsMonitor<ProcioneMGR.Services.Sentiment.SentimentOptions> SentimentMonitor
@inject ProcioneMGR.Services.Sentiment.SentimentSyncWorker SentimentWorker
@inject IOptionsMonitor<NotificationOptions> NotificationMonitor
@* Tipo CONCRETO e non INotifier: la prova ha bisogno dell'esito, che l'interfaccia non espone
   di proposito (i producer non devono avere un risultato da controllare). *@
@inject NotificationDispatcher Notifier
@inject IOptionsMonitor<CampaignOptions> CampaignMonitor
@inject IOptionsMonitor<RegimeTriggerOptions> RegimeTriggerMonitor
@inject IOptionsMonitor<ProcioneMGR.Services.Fleet.FleetOptions> FleetMonitor
@inject ProcioneMGR.Services.Fleet.FleetOrchestratorWorker FleetWorker
@inject ProcioneMGR.Services.Fleet.IGreyDeployer GreyDeployer
@inject ILaneDirectory LaneDirectory
@inject IPipelineApplier PipelineApplier
@inject IOptionsMonitor<ProcioneMGR.Services.Health.HeartbeatOptions> HeartbeatMonitor
@inject IOptionsMonitor<DigestOptions> DigestMonitor
@inject EnsembleComparatorOptions ComparatorOptions
@inject ModelRegistryOptions RegistryOptions
@* Carry, esecuzione live e dual-read ML vivono nell'host del MOTORE: la loro configurazione si
   legge e si scrive dove il motore la legge, non nel file di questo processo. Vedi IEngineConfigStore. *@
@inject IEngineConfigStore EngineConfig
@inject IOptionsMonitor<LiquidationsOptions> LiquidationsMonitor
@inject IServiceProvider Services

<PageTitle>Autonomia</PageTitle>

<h1>Controlli di autonomia <span class="badge bg-secondary">Admin</span></h1>

<GuidaPanel Title="Autonomia — tutti gli automatismi della piattaforma, in un posto solo">
    <p>
        La piattaforma ha diversi cicli automatici (esecuzione a fette, ri-applica dell'ensemble,
        promozione corsie, supervisione AI, drift monitor, sync dati). Finora si controllavano solo
        da <code>appsettings.json</code>: questa pagina li espone tutti, con salvataggio immediato.
        I valori vengono scritti in <code>appsettings.json</code> e ricaricati dall'app entro ~1
        secondo (<em>reload on change</em>) — <strong>senza riavvio</strong> per i campi marcati
        <span class="badge bg-success">a caldo</span>. I campi marcati
        <span class="badge bg-warning text-dark">riavvio</span> (gli intervalli dei timer) vengono
        salvati subito ma il nuovo valore vale dal prossimo riavvio dell'app.
    </p>
    <p class="mb-0">
        <strong>Confini di sicurezza (non modificabili da qui):</strong> nessun automatismo può
        portare una corsia in <strong>Live</strong> (la promozione arriva al massimo a Testnet, il
        Live resta manuale con conferma per-ordine); il layer AI è solo advisory e può al massimo
        porre un <em>veto</em>; la ri-applica scrive solo configurazione. Questi limiti sono nel
        codice, non in configurazione. Le protezioni che filtrano o fermano le
        <em>operazioni</em> (feed real-time, esposizione correlata, router di regime, watchdog)
        stanno in <a href="admin/protections">Protezioni</a>.
    </p>
</GuidaPanel>

@* Indice: dodici pannelli sono troppi per scorrerli a occhio ogni volta. *@
<nav class="mb-3 small">
    <span class="text-muted me-2">Vai a:</span>
    <a class="me-2" href="#p-exec">Esecuzione a fette</a>
    <a class="me-2" href="#p-reapply">Ri-applica</a>
    <a class="me-2" href="#p-promo">Promozione corsie</a>
    <a class="me-2" href="#p-llm">Supervisione AI</a>
    <a class="me-2" href="#p-veto">Supervisore veto</a>
    <a class="me-2" href="#p-campaign">Campagne</a>
    <a class="me-2" href="#p-sentiment">Sentiment</a>
    <a class="me-2" href="#p-drift">Drift feature</a>
    <a class="me-2" href="#p-carry">Carry</a>
    <a class="me-2" href="#p-liq">Liquidazioni</a>
    <a class="me-2" href="#p-sync">Sync &amp; regimi</a>
    <a class="me-2" href="#p-notif">Notifiche</a>
    <a class="me-2" href="#p-diag">Diagnostica</a>
</nav>

@if (!string.IsNullOrEmpty(_status))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success")">@_status</div>
}

@* ============================ 1. Esecuzione live a fette ============================ *@
<div class="card mb-3" id="p-exec">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-stack me-1"></i>Esecuzione live "a fette" (TWAP/VWAP/Iceberg)</span>
        <span>@StateBadge(_liveExec.Enabled)</span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Spezza gli ordini di apertura su Testnet/Live in fette temporali per ridurre l'impatto.
            Master switch default OFF: con l'interruttore spento nessun piano viene creato né avanzato.
            L'<code>ExecutionWorker</code> che avanza le fette vive nell'host del <strong>motore</strong>:
            questi campi sono letti dal motore e riscritti su di lui.
            @if (_engineSnapshot.SourceOf("Trading:LiveExecution") is { } leSource)
            {
                <text> Sorgente attuale: <code>@leSource</code>.</text>
            }
        </p>
        @if (!_engineSnapshot.Reachable)
        {
            <div class="alert alert-danger py-2 small">
                Motore non raggiungibile: @_engineSnapshot.Error I valori qui sotto sono i default,
                non salvare finché non risponde.
            </div>
        }
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="le_en" @bind="_liveExec.Enabled" />
                <label class="form-check-label" for="le_en">Abilitato @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Finestra default (min) @Hot()</label>
                <input type="number" class="form-control" @bind="_liveExec.DefaultWindowMinutes" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Tick worker (s) @Restart()</label>
                <input type="number" class="form-control" @bind="_liveExec.WorkerTickSeconds" min="5" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Grazia abbandono (min) @Hot()</label>
                <input type="number" class="form-control" @bind="_liveExec.AbandonGraceMinutes" min="0" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="SaveLiveExecAsync" disabled="@_busy">Salva</button>
            </div>
        </div>
    </div>
</div>

@* ============================ 2. Ri-applica automatica ============================ *@
<div class="card mb-3" id="p-reapply">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-arrow-repeat me-1"></i>Ri-applica automatica dell'ensemble</span>
        <span>@StateBadge(_autoReapply.Enabled)</span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Dopo ogni run schedulato completato, se il nuovo ensemble batte il corrente (confronto
            oggettivo con hysteresis) e il supervisore AI non pone veto, lo schiera da solo sulle
            corsie. Scrive SOLO configurazione: mai avvia trading, mai Live.
        </p>
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="ar_en" @bind="_autoReapply.Enabled" />
                <label class="form-check-label" for="ar_en">Abilitata @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Lookback (giorni) @Hot()</label>
                <input type="number" class="form-control" @bind="_autoReapply.LookbackDays" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Max run per tick @Hot()</label>
                <input type="number" class="form-control" @bind="_autoReapply.MaxPerTick" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick='() => SaveAsync("AutoReapply", _autoReapply, "Ri-applica automatica")' disabled="@_busy">Salva</button>
            </div>
        </div>
    </div>
</div>

@* ============================ 3. Promozione corsie ============================ *@
<div class="card mb-3" id="p-promo">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-ladder me-1"></i>Promozione corsie (Paper → Testnet, mai Live)</span>
        <span>@StateBadge(_promotion.AutoPromoteToTestnet)</span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Promuove a Testnet le corsie Paper che performano bene abbastanza a lungo, e retrocede
            a Paper quelle Testnet il cui edge svanisce. Le soglie valgono dal prossimo ciclo di
            valutazione (default ogni @_promotion.EvaluationIntervalHours h).
        </p>
        <div class="row g-3">
            <div class="col-auto form-check form-switch ms-2 align-self-end">
                <input class="form-check-input" type="checkbox" id="pr_auto" @bind="_promotion.AutoPromoteToTestnet" />
                <label class="form-check-label" for="pr_auto">Auto-promozione @Hot()</label>
            </div>
            <div class="col-auto form-check form-switch align-self-end">
                <input class="form-check-input" type="checkbox" id="pr_dem" @bind="_promotion.AutoDemoteToPaper" />
                <label class="form-check-label" for="pr_dem">Auto-retrocessione @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Sharpe minimo @Hot()</label>
                <input type="number" step="0.1" class="form-control" @bind="_promotion.MinSharpeRealized" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Trade minimi @Hot()</label>
                <input type="number" class="form-control" @bind="_promotion.MinTradeCount" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Settimane min @Hot()</label>
                <input type="number" class="form-control" @bind="_promotion.MinObservationWeeks" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Max drawdown % @Hot()</label>
                <input type="number" step="0.5" class="form-control" @bind="_promotion.MaxDrawdownPercent" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">DD hard-block % @Hot()</label>
                <input type="number" step="0.5" class="form-control" @bind="_promotion.HardMaxDrawdownPercent" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Win rate min (0-1) @Hot()</label>
                <input type="number" step="0.05" class="form-control" @bind="_promotion.MinWinRate" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Sharpe retrocessione @Hot()</label>
                <input type="number" step="0.1" class="form-control" @bind="_promotion.DemoteSharpeThreshold" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Intervallo (ore) @Restart()</label>
                <input type="number" class="form-control" @bind="_promotion.EvaluationIntervalHours" min="1" style="width: 8rem;" />
            </div>
        </div>
        <hr />
        @* [AF4a] La retrocessione di SICUREZZA Live→Testnet: unica estensione al perimetro Live,
           sola direzione che riduce il rischio. Verso Live non esiste alcun automatismo, mai. *@
        <p class="text-muted small mb-2">
            <strong>Retrocessione di sicurezza Live→Testnet</strong> — se una corsia LIVE degrada
            (Sharpe sotto soglia o drawdown oltre il limite, con storia sufficiente), il worker la
            riporta a Testnet chiudendo prima le posizioni reali reduce-only. Mai Paper diretto,
            mai il contrario. Col <em>dry-run</em> acceso (default) il verdetto si annuncia
            soltanto, nel pannello promozioni di /trading e nei log.
        </p>
        <div class="row g-3">
            <div class="col-auto form-check form-switch ms-2 align-self-end">
                <input class="form-check-input" type="checkbox" id="pr_demlive" @bind="_promotion.AutoDemoteLiveToTestnet" />
                <label class="form-check-label" for="pr_demlive">Retrocessione Live @Hot()</label>
            </div>
            <div class="col-auto form-check form-switch align-self-end">
                <input class="form-check-input" type="checkbox" id="pr_demlive_dry" @bind="_promotion.DemoteLiveDryRun" />
                <label class="form-check-label" for="pr_demlive_dry">Dry-run (solo annuncio) @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Sharpe sotto cui degrada @Hot()</label>
                <input type="number" step="0.1" class="form-control" @bind="_promotion.DemoteLiveSharpeThreshold" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">DD oltre cui degrada % @Hot()</label>
                <input type="number" step="0.5" class="form-control" @bind="_promotion.DemoteLiveMaxDrawdownPercent" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Settimane min @Hot()</label>
                <input type="number" class="form-control" @bind="_promotion.DemoteLiveMinWeeks" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Trade min @Hot()</label>
                <input type="number" class="form-control" @bind="_promotion.DemoteLiveMinTrades" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto align-self-end">
                <button class="btn btn-primary" @onclick='() => SaveAsync("PromotionEvaluator", _promotion, "Promozione corsie")' disabled="@_busy">Salva</button>
            </div>
        </div>
    </div>
</div>

@* ============================ 3-bis. [AF2] Decisioni della flotta (Queen Bee) ============================ *@
<div class="card mb-3" id="p-fleet">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-diagram-3 me-1"></i>Orchestratore di flotta (Queen Bee)</span>
        <span>
            @StateBadge(_fleet.Enabled)
            @if (_fleet.Enabled && _fleet.DryRun)
            {
                <span class="badge bg-info ms-1">DRY-RUN</span>
            }
        </span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Gestisce le corsie di flotta (dalla @(_fleetFootprint) in su, mai l'impronta storica
            dell'auto-apply né Live/Testnet/quarantene/campagne): assegna candidati validati alle
            corsie Paper libere, ritira i forward test perdenti (con isteresi), propone la fascia
            grigia al tuo click (F5). In DRY-RUN decide e journalizza senza eseguire — è
            l'incremento corrente. Config in sezione <code>Fleet</code>; ogni decisione è una riga qui sotto.
        </p>
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            <span class="badge bg-light text-dark">ultimo tick: @(FleetWorker.LastTickUtc?.ToLocalTime().ToString("dd/MM HH:mm") ?? "mai")</span>
            <span class="badge bg-light text-dark">azioni ultimo piano: @(FleetWorker.LastPlan?.Actions.Count ?? 0)</span>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-auto form-check form-switch ms-2 align-self-end">
                <input class="form-check-input" type="checkbox" id="fl_en" @bind="_fleet.Enabled" />
                <label class="form-check-label" for="fl_en">Attivo @Hot()</label>
            </div>
            <div class="col-auto form-check form-switch align-self-end">
                <input class="form-check-input" type="checkbox" id="fl_dry" @bind="_fleet.DryRun" />
                <label class="form-check-label" for="fl_dry" title="Finché è acceso: decide e journalizza, non esegue. L'esecuzione vera arriva con AF2b.">Dry-run @Hot()</label>
            </div>
            <div class="col-auto form-check form-switch align-self-end">
                <input class="form-check-input" type="checkbox" id="fl_committee" @bind="_fleet.UseCommittee" />
                <label class="form-check-label" for="fl_committee" title="[AF3] Sui pareggi (più candidati per lo stesso slot) chiede al comitato AI quale scegliere — solo dentro il menù pre-validato; serve anche Committee:Enabled in /admin/ai-supervisor.">Comitato AI @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Tick (min) @Hot()</label>
                <input type="number" class="form-control" @bind="_fleet.TickMinutes" min="1" style="width: 7rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Sharpe ritiro @Hot()</label>
                <input type="number" step="0.1" class="form-control" @bind="_fleet.RetireSharpeThreshold" style="width: 7rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Settimane min @Hot()</label>
                <input type="number" class="form-control" @bind="_fleet.RetireMinWeeks" min="1" style="width: 7rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Trade min @Hot()</label>
                <input type="number" class="form-control" @bind="_fleet.RetireMinTrades" min="1" style="width: 7rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Conferme (tick) @Hot()</label>
                <input type="number" class="form-control" @bind="_fleet.RetireConfirmTicks" min="1" style="width: 7rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Asseg./tick @Hot()</label>
                <input type="number" class="form-control" @bind="_fleet.MaxAssignmentsPerTick" min="1" style="width: 7rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Trade/mese min @Hot()</label>
                <input type="number" step="0.5" class="form-control" @bind="_fleet.MinTradesPerMonth" min="0" style="width: 7rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Età max cand. (gg) @Hot()</label>
                <input type="number" class="form-control" @bind="_fleet.CandidateMaxAgeDays" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label" title="Oltre queste corsie attive serve CorrelatedExposure acceso (/admin/protections).">Corsie senza guardia @Hot()</label>
                <input type="number" class="form-control" @bind="_fleet.MaxLanesWithoutExposureGuard" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Silenzio carry (h) @Hot()</label>
                <input type="number" class="form-control" @bind="_fleet.CarrySilenceAlertHours" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto align-self-end">
                <button class="btn btn-primary" @onclick='() => SaveAsync("Fleet", _fleet, "Orchestratore di flotta")' disabled="@_busy">Salva</button>
            </div>
        </div>
        @* [F5] IL CLICK UMANO: schiera un candidato grigio proposto su una corsia di flotta libera. *@
        @if (_greyRuns.Count > 0)
        {
            <div class="border rounded p-2 mb-3">
                <strong class="small">Schiera un candidato grigio (forward test Paper)</strong>
                <div class="row g-2 align-items-end mt-1">
                    <div class="col-auto">
                        <label class="form-label mb-0 small">Run proposto</label>
                        <select class="form-select form-select-sm" style="width: 11rem" value="@_greyRunId" @onchange="OnGreyRunChangedAsync">
                            <option value="">— scegli —</option>
                            @foreach (var runId in _greyRuns)
                            {
                                <option value="@runId">@runId.ToString()[..8]</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-0 small">Candidato (grigi del run)</label>
                        <select class="form-select form-select-sm" style="width: 26rem" @bind="_greyChoiceKey">
                            @foreach (var c in _greyChoices)
                            {
                                <option value="@($"{c.StrategyName}|{c.Symbol}|{c.Timeframe}")">
                                    @c.StrategyName @c.Symbol @c.Timeframe — Sharpe @c.HoldoutSharpe.ToString("F2") su @c.HoldoutTrades trade
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-0 small">Corsia libera</label>
                        <select class="form-select form-select-sm" style="width: 7rem" @bind="_greyLaneId">
                            @foreach (var lane in _freeFleetLanes)
                            {
                                <option value="@lane">@lane</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto form-check ms-2 mb-1">
                        <input type="checkbox" class="form-check-input" id="grey-start" @bind="_greyStartPaper" />
                        <label class="form-check-label small" for="grey-start">Avvia subito in Paper</label>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-sm btn-success" @onclick="DeployGreyAsync"
                                disabled="@(_busy || _greyRunId is null || _greyChoices.Count == 0 || _freeFleetLanes.Count == 0)">
                            Schiera
                        </button>
                    </div>
                </div>
                @if (_freeFleetLanes.Count == 0)
                {
                    <p class="text-muted small mt-1 mb-0">Nessuna corsia di flotta libera: ritira un forward test o attendi.</p>
                }
                @if (!string.IsNullOrEmpty(_greyStatus))
                {
                    <div class="alert @(_greyIsError ? "alert-danger" : "alert-success") py-2 mt-2 mb-0">@_greyStatus</div>
                }
            </div>
        }
        @if (_fleetJournal.Count == 0)
        {
            <p class="text-muted small mb-0"><em>Nessuna decisione a journal.</em></p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Quando</th><th>Tipo</th><th>Corsia</th><th>Run</th><th>Fonte</th><th>Esito</th><th>Motivo</th></tr></thead>
                    <tbody>
                        @foreach (var d in _fleetJournal)
                        {
                            <tr>
                                <td class="text-nowrap">@d.AtUtc.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                <td><span class="badge @FleetKindBadge(d.Kind)">@d.Kind</span></td>
                                <td>@(d.LaneId?.ToString() ?? "—")</td>
                                <td>@(d.RunId?.ToString()[..8] ?? "—")</td>
                                <td>@d.Source</td>
                                <td>
                                    @if (d.DryRun) { <span class="badge bg-info">dry-run</span> }
                                    else if (d.Applied) { <span class="badge bg-success">eseguita</span> }
                                    else if (d.Error is not null) { <span class="badge bg-danger" title="@d.Error">errore</span> }
                                    else { <span class="badge bg-secondary">no</span> }
                                </td>
                                <td class="small">@d.Reason</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ============================ 3-ter. [AF5.1] Heartbeat incrociato ============================ *@
<div class="card mb-3" id="p-heartbeat">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-activity me-1"></i>Heartbeat incrociato guscio ↔ motore</span>
        <span>@StateBadge(_heartbeat.Enabled)</span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Ogni host scrive il proprio battito a database (sezione <code>Heartbeat</code>) e
            sorveglia quello dell'ALTRO: se il motore tace, il guscio manda un Warning; se tace il
            guscio, lo manda il motore. Copre la morte di UN processo — per «muore tutto» ci sono
            <code>scripts/watchdog.ps1</code> (Task Scheduler, Telegram diretto) e l'assenza del
            digest giornaliero. Il salvataggio scrive ENTRAMBI gli host (guscio su file, motore via
            gRPC): due processi, uno stato desiderato.
        </p>
        <div class="row g-3">
            <div class="col-auto form-check form-switch ms-2 align-self-end">
                <input class="form-check-input" type="checkbox" id="hb_en" @bind="_heartbeat.Enabled" />
                <label class="form-check-label" for="hb_en">Attivo @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Battito ogni (s) @Hot()</label>
                <input type="number" class="form-control" @bind="_heartbeat.WriteSeconds" min="10" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Muto dopo (min) @Hot()</label>
                <input type="number" class="form-control" @bind="_heartbeat.StaleMinutes" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto align-self-end">
                <button class="btn btn-primary" @onclick="SaveHeartbeatAsync" disabled="@_busy">Salva (guscio + motore)</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_heartbeatStatus))
        {
            <div class="alert @(_heartbeatIsError ? "alert-danger" : "alert-success") py-2 mt-2 mb-0">@_heartbeatStatus</div>
        }
    </div>
</div>

@* ============================ 4. Supervisione AI (LLM) ============================ *@
<div class="card mb-3" id="p-llm">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-robot me-1"></i>Supervisione AI dei run (advisory)</span>
        <span>
            @if (LlmClient.IsConfigured)
            { <span class="badge bg-success me-1">ANTHROPIC_API_KEY presente</span> }
            else
            { <span class="badge bg-danger me-1">ANTHROPIC_API_KEY assente</span> }
            @StateBadge(_llm.Enabled)
        </span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Dopo ogni run del pipeline, l'agente AI scrive un parere leggibile (mai comandi). La API
            key si legge SOLO dalla variabile d'ambiente <code>ANTHROPIC_API_KEY</code>: se assente,
            il worker resta in attesa e la ritenta a ogni tick (nessun riavvio necessario). Gli
            errori transitori (credito, rate-limit, rete) aprono un breaker che sospende le chiamate,
            avvisa una volta e si richiude da solo quando il problema rientra — stato e recupero in
            <a href="admin/ai-supervisor">/admin/ai-supervisor</a>.
        </p>
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="llm_en" @bind="_llm.Enabled" />
                <label class="form-check-label" for="llm_en">Abilitata @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Modello @Hot()</label>
                <input class="form-control" @bind="_llm.Model" style="width: 14rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Max token @Hot()</label>
                <input type="number" class="form-control" @bind="_llm.MaxTokens" min="256" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Poll (min) @Restart()</label>
                <input type="number" class="form-control" @bind="_llm.PollIntervalMinutes" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Timeout chiamata (s) @Hot()</label>
                <input type="number" class="form-control" @bind="_llm.RequestTimeoutSeconds" min="5" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Errori per sospendere @Hot()</label>
                <input type="number" class="form-control" @bind="_llm.BreakerFailureThreshold" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Riprova ogni (min) @Hot()</label>
                <input type="number" class="form-control" @bind="_llm.BreakerCooldownMinutes" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto form-check form-switch align-self-end">
                <input class="form-check-input" type="checkbox" id="llm_nd" @bind="_llm.NotifyDecisions" />
                <label class="form-check-label" for="llm_nd">Notifica decisioni @Hot()</label>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary me-2" @onclick='() => SaveAsync("Llm", _llm, "Supervisione AI")' disabled="@_busy">Salva</button>
                <button class="btn btn-outline-secondary" @onclick="RunLlmNowAsync" disabled="@_busy">
                    @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Esegui supervisione ora
                </button>
            </div>
        </div>
    </div>
</div>

@* ============================ 4b. Supervisore veto (ri-applica) ============================ *@
<div class="card mb-3" id="p-veto">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-shield-check me-1"></i>Supervisore veto del ciclo di ri-applica</span>
        <span>
            @if (string.Equals(_supervisorAgent.Provider, "Claude", StringComparison.OrdinalIgnoreCase))
            { <span class="badge bg-success">Claude</span> }
            else
            { <span class="badge bg-secondary">Logging (solo metriche)</span> }
        </span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Prima di ogni ri-applica automatica il supervisore può porre un <strong>veto</strong>
            (mai forzare, mai avviare trading). Provider "Claude" usa la stessa chiave e lo stesso
            breaker della supervisione advisory; su qualunque problema approva subito e decidono le
            metriche. Il cambio provider vale dalla prossima valutazione, senza riavvio.
        </p>
        <div class="row g-3 align-items-end">
            <div class="col-auto">
                <label class="form-label">Provider @Hot()</label>
                <select class="form-select" @bind="_supervisorAgent.Provider" style="width: 10rem;">
                    <option value="Logging">Logging</option>
                    <option value="Claude">Claude</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Timeout (s) @Hot()</label>
                <input type="number" class="form-control" @bind="_supervisorAgent.TimeoutSeconds" min="5" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick='() => SaveAsync("PipelineSupervisor", _supervisorAgent, "Supervisore veto")' disabled="@_busy">Salva</button>
            </div>
        </div>
    </div>
</div>

@* ============================ 4c. Sentiment 2.0 (raccolta + composite) ============================ *@
<div class="card mb-3" id="p-sentiment">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-emoji-neutral me-1"></i>Sentiment (mood di mercato)</span>
        <span>@StateBadge(_sentiment.Enabled)</span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Raccoglie Fear &amp; Greed (alternative.me) e posizionamento pubblico dai futures Binance
            (long/short, taker, open interest, funding — API senza chiave), sincronizza le notizie e
            calcola il composite di mood con z-score ed estremi contrarian (dashboard in
            <a href="sentiment">/sentiment</a>). Default ON: sole letture pubbliche, e le serie
            Binance esistono solo 30 giorni — spento significa buchi irrecuperabili nei baseline.
        </p>
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="se_en" @bind="_sentiment.Enabled" />
                <label class="form-check-label" for="se_en">Abilitato @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Metriche (min) @Restart()</label>
                <input type="number" class="form-control" @bind="_sentiment.MetricsIntervalMinutes" min="5" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">News (min) @Restart()</label>
                <input type="number" class="form-control" @bind="_sentiment.NewsIntervalMinutes" min="5" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Simboli (csv) @Hot()</label>
                <input class="form-control" @bind="_sentimentSymbolsCsv" style="width: 14rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Soglia z estremi @Hot()</label>
                <input type="number" step="0.1" class="form-control" @bind="_sentiment.ExtremeZScore" min="0.5" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">F&amp;G low/high @Hot()</label>
                <div class="d-flex gap-1">
                    <input type="number" class="form-control" @bind="_sentiment.FearGreedExtremeLow" min="0" max="50" style="width: 5rem;" />
                    <input type="number" class="form-control" @bind="_sentiment.FearGreedExtremeHigh" min="50" max="100" style="width: 5rem;" />
                </div>
            </div>
            <div class="col-auto form-check form-switch align-self-end">
                <input class="form-check-input" type="checkbox" id="se_ml" @bind="_sentiment.EnableMlFeature" />
                <label class="form-check-label" for="se_ml" title="Rende il fattore 'Sentiment' selezionabile come feature dei modelli ML. Scelta esplicita: cambia cosa vedono i modelli nei run successivi.">
                    Feature ML ⚠️ @Hot()
                </label>
            </div>
        </div>

        <hr class="my-3" />
        <h6 class="mb-1"><i class="bi bi-shield-exclamation me-1"></i>Guardiano serie-patrimonio</h6>
        <p class="text-muted small">
            Misura periodicamente la profondità delle tre serie ESENTI dalla purge (funding storico,
            Fear &amp; Greed, liquidazioni) contro le soglie dichiarate qui: la storia del funding dal
            2019 è andata persa <strong>due volte in silenzio</strong> (2026-07-24 e 2026-08-11), con
            carry e backtest a leva che leggevano una serie corta senza che nessun controllo lo
            dicesse. Su violazione: log Error, notifica (una per transizione), badge in
            <a href="sentiment">/sentiment</a> e alert in Home. Spegnerlo significa tornare a non
            accorgersene.
        </p>
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="se_hg_en" @bind="_sentiment.HeritageGuard.Enabled" />
                <label class="form-check-label" for="se_hg_en">Abilitato @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Controllo (ore) @Restart()</label>
                <input type="number" class="form-control" @bind="_sentiment.HeritageGuard.CheckIntervalHours" min="1" style="width: 7rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label" title="Ticker base (BTC, ETH, …) su cui si pretende la storia profonda del funding. Vuoto = i sei del backfill T0.2.">Funding: simboli (csv) @Hot()</label>
                <input class="form-control" @bind="_heritageFundingSymbolsCsv" style="width: 16rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label" title="La storia del funding deve arrivare almeno a questa data (il backfill parte dal 2019-09).">Funding: storia da ≤ @Hot()</label>
                <input type="date" class="form-control" @bind="_sentiment.HeritageGuard.FundingMinStartUtc" style="width: 11rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label" title="Eventi minimi per simbolo (~3/giorno: dal 2019 sono ~7.000).">Funding: punti min @Hot()</label>
                <input type="number" class="form-control" @bind="_sentiment.HeritageGuard.FundingMinEventsPerSymbol" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label" title="Il baseline lungo del Fear & Greed deve arrivare almeno a questa data (la fonte parte dal 2018-02).">F&amp;G: storia da ≤ @Hot()</label>
                <input type="date" class="form-control" @bind="_sentiment.HeritageGuard.FearGreedMinStartUtc" style="width: 11rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">F&amp;G: punti min @Hot()</label>
                <input type="number" class="form-control" @bind="_sentiment.HeritageGuard.FearGreedMinPoints" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto form-check form-switch align-self-end">
                <input class="form-check-input" type="checkbox" id="se_hg_liq" @bind="_sentiment.HeritageGuard.LiquidationsEnforced" />
                <label class="form-check-label" for="se_hg_liq" title="OFF = la riga resta misurata e mostrata in /sentiment come NON SORVEGLIATA, ma non genera allarmi. Da spegnere SOLO se lo stream futures è strutturalmente muto dalla postazione (blocco MiCA/EEA sul market-data derivati, trovato dal vivo il 2026-07-24): lì l'accumulo resta a zero per costruzione e l'allarme perpetuo smetterebbe di essere letto.">
                    Sorveglia liquidazioni @Hot()
                </label>
            </div>
            <div class="col-auto">
                <label class="form-label" title="L'accumulo delle liquidazioni (iniziato il 2026-07-24) NON è ricostruibile: se il punto più vecchio è più recente di questa data, l'accumulo è andato perso.">Liquidazioni: storia da ≤ @Hot()</label>
                <input type="date" class="form-control" @bind="_sentiment.HeritageGuard.LiquidationsMinStartUtc" style="width: 11rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Liquidazioni: punti min @Hot()</label>
                <input type="number" class="form-control" @bind="_sentiment.HeritageGuard.LiquidationsMinPoints" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary me-2" @onclick="SaveSentimentAsync" disabled="@_busy">Salva</button>
                <button class="btn btn-outline-secondary" @onclick="RunSentimentNowAsync" disabled="@_busy">
                    @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Esegui ora
                </button>
            </div>
        </div>
    </div>
</div>

@* ============================ 5. Drift feature ============================ *@
<div class="card mb-3" id="p-drift">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-graph-down-arrow me-1"></i>Drift monitor delle feature ML</span>
        <span>@StateBadge(_drift.Enabled)</span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Confronta periodicamente la distribuzione recente delle feature di ogni modello salvato
            con quella di training (PSI, KS, Page-Hinkley). Un Champion in alert può essere ritirato
            automaticamente dal registry (solo governance dei record: nessun retrain automatico,
            nessun impatto sul trading). Ogni check viene registrato nella tabella qui sotto.
        </p>
        <div class="row g-3 align-items-end mb-3">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="dr_en" @bind="_drift.Enabled" />
                <label class="form-check-label" for="dr_en">Abilitato @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Intervallo (ore) @Restart()</label>
                <input type="number" class="form-control" @bind="_drift.IntervalHours" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Candele recenti @Hot()</label>
                <input type="number" class="form-control" @bind="_drift.RecentCandles" min="20" style="width: 8rem;" />
            </div>
            <div class="col-auto form-check form-switch">
                <input class="form-check-input" type="checkbox" id="dr_ret" @bind="_drift.RetireChampionOnAlert" />
                <label class="form-check-label" for="dr_ret">Ritira Champion in alert @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Alert min per ritiro @Hot()</label>
                <input type="number" class="form-control" @bind="_drift.MinAlertsToRetire" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary me-2" @onclick='() => SaveAsync("Drift", _drift, "Drift monitor")' disabled="@_busy">Salva</button>
                <button class="btn btn-outline-secondary" @onclick="RunDriftNowAsync" disabled="@_busy">
                    @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Esegui check ora
                </button>
            </div>
        </div>

        <h6>Ultimi esiti (@_driftResults.Count)</h6>
        @if (_driftResults.Count == 0)
        {
            <p class="text-muted small mb-0"><em>Nessun check registrato: abilita il worker o usa "Esegui check ora" (serve almeno un modello ML salvato).</em></p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Quando (UTC)</th><th>Modello</th><th>Serie</th>
                            <th class="text-end">Feature drift/tot</th><th class="text-end">Alert</th>
                            <th>Esito</th><th>Top feature</th><th>Champion ritirato</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _driftResults)
                        {
                            <tr>
                                <td>@r.CheckedAtUtc.ToString("MM-dd HH:mm")</td>
                                <td>@r.ModelName</td>
                                <td>@r.Symbol @r.Timeframe</td>
                                <td class="text-end">@r.DriftingFeatures/@r.TotalFeatures</td>
                                <td class="text-end">@r.AlertFeatures</td>
                                <td>@SeverityBadge(r.Overall)</td>
                                <td class="small">@TopFeatures(r.TopFeaturesJson)</td>
                                <td>@(r.ChampionRetired ? "⚠️ sì" : "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* ============================ 6. Sync dati & retraining regime ============================ *@
<div class="card mb-3" id="p-sync">
    <div class="card-header"><i class="bi bi-cloud-arrow-down me-1"></i>Sync dati di mercato &amp; retraining regime</div>
    <div class="card-body">
        <p class="text-muted small">
            Il sync scarica le candele nuove per le serie abilitate della watchlist; il retraining
            riallena periodicamente il modello di regime (attivandolo solo se il Silhouette migliora).
        </p>
        @if (_remoteIngestion)
        {
            @* [E4, 2026-07-31] Con MarketData:UseRemoteIngestion=true lo scheduling vive nel servizio
               ingestion in-cluster, che legge la SUA configurazione: questi tre campi scriverebbero il
               file del guscio, dove NESSUN worker li legge (il worker locale non è nemmeno registrato).
               Salvare qui mostrerebbe un verde e non muoverebbe nulla — la stessa forma del difetto
               dei pannelli che configuravano un motore che non li leggeva. Finché non esiste un canale
               di configurazione verso l'ingestion (non giustificato oggi: la cadenza non si tocca da
               settimane), la manopola si dichiara inerte invece di fingere. *@
            <div class="alert alert-warning py-2 small">
                <strong>Ingestion remota attiva</strong> (<code>MarketData:UseRemoteIngestion=true</code>):
                lo scheduling del sync gira nel servizio <code>procionemgr-ingestion</code> in-cluster,
                che legge la <em>propria</em> configurazione. Questi campi non lo raggiungono e sono
                disabilitati: cadenza, interruttore e backfill si cambiano nella ConfigMap del
                deployment ingestion (<code>infra/k8s/ingestion/</code>) e con un rollout. Le sync
                puntuali da /watchlist funzionano comunque (delegate via REST).
            </div>
        }
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="md_en" @bind="_marketData.Enabled" disabled="@_remoteIngestion" />
                <label class="form-check-label" for="md_en">Sync abilitato @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Intervallo sync (min) @Restart()</label>
                <input type="number" class="form-control" @bind="_marketData.SyncIntervalMinutes" min="1" style="width: 9rem;" disabled="@_remoteIngestion" />
            </div>
            <div class="col-auto">
                <label class="form-label">Backfill default (giorni) @Hot()</label>
                <input type="number" class="form-control" @bind="_marketData.DefaultBackfillDays" min="1" style="width: 9rem;" disabled="@_remoteIngestion" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick='() => SaveAsync("MarketData", _marketData, "Sync dati")' disabled="@(_busy || _remoteIngestion)">Salva</button>
            </div>
        </div>

        @* [Fase 3] Topologia dell'ingestion (MarketData:UseRemoteIngestion +
           MarketData:RemoteIngestionUrl). Prima era «deliberatamente senza UI»; la regola della
           piattaforma è che l'amministratore governa tutto da qui, quindi la manopola c'è — ma il
           vincolo di deploy resta vero e sta scritto accanto, non nascosto in un commento del file. *@
        <div class="border rounded p-2 bg-body-tertiary mt-3">
            <div class="fw-semibold small mb-1">Topologia ingestion @Restart()</div>
            <div class="alert alert-danger py-2 small mb-2">
                <strong>Regola «un solo scrittore».</strong> Vale dal riavvio, e va cambiata INSIEME
                al deployment: con l'ingestion remota accesa serve il servizio
                <code>procionemgr-ingestion</code> vivo in-cluster; spegnendola, quel servizio va
                fermato. L'interruttore giusto col deployment sbagliato lascia la watchlist senza
                aggiornamenti — o con due scrittori sulla stessa serie.
            </div>
            <div class="row g-3 align-items-end">
                <div class="col-auto form-check form-switch ms-2">
                    <input class="form-check-input" type="checkbox" id="md_remote" @bind="_marketData.UseRemoteIngestion" />
                    <label class="form-check-label" for="md_remote">Ingestion remota (UseRemoteIngestion) @Restart()</label>
                </div>
                <div class="col-auto">
                    <label class="form-label">URL del servizio (RemoteIngestionUrl) @Restart()</label>
                    <input class="form-control" @bind="_marketData.RemoteIngestionUrl" placeholder="http://procionemgr-ingestion:8080" style="width: 22rem;" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-outline-danger" @onclick="SaveIngestionTopologyAsync" disabled="@_busy">Salva topologia</button>
                </div>
            </div>
        </div>
        <hr />
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="mr_en" @bind="_marketRegime.Enabled" />
                <label class="form-check-label" for="mr_en">Retraining abilitato @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Intervallo (giorni) @Restart()</label>
                <input type="number" class="form-control" @bind="_marketRegime.RetrainingIntervalDays" min="1" style="width: 9rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Algoritmo (MarketRegime:Model) @Hot()</label>
                <select class="form-select" @bind="_marketRegime.Model" style="width: 13rem;">
                    <option value="KMeans">KMeans (default)</option>
                    <option value="Jump">Jump (sperimentale)</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">λ del Jump (JumpLambda) @Hot()</label>
                <input type="number" step="any" class="form-control" @bind="_marketRegime.JumpLambda" min="0" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="SaveMarketRegimeAsync" disabled="@_busy">Salva</button>
            </div>
        </div>
        @* [2.7/C1] La misura decide, non la sensazione: il numero da guardare esiste già. *@
        <div class="form-text mt-1">
            Contratto C1: il default resta <strong>KMeans</strong> finché la misura non decide.
            Ogni training scrive nei log il <strong>confronto delle transizioni</strong> fra K-means
            e Jump sulla stessa serie: cambia algoritmo dopo aver letto quel confronto. Il singolo
            run di pipeline può già forzarlo col parametro di stage <code>model</code>, senza toccare
            questo default.
        </div>
    </div>
</div>

@* ============================ 7. Campagne + trigger contestuale ============================ *@
<div class="card mb-3" id="p-campaign">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-bullseye me-1"></i>Campagne di ricerca (rotazione automatica)</span>
        <span>@StateBadge(_campaign.Enabled)</span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            <strong>È IL cambio di natura da strumento ad agente</strong>, ed è per questo che il
            gate globale nasce spento: con l'interruttore giù le campagne definite in
            <a href="campaign">/campaign</a> si preparano ma nessun run parte da solo. L'applica dei
            risultati passa comunque dalla stessa catena della ri-applica (isteresi + veto del
            supervisore); le corsie vengono avviate al massimo in Paper, le configurazioni Live
            sempre saltate.
        </p>
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="cp_en" @bind="_campaign.Enabled" />
                <label class="form-check-label" for="cp_en">Planner abilitato ⚠️ @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Tick planner (s) @Restart()</label>
                <input type="number" class="form-control" @bind="_campaign.TickSeconds" min="10" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick='() => SaveAsync("Campaign", _campaign, "Campagne")' disabled="@_busy">Salva</button>
            </div>
        </div>
        <hr />
        <p class="text-muted small mb-2">
            <strong>Trigger contestuale.</strong> Sveglia il planner quando il cluster K-means
            corrente cambia rispetto all'ultimo run della campagna, o quando la volatilità realizzata
            esce dalla banda [forecast/k, forecast×k] del forecast GARCH di quel run. Non lancia
            <em>mai</em> run direttamente: parla solo col planner, ed è quindi inerte se il gate qui
            sopra è spento.
        </p>
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="rt_tr_en" @bind="_regimeTrigger.Enabled" />
                <label class="form-check-label" for="rt_tr_en">Trigger abilitato @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Controllo ogni (min) @Restart()</label>
                <input type="number" class="form-control" @bind="_regimeTrigger.CheckIntervalMinutes" min="1" style="width: 9rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Cooldown (ore) @Hot()</label>
                <input type="number" class="form-control" @bind="_regimeTrigger.CooldownHours" min="0" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Banda volatilità (k) @Hot()</label>
                <input type="number" step="0.1" class="form-control" @bind="_regimeTrigger.VolBandMultiple" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick='() => SaveAsync("RegimeTrigger", _regimeTrigger, "Trigger contestuale")' disabled="@_busy">Salva</button>
            </div>
        </div>
    </div>
</div>

@* ============================ 8. Soglie di consolidamento ============================ *@
<div class="card mb-3" id="p-thresholds">
    <div class="card-header">
        <i class="bi bi-rulers me-1"></i>Soglie di consolidamento (quando un candidato è «meglio»)
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Sono i numeri che decidono se un ensemble nuovo sostituisce quello in corsia e se un
            modello ML può diventare <strong>Champion</strong>. Alzarli rende la piattaforma più
            difficile da convincere; abbassarli la rende più reattiva al rumore — che è il modo
            classico di scambiare fortuna per edge. Valgono dal prossimo riavvio: queste due sezioni
            si leggono una sola volta all'avvio.
        </p>
        <div class="row g-3 align-items-end">
            <div class="col-auto">
                <label class="form-label">Sharpe migliore di almeno (%) @Restart()</label>
                <input type="number" step="1" class="form-control" @bind="_comparator.MinSharpeImprovementPercent" style="width: 10rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Fattore di rischio migliore di (%) @Restart()</label>
                <input type="number" step="1" class="form-control" @bind="_comparator.MinRiskFactorImprovementPercent" style="width: 10rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Gambe minime @Restart()</label>
                <input type="number" class="form-control" @bind="_comparator.MinLegs" min="1" style="width: 7rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Simboli distinti minimi @Restart()</label>
                <input type="number" class="form-control" @bind="_comparator.MinDistinctSymbols" min="1" style="width: 9rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">z di significatività @Restart()</label>
                <input type="number" step="0.1" class="form-control" @bind="_comparator.MinSharpeSignificanceZ" style="width: 9rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick='() => SaveAsync("EnsembleComparator", _comparator, "Comparatore ensemble")' disabled="@_busy">Salva</button>
            </div>
        </div>
        <hr />
        <div class="row g-3 align-items-end">
            <div class="col-auto">
                <label class="form-label">Deflated Sharpe minimo per Champion @Restart()</label>
                <input type="number" step="0.01" class="form-control" @bind="_registry.MinChampionDeflatedSharpe" min="0" max="1" style="width: 10rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick='() => SaveAsync("Registry", _registry, "Registry modelli")' disabled="@_busy">Salva</button>
            </div>
            <div class="col-12">
                <span class="text-muted small">
                    Soglia ASSOLUTA (Bailey–López de Prado), non solo «batte l'incumbent»: 0,95 =
                    significatività difendibile. Il DSR si calcola al salvataggio del modello in
                    <a href="ml">/ml</a> e nella validazione holdout della pipeline.
                </span>
            </div>
        </div>
    </div>
</div>

@* ============================ 9. Carry forward test ============================ *@
<div class="card mb-3" id="p-carry">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-cash-coin me-1"></i>Forward test del carry delta-neutro</span>
        <span>
            @* Parentesi obbligatorie: un'espressione implicita Razor si ferma prima di ??, e il
               fallback finirebbe nella pagina come testo letterale. *@
            <span class="badge bg-light text-dark border me-1">@(CarryWorkerInstance?.EffectiveMode.ToString() ?? "Paper")</span>
            @StateBadge(_carry.Enabled)
        </span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Long spot + short perp sullo stesso simbolo: l'edge è il <strong>funding incassato</strong>
            dallo short quando è positivo — un flusso, non una previsione — e la componente
            direzionale si elide fra le due gambe. Apre sopra la soglia di ingresso, chiude sotto
            quella di uscita (l'isteresi fra le due impedisce di aprire e chiudere nella stessa
            valutazione). Il funding lo legge dalle stesse serie del Sentiment.
        </p>
        <div class="alert alert-secondary py-2 small mb-3">
            <strong>Live è irrappresentabile:</strong> non esiste come valore, quindi nessun percorso
            di codice e nessuna configurazione può portare il carry a operare con denaro reale.
            Testnet è accettato ma degrada a Paper finché l'executor Bitget demo non è attivo.
        </div>
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="ca_en" @bind="_carry.Enabled" />
                <label class="form-check-label" for="ca_en">Abilitato @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Modalità @Hot()</label>
                <select class="form-select" @bind="_carry.Mode" style="width: 9rem;">
                    <option value="Paper">Paper</option>
                    <option value="Testnet">Testnet</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Simboli (csv) @Hot()</label>
                <input class="form-control" @bind="_carrySymbolsCsv" style="width: 18rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Valutazione (min) @Restart()</label>
                <input type="number" class="form-control" @bind="_carry.EvaluationMinutes" min="5" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Entra sopra (% annuo) @Hot()</label>
                <input type="number" step="0.5" class="form-control" @bind="_carry.EnterAnnualFundingPercent" style="width: 9rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Esce sotto (% annuo) @Hot()</label>
                <input type="number" step="0.5" class="form-control" @bind="_carry.ExitAnnualFundingPercent" style="width: 9rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Eventi funding in media @Hot()</label>
                <input type="number" class="form-control" @bind="_carry.TrailingFundingEvents" min="1" style="width: 9rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Size per gamba (%) @Hot()</label>
                <input type="number" step="5" class="form-control" @bind="_carry.PositionSizePercent" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary me-2" @onclick="SaveCarryAsync" disabled="@_busy">Salva</button>
                <button class="btn btn-outline-secondary" @onclick="RunCarryNowAsync" disabled="@(_busy || CarryWorkerInstance is null)">
                    @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Valuta ora
                </button>
            </div>
        </div>

        @if (CarryWorkerInstance is null)
        {
            @* Storia di questo riquadro, perché non venga "semplificato" all'indietro: prima
               affermava che la config salvata qui fosse quella letta dal motore (falso), poi che
               non lo raggiungesse affatto (vero ma inutile). Ora la raggiunge davvero, via gRPC. *@
            <div class="alert alert-info py-2 small mb-0 mt-3">
                <strong>Il forward test gira nell'host del motore</strong>
                (<code>procionemgr-trading</code>), non qui: lo stato dal vivo delle posizioni si
                legge nei log del pod. La <em>configurazione</em> qui sopra è invece quella vera —
                letta dal motore e riscritta su di lui.
                @if (!string.IsNullOrEmpty(_engineSnapshot.ConfigPath))
                {
                    <text> Il motore scrive in <code>@_engineSnapshot.ConfigPath</code>.</text>
                }
                @if (_engineSnapshot.SourceOf("Carry") is { } source)
                {
                    <text> Sorgente attuale: <code>@source</code>.</text>
                }
            </div>
        }
        else
        {
            <h6 class="mt-3">
                Stato del forward test
                @if (CarryWorkerInstance.LastEvaluationUtc is { } last)
                {
                    <span class="text-muted small fw-normal">— ultima valutazione @last.ToString("dd/MM HH:mm") UTC</span>
                }
            </h6>
            @if (CarryWorkerInstance.States.Count == 0)
            {
                <p class="text-muted small mb-0">
                    <em>Nessuna valutazione ancora: serve il carry abilitato e almeno
                    @_carry.TrailingFundingEvents punti di funding per simbolo (li raccoglie il worker Sentiment).</em>
                </p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped mb-0">
                        <thead>
                            <tr><th>Simbolo</th><th>Stato</th><th>Aperto da (UTC)</th><th class="text-end">Nozionale/gamba</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var (symbol, state) in CarryWorkerInstance.States.OrderBy(kv => kv.Key))
                            {
                                <tr>
                                    <td>@symbol</td>
                                    <td>
                                        @if (state.InPosition)
                                        { <span class="badge bg-success">in posizione</span> }
                                        else
                                        { <span class="badge bg-secondary">fuori</span> }
                                    </td>
                                    <td>@(state.OpenedUtc?.ToString("dd/MM HH:mm") ?? "—")</td>
                                    <td class="text-end tabular-nums">@(state.InPosition ? state.NotionalQuote.ToString("N0") : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (CarryWorkerInstance.SymbolsWithoutData.Count > 0)
            {
                <p class="text-muted small mb-0 mt-2">
                    Senza storia di funding sufficiente: @string.Join(", ", CarryWorkerInstance.SymbolsWithoutData).
                </p>
            }
        }
    </div>
</div>

@* ============================ 10. Accumulo liquidazioni ============================ *@
<div class="card mb-3" id="p-liq">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-lightning-charge me-1"></i>Accumulo liquidazioni (stream pubblico Binance)</span>
        <span>
            @* "Connesso" con zero messaggi NON è uno stato sano su questo feed: è la firma esatta
               del blocco EEA/MiCA. Un badge verde lì sopra direbbe la cosa sbagliata. *@
            @if (LiquidationWorker.IsConnected && LiquidationWorker.TotalMessages > 0)
            { <span class="badge bg-success me-1">connesso · @LiquidationWorker.TotalMessages msg</span> }
            else if (LiquidationWorker.IsConnected)
            { <span class="badge bg-warning text-dark me-1">connesso ma muto</span> }
            else if (_liquidations.Enabled)
            { <span class="badge bg-warning text-dark me-1">non connesso</span> }
            @StateBadge(_liquidations.Enabled)
        </span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Accumula le liquidazioni forzate del mercato futures in sola lettura (stream keyless).
            <strong>Default acceso perché il dato non è ricostruibile a posteriori</strong>: ogni
            giorno spento è storia persa. Oggi non decide nulla — è un investimento per l'event-study
            e per le future feature di fragilità, che passeranno dal gate come ogni altra ipotesi.
        </p>
        @* La condizione è "acceso e zero messaggi", NON "acceso e non connesso": il guasto vero è
           proprio il socket che si apre e non consegna nulla, e la prima versione di questo avviso
           lo escludeva — non compariva mai nell'unico caso per cui era stato scritto. Trovato
           aprendo la pagina sull'app reale, dove il badge diceva "connesso · 0 msg". *@
        @if (_liquidations.Enabled && LiquidationWorker.TotalMessages == 0)
        {
            <div class="alert alert-warning py-2 small">
                <strong>Nessun messaggio ricevuto finora.</strong>
                @if (LiquidationWorker.IsConnected)
                {
                    <text>
                        Il socket è aperto e non consegna nulla: è la firma del blocco EEA/MiCA del
                        market-data derivati Binance da questa postazione (verificabile con
                        <code>streamdiag</code>: lo SPOT funziona, i FUTURES no). Il worker passa da
                        solo a un retry lungo e riparte se l'app gira da una postazione non bloccata.
                    </text>
                }
                else
                {
                    <text>
                        Il canale non è ancora aperto. Se l'app è appena partita è normale: attendi
                        qualche secondo e ricarica.
                    </text>
                }
            </div>
        }
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="lq_en" @bind="_liquidations.Enabled" />
                <label class="form-check-label" for="lq_en">Abilitato @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Flush su DB (min) @Hot()</label>
                <input type="number" class="form-control" @bind="_liquidations.FlushMinutes" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Silenzio = guasto (s) @Hot()</label>
                <input type="number" class="form-control" @bind="_liquidations.StaleSeconds" min="60" style="width: 9rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Retry se bloccato (min) @Hot()</label>
                <input type="number" class="form-control" @bind="_liquidations.BlockedRetryMinutes" min="1" style="width: 9rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick='() => SaveAsync("Liquidations", _liquidations, "Accumulo liquidazioni")' disabled="@_busy">Salva</button>
            </div>
        </div>
    </div>
</div>

@* ============================ 11. Notifiche all'operatore ============================ *@
<div class="card mb-3" id="p-notif">
    <div class="card-header d-flex justify-content-between">
        <span><i class="bi bi-bell me-1"></i>Notifiche all'operatore</span>
        <span>
            @if (_notifications.Enabled && _notifications.Provider == "Telegram")
            { <span class="badge bg-info text-dark me-1">Telegram</span> }
            else if (_notifications.Enabled)
            { <span class="badge bg-secondary me-1">solo log</span> }
            @StateBadge(_notifications.Enabled)
        </span>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Il contrario dell'autonomia cieca: il modo di <strong>chiamare l'umano</strong> quando
            serve. Producer già cablati: quarantena di una corsia, esiti delle campagne, run del
            pipeline falliti, promozioni Paper→Testnet, breaker del layer AI. Il rate-limit non
            perde niente — l'eccesso viene conteggiato e riportato nel primo messaggio successivo.
        </p>
        <div class="alert alert-secondary py-2 small">
            Il <strong>token</strong> del bot Telegram non si mette qui e non passa da questa pagina:
            si legge solo dalla variabile d'ambiente <code>TELEGRAM_BOT_TOKEN</code>. Il ChatId non è
            un segreto ed è l'unico dato di recapito che serve.
        </div>
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="nt_en" @bind="_notifications.Enabled" />
                <label class="form-check-label" for="nt_en">Abilitate @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Provider @Hot()</label>
                <select class="form-select" @bind="_notifications.Provider" style="width: 10rem;">
                    <option value="Logging">Logging</option>
                    <option value="Telegram">Telegram</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Chat id Telegram @Hot()</label>
                <input class="form-control" @bind="_notifications.ChatId" style="width: 14rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Max messaggi/ora @Hot()</label>
                <input type="number" class="form-control" @bind="_notifications.MaxPerHour" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto form-check form-switch align-self-end">
                @* [AF5.4] Sezione PROPRIA Notifications:Digest (mai dentro il POCO Notifications:
                   il writer preserva le sottosezioni-oggetto che il POCO non nomina). *@
                <input class="form-check-input" type="checkbox" id="nt_digest" @bind="_digest.Enabled" />
                <label class="form-check-label" for="nt_digest" title="Riassunto quotidiano: corsie, flotta, consumo AI, carry, heartbeat. La sua ASSENZA all'ora attesa è l'allarme.">Digest giornaliero @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Ora (locale) @Hot()</label>
                <div class="d-flex gap-1">
                    <input type="number" class="form-control" @bind="_digest.Hour" min="0" max="23" style="width: 5rem;" />
                    <input type="number" class="form-control" @bind="_digest.Minute" min="0" max="59" style="width: 5rem;" />
                </div>
            </div>
            <div class="col-auto form-check form-switch align-self-end">
                @* [G9] Paragrafo di sintesi scritto dall'AI SOPRA i dati. Additivo: se l'AI non
                   risponde il digest esce identico, e l'assenza NON è un guasto da segnalare. *@
                <input class="form-check-input" type="checkbox" id="nt_digest_narrative" @bind="_digest.NarrativeEnabled" />
                <label class="form-check-label" for="nt_digest_narrative" title="Un paragrafo in italiano scritto dal provider AI attivo, sopra i dati strutturati (che restano invariati). Se l'AI non risponde, il digest esce senza — non è un guasto.">Sintesi AI in cima @Hot()</label>
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-primary" @onclick='() => SaveAsync("Notifications:Digest", _digest, "Digest giornaliero")' disabled="@_busy">Salva digest</button>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary me-2" @onclick='() => SaveAsync("Notifications", _notifications, "Notifiche del guscio")' disabled="@_busy">Salva</button>
                <button class="btn btn-outline-secondary" @onclick="SendTestNotificationAsync" disabled="@_busy">
                    @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Prova
                </button>
            </div>
        </div>

        @* [E5] La spia di guasto: NotifyAsync assorbe l'esito per contratto (giusto per i producer),
           quindi un recapito fallito viveva SOLO nei log — è ciò che ha tenuto Telegram muto per due
           giorni. Qui l'ultimo esito reale si legge, senza dover inviare nulla. *@
        <div class="mt-2 small @(Notifier.ChannelStatus.FailuresSinceLastDelivery > 0 ? "text-danger fw-semibold" : "text-muted")">
            Spia del canale (da questo avvio del guscio): @DescribeChannel(Notifier.ChannelStatus)
        </div>

        @* ------------------------------------------------------------------ canale del MOTORE *@
        @* Due canali distinti, non uno con due pulsanti: guscio e motore sono processi separati, con
           configurazioni e variabili d'ambiente proprie. Il motore puo' essere muto mentre il guscio
           recapita — ed e' cosi' che stava, scoperto il 2026-07-29. Tenerli in un unico blocco
           avrebbe fatto credere che accendere qui accendesse la' . *@
        <hr />
        <div class="d-flex justify-content-between align-items-center mb-2">
            <strong>Canale del motore</strong>
            <span>
                @if (_engineNotifications.Enabled && _engineNotifications.Provider == "Telegram")
                { <span class="badge bg-info text-dark me-1">Telegram</span> }
                else if (_engineNotifications.Enabled)
                { <span class="badge bg-secondary me-1">solo log</span> }
                @StateBadge(_engineNotifications.Enabled)
            </span>
        </div>
        <p class="text-muted small">
            È <code>procionemgr-trading</code> a emettere l'allarme più importante della piattaforma:
            la <strong>quarantena</strong> di una corsia, quando la sua contabilità diventa
            impossibile. Quel producer vive là, non qui, e legge la <em>propria</em> configurazione:
            questi campi sono letti dal motore e riscritti su di lui.
            @if (_engineSnapshot.SourceOf("Notifications") is { } notifSource)
            {
                <text> Sorgente attuale: <code>@notifSource</code>.</text>
            }
        </p>
        @if (!_engineSnapshot.Reachable)
        {
            <div class="alert alert-danger py-2 small">
                Motore non raggiungibile: @_engineSnapshot.Error I valori qui sotto sono i default,
                non salvare finché non risponde.
            </div>
        }
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="ent_en" @bind="_engineNotifications.Enabled" />
                <label class="form-check-label" for="ent_en">Abilitate @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Provider @Hot()</label>
                <select class="form-select" @bind="_engineNotifications.Provider" style="width: 10rem;">
                    <option value="Logging">Logging</option>
                    <option value="Telegram">Telegram</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Chat id Telegram @Hot()</label>
                <input class="form-control" @bind="_engineNotifications.ChatId" style="width: 14rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Max messaggi/ora @Hot()</label>
                <input type="number" class="form-control" @bind="_engineNotifications.MaxPerHour" min="1" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary me-2" @onclick="SaveEngineNotificationsAsync" disabled="@_busy">Salva sul motore</button>
                <button class="btn btn-outline-secondary" @onclick="SendEngineTestNotificationAsync" disabled="@_busy">
                    @if (_busy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    Prova dal motore
                </button>
            </div>
            <div class="col-12">
                <span class="text-muted small">
                    Il <strong>token</strong> del motore è una cosa sua: sta nel Secret
                    <code>trading-secrets</code> come <code>TELEGRAM_BOT_TOKEN</code>, non in questa
                    sezione e non in questa pagina. Se manca, la prova qui accanto lo dice.
                </span>
            </div>
            <div class="col-12">
                @* [E5] Stessa spia, per il canale del MOTORE: fra una prova e l'altra i suoi
                   fallimenti finivano solo nei log del pod. *@
                @if (_engineChannel is { } ch)
                {
                    @if (!ch.Reachable)
                    {
                        <span class="small text-warning">Spia del canale del motore non leggibile: @ch.Error</span>
                    }
                    else if (!ch.ChannelComposed)
                    {
                        <span class="small text-danger fw-semibold">Il motore non ha NESSUN canale di notifica composto: gli allarmi di quarantena non raggiungono nessuno.</span>
                    }
                    else if (ch.Status is { } st)
                    {
                        <span class="small @(st.FailuresSinceLastDelivery > 0 ? "text-danger fw-semibold" : "text-muted")">
                            Spia del canale (da questo avvio del motore): @DescribeChannel(st)
                        </span>
                    }
                }
            </div>
        </div>
    </div>
</div>

@* ============================ 12. Diagnostica ============================ *@
<div class="card mb-4" id="p-diag">
    <div class="card-header"><i class="bi bi-activity me-1"></i>Diagnostica (osservativa, non decide nulla)</div>
    <div class="card-body">
        <p class="text-muted small">
            <strong>Dual-read ML.</strong> Il motore decide i trade col modello in-process; con questo
            acceso confronta <em>anche</em> il segnale del servizio remoto <code>procionemgr-ml</code>
            e ne registra le divergenze (log + metrica), senza mai prendere una decisione da quel
            confronto. Se l'URL è vuoto il client non viene nemmeno registrato: confronto
            staticamente spento, zero overhead. Il confronto lo fa il <strong>motore</strong>
            (<code>TradingEngine</code>): fino al 2026-07-31 questi campi finivano nel file del
            guscio, che il motore remoto non legge — ora sono letti dal motore e riscritti su di lui.
            @if (_engineSnapshot.SourceOf("Ml") is { } mlSource)
            {
                <text> Sorgente attuale: <code>@mlSource</code>.</text>
            }
        </p>
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="ml_en" @bind="_ml.Enabled" />
                <label class="form-check-label" for="ml_en">Confronto abilitato @Hot()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">URL servizio ML @Restart()</label>
                <input class="form-control" @bind="_ml.RemoteUrl" placeholder="http://localhost:18091" style="width: 18rem;" />
            </div>
            <div class="col-auto">
                <label class="form-label">Timeout (ms) @Hot()</label>
                <input type="number" class="form-control" @bind="_ml.TimeoutMs" min="50" style="width: 8rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="SaveMlAsync" disabled="@_busy">Salva</button>
            </div>
        </div>
        <hr />
        <p class="text-muted small mb-2">
            <strong>Export OpenTelemetry.</strong> Spedisce metriche e log a un collector OTLP. La
            dashboard <a href="metrics">/metrics</a> funziona comunque, anche a export spento: qui si
            decide solo se la telemetria esce anche verso l'esterno.
        </p>
        <div class="row g-3 align-items-end">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="ob_en" @bind="_observability.Enabled" />
                <label class="form-check-label" for="ob_en">Export abilitato @Restart()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Endpoint OTLP @Restart()</label>
                <input class="form-control" @bind="_observability.OtlpEndpoint" placeholder="http://localhost:4317" style="width: 18rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick='() => SaveAsync("Observability", _observability, "Export OTLP")' disabled="@_busy">Salva</button>
            </div>
        </div>
    </div>
</div>

@* ============================ Topologia e infrastruttura ============================ *@
@* [Fase 3 PRD-RISANAMENTO] Le chiavi che erano «deliberatamente senza UI». La regola della
   piattaforma è che l'amministratore governa TUTTO dall'interfaccia: queste manopole esistono,
   ma ognuna porta scritto il proprio vincolo (⟳ = vale dal riavvio) e il proprio pericolo —
   esporre non significa banalizzare. *@
<div class="card mb-3 border-warning" id="p-topology">
    <div class="card-header"><i class="bi bi-diagram-3 me-1"></i>Topologia e infrastruttura <span class="badge bg-warning text-dark">⟳ riavvio</span></div>
    <div class="card-body">
        <p class="text-muted small">
            Chi ospita cosa. Tutti i campi valgono <strong>dal prossimo riavvio</strong> del
            processo interessato: il salvataggio scrive <code>appsettings.json</code> subito, ma i
            canali e i worker si compongono a startup.
        </p>

        <div class="alert alert-danger py-2 small">
            <strong>Motore di trading remoto</strong> (<code>Trading:UseRemoteTrading</code>) — regola
            «un solo scrittore»: con <code>true</code> il guscio NON registra il motore locale e parla
            col Deployment <code>procionemgr-trading</code> (servono <code>Trading:RemoteUrl</code> e
            il segreto gRPC, che non passano da qui); con <code>false</code> il motore gira
            in-process e il Deployment va fermato. Il valore giusto col deployment sbagliato = due
            esecutori sulla stessa corsia, o nessuno.
        </div>
        <div class="row g-3 align-items-end mb-3">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="topo_rt" @bind="_topoUseRemoteTrading" />
                <label class="form-check-label" for="topo_rt">Motore remoto (UseRemoteTrading) @Restart()</label>
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-danger" @onclick='() => SaveScalarAsync("Trading:UseRemoteTrading", _topoUseRemoteTrading, "Topologia trading")' disabled="@_busy">Salva topologia trading</button>
            </div>
        </div>

        <div class="row g-3 align-items-end mb-1">
            <div class="col-auto">
                <label class="form-label">Servizio ML dual-read (Ml:RemoteUrl) @Restart()</label>
                <input class="form-control" @bind="_topoMlRemoteUrl" placeholder="vuoto = nessun canale" style="width: 22rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="SaveMlRemoteUrlAsync" disabled="@_busy">Salva</button>
            </div>
        </div>
        <div class="form-text mb-3">
            Il canale gRPC verso il servizio ML si crea una volta sola a startup: vuoto = dual-read
            impossibile finché non lo valorizzi e riavvii. <code>Ml:Enabled</code> (nel pannello
            Diagnostica qui sopra) resta l'interruttore a caldo.
        </div>

        <div class="alert alert-warning py-2 small">
            <strong>Redirect HTTPS</strong> (<code>Http:DisableHttpsRedirection</code>) — proprietà
            dell'ambiente di hosting: <code>true</code> SOLO dietro un reverse proxy che parla in
            chiaro col processo (il pod ui in K8s). Sbagliarla in locale può rendere la UI
            irraggiungibile dal browser: se succede, si corregge a mano in
            <code>appsettings.json</code> e si riavvia.
        </div>
        <div class="row g-3 align-items-end mb-3">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="topo_https" @bind="_topoDisableHttpsRedirect" />
                <label class="form-check-label" for="topo_https">Disattiva redirect HTTPS @Restart()</label>
            </div>
            <div class="col-auto">
                <button class="btn btn-outline-danger" @onclick='() => SaveScalarAsync("Http:DisableHttpsRedirection", _topoDisableHttpsRedirect, "Redirect HTTPS")' disabled="@_busy">Salva</button>
            </div>
        </div>

        <hr />
        <div class="row g-3 align-items-end mb-1">
            <div class="col-auto form-check form-switch ms-2">
                <input class="form-check-input" type="checkbox" id="topo_mig" @bind="_database.AutoMigrate" />
                <label class="form-check-label" for="topo_mig">Migrazioni all'avvio (Database:AutoMigrate) @Restart()</label>
            </div>
            <div class="col-auto">
                <label class="form-label">Timeout lock migrazione (s) @Restart()</label>
                <input type="number" class="form-control" @bind="_database.LockTimeoutSeconds" min="1" style="width: 9rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="SaveDatabaseAsync" disabled="@_busy">Salva</button>
            </div>
        </div>
        <div class="form-text mb-3">
            Letto una volta, prima che l'host parta: l'effetto si vede nella riga di log del
            prossimo avvio (schema allineato / N migrazioni applicate). Con AutoMigrate spento lo
            schema si applica a mano (<code>dotnet ef database update</code>).
        </div>

        <div class="row g-3 align-items-end mb-1">
            <div class="col-auto">
                <label class="form-label">Cache fattori: serie massime (FactorCache:MaxEntries) @Restart()</label>
                <input type="number" class="form-control" @bind="_factorCache.MaxEntries" min="16" style="width: 9rem;" />
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" @onclick="SaveFactorCacheAsync" disabled="@_busy">Salva</button>
            </div>
        </div>
        <div class="form-text">
            Solo memoria e prestazioni: la cache è un memoizzatore con invariante
            «cache == ricalcolo», nessun valore prodotto dalla piattaforma cambia. Oltre il tetto
            si sfrattano le serie più vecchie (FIFO).
        </div>
    </div>
</div>

@code {
    // Copie LOCALI modificabili: si parte da CurrentValue e si scrive solo al Salva — così i campi
    // non "saltano" sotto le dita dell'utente quando il monitor ricarica il file appena scritto.
