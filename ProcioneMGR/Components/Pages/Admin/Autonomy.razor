            .Split([',', '\n', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(t => ProcioneMGR.Services.PairsTrading.PairSpreadWatchWorker.ParsePair(t))
            .Where(p => p.Y is not null && p.X is not null && p.Timeframe is not null)
            .Select(p => ProcioneMGR.Services.PairsTrading.PairKey.Build(p.Y!, p.X!, p.Timeframe!))
            .Distinct(StringComparer.Ordinal)
            .OrderBy(k => k, StringComparer.Ordinal)
