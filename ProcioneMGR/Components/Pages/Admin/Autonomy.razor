    /// <summary>
    /// Normalizza una lista di simboli per il campo CSV: maiuscolo, senza vuoti, SENZA DUPLICATI.
    /// <para>Il dedupe non è cosmesi. Il binder delle liste .NET <b>APPENDE</b> ai valori di default
    /// invece di sostituirli, quindi una sezione che elenca gli stessi 6 simboli del default ne
    /// produce 12: fino al 2026-07-29 i due campi CSV di questa pagina mostravano
    /// «BTC, ETH, SOL, BNB, XRP, DOGE, BTC, ETH, SOL, BNB, XRP, DOGE» all'apertura. I worker
    /// deduplicavano già per conto loro, quindi il comportamento era corretto e solo la
    /// visualizzazione mentiva — che per un pannello di configurazione è comunque un difetto:
    /// chi legge non può distinguere «il file è così» da «la pagina lo mostra male».</para>
    /// </summary>
    private static string SymbolsToCsv(IEnumerable<string> symbols) => string.Join(", ", symbols
        .Select(s => s.Trim().ToUpperInvariant())
        .Where(s => s.Length > 0)
        .Distinct());

    private static List<string> CsvToSymbols(string csv) => [.. csv
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Select(s => s.ToUpperInvariant())
        .Distinct()];

