    /// <summary>[M1] Quanto ci mette il monitor a completare un giro sulla watchlist, in parole.</summary>
    private string FactorDriftCoverageText()
    {
        if (_watchlistSeriesCount is not int total || total <= 0)
        {
            return "un tempo non calcolabile finché la watchlist non risponde";
        }
        var rounds = (int)Math.Ceiling((double)total / _factorDrift.EffectiveMaxSeries());
        var hours = (long)rounds * _factorDrift.EffectiveIntervalHours();
        return hours < 48
            ? $"{hours} ore ({rounds} giri)"
            : $"circa {hours / 24.0:0.#} giorni ({rounds} giri)";
    }

