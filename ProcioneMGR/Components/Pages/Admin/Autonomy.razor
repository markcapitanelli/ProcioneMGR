        try
        {
            // Validazione lato SERVER prima di toccare il file: l'attributo min= dell'HTML non
            // vincola @bind, quindi senza questo controllo un intervallo a 0 (PeriodicTimer che
            // esplode all'avvio) o soglie invertite finirebbero dritti in appsettings.json.
            var error = AdminConfigRules.Validate(model);
            if (error is not null)
            {
                SetStatus($"{label}: {error}", true);
                return;
            }

            await ConfigWriter.SaveSectionAsync(section, model);
            SetStatus($"{label}: salvato in appsettings.json — i campi ✅ valgono entro ~1s, quelli ⟳ dal prossimo riavvio.", false);
        }
        catch (Exception ex) { SetStatus($"{label}: salvataggio fallito — {ex.Message}", true); }
        finally { _busy = false; }
    }

