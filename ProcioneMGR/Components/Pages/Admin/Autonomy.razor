    /// <summary>
    /// [Fase 3] Scrittura chirurgica di un singolo scalare (SaveValueAsync): niente POCO
    /// dell'intera sezione, niente rischio di cancellare chiavi non modellate.
    /// </summary>
    /// <summary>
    /// [2026-08-17] Le due attese verso il motore remoto si salvano insieme: sono una coppia, e
    /// salvarne una sola lascerebbe l'altra al default senza che il pannello lo dica.
    /// </summary>
    private async Task SaveRemoteTimeoutsAsync()
    {
        if (_topoReadTimeout < 1 || _topoCommandTimeout < 1)
        {
            SetStatus("Attese motore: entrambi i valori devono essere almeno 1 secondo.", true);
            return;
        }
        _busy = true; _isError = false; _status = null;
        try
        {
            await ConfigWriter.SaveValueAsync("Trading:RemoteReadTimeoutSeconds", _topoReadTimeout);
            await ConfigWriter.SaveValueAsync("Trading:RemoteCommandTimeoutSeconds", _topoCommandTimeout);
            SetStatus($"Attese motore salvate (letture {_topoReadTimeout}s, comandi {_topoCommandTimeout}s): "
                      + "valgono dal prossimo riavvio del guscio, perché il canale gRPC si compone a startup.", false);
        }
        catch (Exception ex) { SetStatus($"Attese motore: salvataggio fallito — {ex.Message}", true); }
        finally { _busy = false; }
    }

