# =============================================================================================
#  Segreti dell'assetto Docker Compose [Fase 5]. Copia questo file in `.env` (gitignored) e
#  riempi i valori: docker compose li legge da lì, MAI da questo file e MAI dal repo.
#  Stessa disciplina dei Secret K8s: il repo non contiene segreti, nemmeno di esempio.
# =============================================================================================

# Password del Postgres del compose (utente `procione`, database `procionemgr`).
# Genera: [Convert]::ToBase64String((1..24|%{Get-Random -Max 256}))
POSTGRES_PASSWORD=__CHANGE_ME__

# Master key AES-256 (base64 di 32 byte) con cui si cifrano credenziali exchange e chiavi AI.
# Su un'installazione NUOVA generane una e conservala fuori dal repo: perderla = perdere l'accesso
# a tutto ciò che è cifrato. Genera: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
PROCIONE_MGR_MASTER_KEY=__CHANGE_ME_BASE64_32_BYTES__

# Solo col profilo `engine` (docker compose --profile engine up -d):
# il segreto condiviso del canale gRPC guscio→motore. Stesso generatore della master key.
#PROCIONE_MGR_TRADING_GRPC_SECRET=__CHANGE_ME__

# Con il profilo engine attivo il guscio deve delegare gli ordini al container trading:
#TRADING_REMOTE=true

# Facoltativi.
#TELEGRAM_BOT_TOKEN=
#UI_PORT=5199
