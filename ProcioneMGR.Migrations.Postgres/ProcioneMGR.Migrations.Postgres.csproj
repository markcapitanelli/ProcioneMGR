<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Assembly che ospita le migrazioni PostgreSQL (unico provider). Referenzia ProcioneMGR perché
         i file .Designer/snapshot generati puntano al tipo ApplicationDbContext. ProcioneMGR NON
         referenzia questo progetto (nessun ciclo): a runtime l'app NON auto-migra (migrate-on-deploy),
         le migrazioni si applicano con `dotnet ef database update` usando questo progetto come
         startup, tramite la DesignTimeDbContextFactory qui inclusa. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProcioneMGR\ProcioneMGR.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- [Fase 5, 2026-08-11] La versione DEVE combaciare con gli EF di ProcioneMGR.csproj (10.0.8).
         Con Design a 10.0.9 questa DLL usciva compilata contro Relational 10.0.9 mentre l'app ne
         pubblica la 10.0.8: al load OGNI classe Migration falliva (FileNotFound sulla versione più
         alta), EF ingoiava l'eccezione e dichiarava ZERO migrazioni — cioè «schema già allineato»
         su un database VUOTO. Rotto in silenzio sia nel container sia sull'host (mascherato solo
         dallo schema già migrato a mano). Guardiani: MigrationsEfVersionAlignmentTests (versioni)
         e la guardia in DatabaseMigrator (DLL presente + zero migrazioni = errore, mai «allineato»). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- [2026-08-05] Porta la DLL delle migrazioni ACCANTO all'eseguibile dell'app, così il
       migrate-on-startup (DatabaseMigrator) la trova: EF risolve l'assembly delle migrazioni per
       NOME, e il caricamento riesce se il file è nella cartella di probing.

       Perché una copia e non un ProjectReference: questo progetto referenzia ProcioneMGR (i file
       .Designer puntano ad ApplicationDbContext), quindi il riferimento inverso sarebbe un ciclo.
       La copia va nella direzione giusta — da qui verso l'app — e avviene dopo la build di questo
       progetto, che per via del ProjectReference avviene sempre DOPO quella dell'app.

       Nota onesta sui limiti: un `dotnet run` mirato al solo progetto dell'app NON costruisce
       questo, e quindi non aggiorna la copia. Chi aggiunge una migrazione deve costruire la
       SOLUZIONE (o questo progetto) perché l'app la veda. Se la DLL manca o è vecchia,
       DatabaseMigrator lo dichiara a log invece di fingere che lo schema sia allineato. -->
  <Target Name="CopyMigrationsToApp" AfterTargets="Build" Condition="'$(OutputPath)' != ''">
    <ItemGroup>
      <MigrationsOutput Include="$(TargetDir)$(TargetName).dll;$(TargetDir)$(TargetName).pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(MigrationsOutput)"
          DestinationFolder="$(MSBuildThisFileDirectory)..\ProcioneMGR\bin\$(Configuration)\$(TargetFramework)\"
          SkipUnchangedFiles="true"
          ContinueOnError="true" />
  </Target>

</Project>
